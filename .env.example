# 골격(skala_langgraph/.env)과 같은 키 이름. 이 파일을 .env로 복사해 값을 넣는다. .env는 공유·커밋 금지.
OPENAI_API_KEY=
MODEL=openai:gpt-6.1-sol
# 모델이 temperature를 지원하면 0으로 둔다. 지원하지 않는 모델이면 API 오류가 나므로 주석으로 둔다.
# TEMPERATURE=0

LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=tashkeel-check

# 판단 기준과 실험 규모 (2026-10-13 확정)
COVERAGE_THRESHOLD=0.5
HIGH_CONFIDENCE=0.8
DEV_DOCS=10
EVAL_DOCS=30
REPEATS=3

# 단계 2 틀(서류 묶음 검색, RAG + 벡터 DB). 단계 1 실험에서는 false로 둔다.
ENABLE_BUNDLE_SEARCH=false
EMBEDDING_MODEL=text-embedding-3-small

# Wikidata 요청 User-Agent에 넣을 연락처(선택)
WIKIDATA_CONTACT=

# 데이터·결과 폴더. 상대 경로는 명령을 실행한 폴더 기준이다(기본: 레포 루트에서 실행). 컨테이너에서는 절대 경로를 준다.
# DATA_DIR=data
# RESULTS_DIR=results
