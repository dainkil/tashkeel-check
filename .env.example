# 골격(skala_langgraph/.env)과 같은 키 이름. 이 파일을 .env로 복사해 값을 넣는다. .env는 공유·커밋 금지.
OPENAI_API_KEY=
MODEL=openai:gpt-6.1-sol
# 모델이 temperature를 지원하면 0으로 둔다. 지원하지 않는 모델이면 API 오류가 나므로 주석으로 둔다.
# gpt-6.1-sol은 0을 받지 않는다(기본값 1만 허용, 2026-10-20 확인).
# TEMPERATURE=0

LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=tashkeel-check

# 판단 기준과 실험 규모 (2026-10-13 확정)
COVERAGE_THRESHOLD=0.5
HIGH_CONFIDENCE=0.8
DEV_DOCS=10
EVAL_DOCS=30
REPEATS=3

# (선택) 달러/100만 토큰. 넣으면 exp002 진행 로그와 exp002-status에 추정 금액이 같이 나온다(청구 기준은 OpenAI 대시보드).
# gpt-6.1-sol 값은 제3자 집계 사이트 기준(2026-10-21). OpenAI 가격 페이지에서 확인한 뒤 쓴다.
# PRICE_INPUT_PER_MTOK=2
# PRICE_OUTPUT_PER_MTOK=10

# 단계 2 틀(서류 묶음 검색, RAG + 벡터 DB). 단계 1 실험에서는 false로 둔다.
ENABLE_BUNDLE_SEARCH=false
EMBEDDING_MODEL=text-embedding-3-small

# Wikidata 요청 User-Agent에 넣을 연락처(선택)
WIKIDATA_CONTACT=

# 데이터·결과 폴더. 상대 경로는 명령을 실행한 폴더 기준이다(기본: 레포 루트에서 실행). 컨테이너에서는 절대 경로를 준다.
# DATA_DIR=data
# RESULTS_DIR=results

# 단계 1.5 서비스(ADR-012). `uv run tashkeel serve` 또는 ./run.sh가 읽는다. 실험 경로(run·exp001·exp002)는 읽지 않는다.
# LLM_BACKEND=openai   # fake로 두면 API 키 없이 가짜 모델로 화면을 본다. 키가 없다고 조용히 fake로 떨어지지 않는다
# DATABASE_URL=postgresql+psycopg://tashkeel:tashkeel@localhost:5432/tashkeel   # 없으면 DB 없이(메모리·results/ 파일만) 돈다
# USE_MCP_TOOLS=false  # true면 C2의 analyze_tokens를 MCP 서버(stdio) 툴로 바꿔 쓰고, 샘플 목록도 MCP 리소스에서 읽는다
# WEB_HOST=127.0.0.1
# WEB_PORT=8000

# 완제품 패키지(ADR-019). docker compose가 읽는다.
# POSTGRES_PASSWORD=   # compose의 Postgres 비밀번호(필수). 앱의 DATABASE_URL은 compose가 이 값으로 만든다
# AUTH=auto            # auto: 활성 고객이 하나라도 있으면 API 키 필수, 없으면 열림 / required / disabled. compose 기본은 required
# MULTI_AGENT=false    # true면 조건 M1(번역자 → 격리 검증자 → 규칙 중재자)을 API·화면에서 받는다

# 방향 전환(ADR-021, 2026-10-21): 서비스 기본은 측정한 설정(지시문 p1, 조건 C1). 실험 경로는 각자 고정한 값을 쓴다.
# PROMPT_VERSION=p1    # p0는 EXP-002 지시문(어려운 시험지에서 0.93), p1은 EXP-003에서 99% 기준을 넘긴 지시문
# 스캔·PDF 입력의 문자 인식. none(기본)이면 텍스트 층 없는 PDF·이미지는 400. ocrspace는 무료 OCR API(파일을 제3자 서버로 보낸다. 민감 서류는 텍스트로 넣는다)
# OCR_BACKEND=none     # none / ocrspace
# OCR_API_KEY=         # ocrspace 키
# OCR_ENDPOINT=https://api.ocr.space/parse/image
# OCR_MAX_BYTES=1048576   # OCR로 보낼 파일 상한(무료 등급 제한은 공식 문서로 확인)
# UPLOAD_MAX_BYTES=5242880   # 단일 문서 업로드 상한
