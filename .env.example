# 이 파일을 .env로 복사해 값을 넣는다. .env는 공유·커밋 금지. 키 이름은 골격(skala_langgraph/.env)과 같다.

# ── 모델 (서비스·실험 공통) ─────────────────────────────────────────
OPENAI_API_KEY=
MODEL=openai:gpt-6.1-sol
# gpt-6.1-sol은 temperature 0을 받지 않는다(기본값 1만 허용, 2026-10-20 확인). 지원하는 모델로 바꿀 때만 켠다.
# TEMPERATURE=0
# 보관함 구절 순서를 정하는 임베딩(LLM_BACKEND=openai일 때만 쓴다. 보관함 글이 OpenAI로 간다)
EMBEDDING_MODEL=text-embedding-3-small
# 고확신 기준(강등 규칙·지표, 서비스·실험 공통)
HIGH_CONFIDENCE=0.8

LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=tashkeel-check

# ── 서비스 (`uv run tashkeel serve` 또는 ./run.sh) ──────────────────
# LLM_BACKEND=openai   # fake면 API 키 없이 가짜 모델로 화면을 본다. 키가 없다고 조용히 fake로 떨어지지 않는다
# REVIEW_CONDITION=M2  # 서비스 기본 조건(ADR-022). M2는 정확도를 재지 않았다. C1은 EXP-003에서 잰 설정(LLM 한 번)
# PROMPT_VERSION=p1    # p1: EXP-003에서 99% 기준을 넘긴 지시문. p0: EXP-002 지시문(어려운 시험지에서 0.93)
# DATABASE_URL=postgresql+psycopg://tashkeel:tashkeel@localhost:5432/tashkeel   # 없으면 메모리로 돈다(재시작하면 사전·보관함이 비어 있음)
# AUTH=auto            # auto: 활성 고객이 하나라도 있으면 API 키 필수 / required / disabled. compose 기본은 required
# WEB_HOST=127.0.0.1
# WEB_PORT=8000
# 스캔·이미지 입력의 문자 인식. none(기본)이면 텍스트 층 없는 PDF·이미지는 400.
# ocrspace는 무료 OCR API다(파일을 제3자 서버로 보낸다. 민감 서류는 텍스트로 넣는다).
# OCR_BACKEND=none     # none / ocrspace
# OCR_API_KEY=
# OCR_ENDPOINT=https://api.ocr.space/parse/image
# OCR_MAX_BYTES=1048576      # OCR로 보낼 파일 상한(무료 등급 제한은 공식 문서로 확인)
# UPLOAD_MAX_BYTES=5242880   # 업로드 파일 상한
# 보류·선택 기능
# MULTI_AGENT=false    # true면 조건 M1(번역자 → 격리 검증자 → 규칙 중재자)도 받는다
# USE_MCP_TOOLS=false  # true면 C2의 analyze_tokens를 stdio MCP 서버 툴로 쓰고 샘플 목록도 MCP 리소스에서 읽는다

# ── Docker Compose 패키지 (docs/deploy.md) ──────────────────────────
# POSTGRES_PASSWORD=   # 필수. 앱의 DATABASE_URL은 compose가 이 값으로 만든다

# ── 실험 (run·exp001·exp002·exp003) ─────────────────────────────────
# EXP-001 판단 기준과 실험 규모
COVERAGE_THRESHOLD=0.5
DEV_DOCS=10
EVAL_DOCS=30
REPEATS=3
# 달러/100만 토큰. 넣으면 실험 진행 로그와 *-status에 추정 금액이 나온다(청구 기준은 OpenAI 대시보드).
# gpt-6.1-sol 값은 제3자 집계 사이트 기준(2026-10-21). OpenAI 가격 페이지에서 확인한 뒤 쓴다.
# PRICE_INPUT_PER_MTOK=2
# PRICE_OUTPUT_PER_MTOK=10
# 묶음 검색 틀(rag/bundle.py, 꺼짐). 실험 조건에 붙이지 않는다
ENABLE_BUNDLE_SEARCH=false
# Wikidata 요청 User-Agent 연락처(선택)
WIKIDATA_CONTACT=
# 데이터·결과 폴더. 상대 경로는 명령을 실행한 폴더 기준(기본: 레포 루트). 컨테이너에서는 절대 경로.
# DATA_DIR=data
# RESULTS_DIR=results
