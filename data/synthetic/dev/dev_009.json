  {
   "segment_id": "s01",
   "text": "وكالة خاصة"
  },
  {
   "segment_id": "s02",
   "text": "إنه في يوم 04/02/2026 حضر أمام الكاتب العدل السيدة عليزا صادق الحربي، إماراتية الجنسية، وتحمل جواز سفر رقم V8952351."
  },
  {
   "segment_id": "s03",
   "text": "وذلك بصفتها مديرة لشركة الجابر للتجارة العامة ذ.م.م، المرخصة من دائرة التنمية الاقتصادية برقم 925459، وعنوانها دبي، الإمارات العربية المتحدة."
  },
  {
   "segment_id": "s04",
   "text": "وقررت أنها وكّلت السيد فهد زايد الديحاني، سعودي الجنسية، ويحمل بطاقة هوية رقم 72543702."
  },
  {
   "segment_id": "s05",
   "text": "للقيام نيابة عنها بمراجعة الجهات الحكومية والتوقيع على الطلبات والمستندات المتعلقة بالشركة واستلام الشهادات والتراخيص."
  },
  {
   "segment_id": "s06",
   "text": "الموكلة: عليزا صادق الحربي"
  },
  {
   "segment_id": "s07",
   "text": "الوكيل: فهد زايد الديحاني"
  },
  {
   "segment_id": "s08",
   "text": "التوقيع: ____________"
  }
 ],
