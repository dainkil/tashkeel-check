 "doc_type": "minutes",
 "bilingual": true,
 "segments": [
  {
   "segment_id": "s01",
   "text": "محضر اجتماع الجمعية العمومية العادية"
  },
  {
   "segment_id": "s02",
   "text": "لشركة المال للتجارة العامة ذ.م.م"
  },
  {
   "segment_id": "s03",
   "text": "Company: Al Mal General Trading L.L.C."
  },
  {
   "segment_id": "s04",
   "text": "عقد الاجتماع في أبوظبي بتاريخ 16/03/2026 برئاسة المهندسة إيمان خالد محمد المال."
  },
  {
   "segment_id": "s05",
   "text": "وحضر الاجتماع كل من:"
  },
  {
   "segment_id": "s06",
   "text": "1. السيد موسى بن صلاح الماجد"
  },
  {
   "segment_id": "s07",
   "text": "Attendee 1: Mousa Al Majed"
  },
  {
   "segment_id": "s08",
   "text": "2. السيدة علياء علي سلطان الحمادي"
  },
  {
   "segment_id": "s09",
   "text": "Attendee 2: A. A. Al Hammadi"
  },
  {
   "segment_id": "s10",
   "text": "3. السيد سعد راشد عبد الله الحوسني"
  },
  {
   "segment_id": "s11",
   "text": "4. السيدة حصة بنت عبد الإله الكعبي"
  },
  {
   "segment_id": "s12",
   "text": "Attendee 4: H. A. Al Kaabi"
  },
  {
   "segment_id": "s13",
   "text": "5. السيدة عزة فواز المال"
  },
  {
   "segment_id": "s14",
   "text": "6. المهندس صالح جاسم سعيد الصباح"
  },
  {
   "segment_id": "s15",
   "text": "وتولى أمانة السر السيد أمين فهد الأسود."
  },
  {
   "segment_id": "s16",
   "text": "Secretary: Amin Al Aswad"
  },
  {
   "segment_id": "s17",
   "text": "وبعد التداول قرر المجتمعون بالإجماع ما يلي:"
  },
  {
   "segment_id": "s18",
   "text": "أولًا: الموافقة على تعيين السيد صالح الصباح مديرًا للشركة لمدة ثلاث سنوات."
  },
  {
   "segment_id": "s19",
   "text": "ثانيًا: توزيع الأرباح بشكل عادل بين الشركاء حسب حصصهم."
  },
  {
   "segment_id": "s20",
   "text": "ثالثًا: المركز المالي للشركة سليم ولا توجد عليها التزامات متأخرة."
  },
  {
   "segment_id": "s21",
   "text": "رابعًا: تفويض السيد سعد الحوسني بالتوقيع على محضر الاجتماع وتقديمه للجهات المختصة."
  },
  {
   "segment_id": "s22",
   "text": "رئيس الاجتماع: إيمان المال"
  },
  {
   "segment_id": "s23",
   "text": "أمين السر: أمين الأسود"
  },
  {
   "segment_id": "s24",
   "text": "التوقيعات:"
  },
  {
   "segment_id": "s25",
   "text": "Saad Rashid Abdullah Al Hosani"
  },
  {
   "segment_id": "s26",
   "text": "Saleh Jassem Said Al Sabah"
  }
 ],
