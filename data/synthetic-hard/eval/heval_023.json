 "segments": [
  {
   "segment_id": "s01",
   "text": "مستخرج من السجل التجاري"
  },
  {
   "segment_id": "s02",
   "text": "الاسم التجاري: الحازمي للتجارة العامة ذ.م.م"
  },
  {
   "segment_id": "s03",
   "text": "Trade name: Al Hazmi General Trading L.L.C."
  },
  {
   "segment_id": "s04",
   "text": "البريد الإلكتروني: info@alhazmi-group.example.com"
  },
  {
   "segment_id": "s05",
   "text": "رقم الرخصة: 437915، جهة الإصدار: دائرة التنمية الاقتصادية، الإمارة: أبوظبي"
  },
  {
   "segment_id": "s06",
   "text": "الشكل القانوني: شركة ذات مسؤولية محدودة"
  },
  {
   "segment_id": "s07",
   "text": "الشركاء:"
  },
  {
   "segment_id": "s08",
   "text": "1. الشيخ محمد بن منير السالمي، بحريني الجنسية، الحصة 9٪"
  },
  {
   "segment_id": "s09",
   "text": "Partner 1: MUHAMMAD BIN MUNEER EL-SALEMI"
  },
  {
   "segment_id": "s10",
   "text": "Partner 1: EL-SALEMI, Muhammad Muneer"
  },
  {
   "segment_id": "s11",
   "text": "P<BHREL<SALEMI<<MUHAMMAD<MUNEER<<<<<<<<<<<<<"
  },
  {
   "segment_id": "s12",
   "text": "2. الدكتورة حصة بنت مكي بن يوسف الحازمي، كويتية الجنسية، الحصة 25٪"
  },
  {
   "segment_id": "s13",
   "text": "3. السيدة غالية بنت عبد الله القاسمي، كويتية الجنسية، الحصة 9٪"
  },
  {
   "segment_id": "s14",
   "text": "Partner 3: Ghalia Al Qasimi"
  },
  {
   "segment_id": "s15",
   "text": "4. السيد راشد مسعود عادل العازمي، بحريني الجنسية، الحصة 15٪"
  },
  {
   "segment_id": "s16",
   "text": "Partner 4: Rashid Masoud Adel Al Aazmi"
  },
  {
   "segment_id": "s17",
   "text": "5. السيد عبد الرحمن بن سلمان القرني، سعودي الجنسية، الحصة 21٪"
  },
  {
   "segment_id": "s18",
   "text": "Partner 5: Abdel Rahman bin Salman Al Qarni"
  },
  {
   "segment_id": "s19",
   "text": "6. السيد محمد بن سامي الهاشمي، عماني الجنسية، الحصة 26٪"
  },
  {
   "segment_id": "s20",
   "text": "Partner 6: Mohammed Al Hashimi"
  },
  {
   "segment_id": "s21",
   "text": "7. المهندس محمد خليفة سالم الحارثي، بحريني الجنسية، الحصة 20٪"
  },
  {
   "segment_id": "s22",
   "text": "Partner 7: Mohamed Khalifa Salim Al Harthi"
  },
  {
   "segment_id": "s23",
   "text": "8. السيد عبد الرحمن سعيد الكعبي، قطري الجنسية، الحصة 12٪"
  },
  {
   "segment_id": "s24",
   "text": "Partner 8: ABDURAHMAN SAEED EL-KAABI"
  },
  {
   "segment_id": "s25",
   "text": "Surname: EL-KAABI / Given names: ABDURAHMAN SAEED"
  },
  {
   "segment_id": "s26",
   "text": "P<QATEL<KAABI<<ABDURAHMAN<SAEED<<<<<<<<<<<<<"
  },
  {
   "segment_id": "s27",
   "text": "المدير: الشريك رقم 6، السيد محمد الهاشمي"
  },
  {
   "segment_id": "s28",
   "text": "المفوضة بالتوقيع: الشريكة رقم 2، السيدة حصة الحازمي"
  },
  {
   "segment_id": "s29",
   "text": "تاريخ الإصدار: 27/07/2026"
  }
