 "bilingual": true,
 "segments": [
  {
   "segment_id": "s01",
   "text": "محضر اجتماع الجمعية العمومية العادية"
  },
  {
   "segment_id": "s02",
   "text": "لشركة الجاسم للتجارة العامة ذ.م.م"
  },
  {
   "segment_id": "s03",
   "text": "Company: Al Jasim General Trading L.L.C."
  },
  {
   "segment_id": "s04",
   "text": "عقد الاجتماع في أبوظبي بتاريخ 12/09/2026 برئاسة الدكتورة أفنان بنت طلال بن سلمان المفتاح."
  },
  {
   "segment_id": "s05",
   "text": "Chairman: A. T. Al Muftah"
  },
  {
   "segment_id": "s06",
   "text": "وحضر الاجتماع كل من:"
  },
  {
   "segment_id": "s07",
   "text": "1. السيد عادل محمد أحمد السعدي"
  },
  {
   "segment_id": "s08",
   "text": "Attendee 1: Adel Mohammed Ahmed Al Saadi"
  },
  {
   "segment_id": "s09",
   "text": "2. الشيخ سليم بن عادل السعدي"
  },
  {
   "segment_id": "s10",
   "text": "3. السيدة دانا بنت عبد الله الخوري"
  },
  {
   "segment_id": "s11",
   "text": "Attendee 3: Dana Al Khori"
  },
  {
   "segment_id": "s12",
   "text": "4. السيد محمد عبد العزيز الجاسم"
  },
  {
   "segment_id": "s13",
   "text": "Attendee 4: Mohammed Abdulaziz El-Jassim"
  },
  {
   "segment_id": "s14",
   "text": "Surname: AL JASSEM / Given names: MOHAMED ABDULAZIZ"
  },
  {
   "segment_id": "s15",
   "text": "5. السيد أحمد بن ناصر المنصور"
  },
  {
   "segment_id": "s16",
   "text": "Attendee 5: Ahmed bin Naser El-Mansor"
  },
  {
   "segment_id": "s17",
   "text": "Passport name: AL MANSOUR, Ahmed Naser"
  },
  {
   "segment_id": "s18",
   "text": "6. السيد أحمد بن زايد الديحاني"
  },
  {
   "segment_id": "s19",
   "text": "Attendee 6: Ahmad bin Zayed Al Deehani"
  },
  {
   "segment_id": "s20",
   "text": "وتولى أمانة السر السيد أمين بن محمد الجاسم."
  },
  {
   "segment_id": "s21",
   "text": "وبعد التداول قرر المجتمعون بالإجماع ما يلي:"
  },
  {
   "segment_id": "s22",
   "text": "أولًا: الموافقة على تعيين السيد محمد الجاسم مديرًا للشركة لمدة ثلاث سنوات."
  },
  {
   "segment_id": "s23",
   "text": "ثانيًا: توزيع الأرباح بشكل عادل بين الشركاء حسب حصصهم."
  },
  {
   "segment_id": "s24",
   "text": "ثالثًا: المركز المالي للشركة سليم ولا توجد عليها التزامات متأخرة."
  },
  {
   "segment_id": "s25",
   "text": "رابعًا: تفويض السيد سليم السعدي بالتوقيع على محضر الاجتماع وتقديمه للجهات المختصة."
  },
  {
   "segment_id": "s26",
   "text": "رئيس الاجتماع: أفنان المفتاح"
  },
  {
   "segment_id": "s27",
   "text": "أمين السر: أمين الجاسم"
  }
 ],
