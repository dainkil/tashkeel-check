 "segments": [
  {
   "segment_id": "s01",
   "text": "مستخرج من السجل التجاري"
  },
  {
   "segment_id": "s02",
   "text": "الاسم التجاري: السليمان للتجارة العامة ذ.م.م"
  },
  {
   "segment_id": "s03",
   "text": "رقم الرخصة: 749803، جهة الإصدار: دائرة التنمية الاقتصادية، الإمارة: أبوظبي"
  },
  {
   "segment_id": "s04",
   "text": "الشكل القانوني: شركة ذات مسؤولية محدودة"
  },
  {
   "segment_id": "s05",
   "text": "الشركاء:"
  },
  {
   "segment_id": "s06",
   "text": "1. الدكتور عبد الرحمن بن سالم الظنحاني، عماني الجنسية، الحصة 12٪"
  },
  {
   "segment_id": "s07",
   "text": "Partner 1: ABDULRAHMAN BIN SALEM EL-DHANHANI"
  },
  {
   "segment_id": "s08",
   "text": "Partner 1: EL-DHANHANI, Abdulrahman Salem"
  },
  {
   "segment_id": "s09",
   "text": "P<OMNEL<DHANHANI<<ABDULRAHMAN<SALEM<<<<<<<<<"
  },
  {
   "segment_id": "s10",
   "text": "Passport name: ABDEL RAHMAN BIN SALEM EL-DHANHANI"
  },
  {
   "segment_id": "s11",
   "text": "2. السيد حسن بن عزيز الحرقان، سعودي الجنسية، الحصة 21٪"
  },
  {
   "segment_id": "s12",
   "text": "Partner 2: Hassan bin Aziz Al Hargan"
  },
  {
   "segment_id": "s13",
   "text": "3. السيد عبد الرحمن بن عيسى الظفيري، بحريني الجنسية، الحصة 37٪"
  },
  {
   "segment_id": "s14",
   "text": "Partner 3: Abdulrahman bin Isa Al Dhefiri"
  },
  {
   "segment_id": "s15",
   "text": "4. السيد إسماعيل تركي محمد الياسين، قطري الجنسية، الحصة 16٪"
  },
  {
   "segment_id": "s16",
   "text": "5. المهندس عبد الحكيم عبد الرحمن الظفيري، بحريني الجنسية، الحصة 15٪"
  },
  {
   "segment_id": "s17",
   "text": "6. الدكتور عبد الله بن علي الياسي، كويتي الجنسية، الحصة 28٪"
  },
  {
   "segment_id": "s18",
   "text": "Partner 6: ABDULLAH BIN ALI EL-YASSI"
  },
  {
   "segment_id": "s19",
   "text": "Surname: EL-YASSI / Given names: ABDULLAH ALI"
  },
  {
   "segment_id": "s20",
   "text": "P<KWTEL<YASSI<<ABDULLAH<ALI<<<<<<<<<<<<<<<<<"
  },
  {
   "segment_id": "s21",
   "text": "Surname: EL-YASSI / Given names: ABDALLAH ALI"
  },
  {
   "segment_id": "s22",
   "text": "7. الشيخ مبارك حسن الحرقان، سعودي الجنسية، الحصة 23٪"
  },
  {
   "segment_id": "s23",
   "text": "المدير: الشريك رقم 6، السيد عبد الله الياسي"
  },
  {
   "segment_id": "s24",
   "text": "المفوض بالتوقيع: الشريك رقم 5، السيد عبد الحكيم الظفيري"
  },
