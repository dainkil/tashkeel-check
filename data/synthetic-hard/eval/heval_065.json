 "segments": [
  {
   "segment_id": "s01",
   "text": "وكالة خاصة"
  },
  {
   "segment_id": "s02",
   "text": "إنه في يوم 14/09/2026 حضر أمام الكاتب العدل السيد عامر بن خالد الفراعنة، قطري الجنسية، ويحمل جواز سفر رقم H9107318."
  },
  {
   "segment_id": "s03",
   "text": "Principal: Amer bin Khalid El Faraana, Passport No. H9107318"
  },
  {
   "segment_id": "s04",
   "text": "وذلك بصفته مديرًا لشركة الصديق للتجارة العامة ذ.م.م، المرخصة من دائرة التنمية الاقتصادية برقم 761845، وعنوانها أبوظبي، الإمارات العربية المتحدة."
  },
  {
   "segment_id": "s05",
   "text": "Company: Al Siddiq General Trading L.L.C., Registration No. 761845"
  },
  {
   "segment_id": "s06",
   "text": "وقرر أنه وكّل السيد ثامر بن راشد الصديق، كويتي الجنسية، ويحمل بطاقة هوية رقم 23847086."
  },
  {
   "segment_id": "s07",
   "text": "للقيام نيابة عنه بمراجعة الجهات الحكومية والتوقيع على الطلبات والمستندات المتعلقة بالشركة واستلام الشهادات والتراخيص."
  },
  {
   "segment_id": "s08",
   "text": "وهذا التوكيل صالح لمدة سنة واحدة من تاريخه."
  },
  {
   "segment_id": "s09",
   "text": "والموكل كامل الأهلية المعتبرة قانونًا."
  },
  {
   "segment_id": "s10",
   "text": "الموكل: عامر الفراعنة"
  },
  {
   "segment_id": "s11",
   "text": "الوكيل: ثامر الصديق"
  },
  {
   "segment_id": "s12",
   "text": "التوقيع: ____________"
  }
 ],
