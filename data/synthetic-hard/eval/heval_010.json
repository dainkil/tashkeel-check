 "segments": [
  {
   "segment_id": "s01",
   "text": "Al Kooheji General Trading L.L.C."
  },
  {
   "segment_id": "s02",
   "text": "Tel: +971 4 2519369 | www.alkooheji-group.example.net"
  },
  {
   "segment_id": "s03",
   "text": "إفادة لمن يهمه الأمر"
  },
  {
   "segment_id": "s04",
   "text": "تشهد شركة الكوهجي للتجارة العامة ذ.م.م، المرخصة من دائرة التنمية الاقتصادية برقم 315708، وعنوانها أبوظبي، الإمارات العربية المتحدة،"
  },
  {
   "segment_id": "s05",
   "text": "بأن السيدة صفية حمدان عبد العزيز السبيع، بحرينية الجنسية، وتحمل جواز سفر رقم T6497451، تعمل لديها بوظيفة محاسبة منذ 03/03/2026."
  },
  {
   "segment_id": "s06",
   "text": "وقد أعطيت هذه الإفادة بناءً على طلبها دون أدنى مسؤولية على الشركة."
  },
  {
   "segment_id": "s07",
   "text": "المديرة العامة: السيدة صمود بنت عبد الله بن محمد السبيعي"
  },
  {
   "segment_id": "s08",
   "text": "General Manager: Smood bint Abdullah bin Mohamed Al Sobeai"
  },
  {
   "segment_id": "s09",
   "text": "للاستفسار يرجى التواصل مع إدارة الموارد البشرية على البريد الإلكتروني أدناه."
  },
  {
   "segment_id": "s10",
   "text": "Email: hr@alkooheji.example.com"
  },
  {
   "segment_id": "s11",
   "text": "التاريخ: 02/03/2026"
  }
 ],
