 "segments": [
  {
   "segment_id": "s01",
   "text": "وكالة خاصة"
  },
  {
   "segment_id": "s02",
   "text": "إنه في يوم 28/03/2026 حضر أمام الكاتب العدل السيد إبراهيم ماجد العلي، قطري الجنسية، ويحمل جواز سفر رقم J7114672."
  },
  {
   "segment_id": "s03",
   "text": "Principal: Ebrahim Majid Al Ali, Passport No. J7114672"
  },
  {
   "segment_id": "s04",
   "text": "وذلك بصفته مديرًا لشركة السليطي للتجارة العامة ذ.م.م، المرخصة من دائرة التنمية الاقتصادية برقم 140159، وعنوانها دبي، الإمارات العربية المتحدة."
  },
  {
   "segment_id": "s05",
   "text": "وقرر أنه وكّل السيد إبراهيم بن فهد السلطان، كويتي الجنسية، ويحمل بطاقة هوية رقم 48413821."
  },
  {
   "segment_id": "s06",
   "text": "Attorney: Ibrahim bin Fahad Al Sultan, ID No. 48413821"
  },
  {
   "segment_id": "s07",
   "text": "للقيام نيابة عنه بمراجعة الجهات الحكومية والتوقيع على الطلبات والمستندات المتعلقة بالشركة واستلام الشهادات والتراخيص."
  },
  {
   "segment_id": "s08",
   "text": "وهذا التوكيل صالح لمدة سنة واحدة من تاريخه."
  },
  {
   "segment_id": "s09",
   "text": "والموكل كامل الأهلية المعتبرة قانونًا."
  },
  {
   "segment_id": "s10",
   "text": "الموكل: إبراهيم العلي"
  },
  {
   "segment_id": "s11",
   "text": "الوكيل: إبراهيم السلطان"
  },
  {
   "segment_id": "s12",
   "text": "التوقيع: ____________"
  }
 ],
