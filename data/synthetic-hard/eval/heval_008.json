 "segments": [
  {
   "segment_id": "s01",
   "text": "محضر اجتماع الجمعية العمومية العادية"
  },
  {
   "segment_id": "s02",
   "text": "لشركة الحكيم للتجارة العامة ذ.م.م"
  },
  {
   "segment_id": "s03",
   "text": "عقد الاجتماع في أبوظبي بتاريخ 19/11/2026 برئاسة الشيخ سعيد بن راشد بن ناصر الياسي."
  },
  {
   "segment_id": "s04",
   "text": "وحضر الاجتماع كل من:"
  },
  {
   "segment_id": "s05",
   "text": "1. السيدة ميان عادل أحمد الكويتي"
  },
  {
   "segment_id": "s06",
   "text": "Attendee 1: Mayan Al Kuwaiti"
  },
  {
   "segment_id": "s07",
   "text": "2. السيد سالم بن خليفة بن مشعل الياسين"
  },
  {
   "segment_id": "s08",
   "text": "Attendee 2: Salem bin Khalifa bin Mishaal Al Yassin"
  },
  {
   "segment_id": "s09",
   "text": "Passport name: AL YASSIN, Salim Khalifa Mishaal"
  },
  {
   "segment_id": "s10",
   "text": "3. السيدة إيمان ياسر سعد السعدي"
  },
  {
   "segment_id": "s11",
   "text": "Attendee 3: E. Y. Al Saadi"
  },
  {
   "segment_id": "s12",
   "text": "4. المهندس إبراهيم بن عبد الرحمن الصباح"
  },
  {
   "segment_id": "s13",
   "text": "Attendee 4: Ibrahim bin Abdulrahman Al Sabah"
  },
  {
   "segment_id": "s14",
   "text": "5. الشيخ خالد بن محمد الجدعاني"
  },
  {
   "segment_id": "s15",
   "text": "Attendee 5: Khaled bin Muhammad Al Jadani"
  },
  {
   "segment_id": "s16",
   "text": "6. السيد إبراهيم بن عبد العزيز بن ماهر الموسوي"
  },
  {
   "segment_id": "s17",
   "text": "Attendee 6: Ibrahem bin Abdulaziz bin Maher Al Mosawi"
  },
  {
   "segment_id": "s18",
   "text": "Passport name: AL MUSAWI, Ibrahem Abdulaziz Maher"
  },
  {
   "segment_id": "s19",
   "text": "وتولى أمانة السر الشيخ خالد بن جلال بن علي الكبير."
  },
  {
   "segment_id": "s20",
   "text": "Secretary: Khalid bin Jalal bin Ali Al Kabeer"
  },
  {
   "segment_id": "s21",
   "text": "وبعد التداول قرر المجتمعون بالإجماع ما يلي:"
  },
  {
   "segment_id": "s22",
   "text": "أولًا: الموافقة على تعيين السيد سالم الياسين مديرًا للشركة لمدة ثلاث سنوات."
  },
  {
   "segment_id": "s23",
   "text": "ثانيًا: توزيع الأرباح على الشركاء حسب حصصهم."
  },
  {
   "segment_id": "s24",
   "text": "ثالثًا: المركز المالي للشركة سليم ولا توجد عليها التزامات متأخرة."
  },
  {
   "segment_id": "s25",
   "text": "رابعًا: تفويض السيد إبراهيم الصباح بالتوقيع على محضر الاجتماع وتقديمه للجهات المختصة."
  },
  {
   "segment_id": "s26",
   "text": "رئيس الاجتماع: الشيخ سعيد"
  },
  {
   "segment_id": "s27",
   "text": "أمين السر: خالد الكبير"
  }
 ],
