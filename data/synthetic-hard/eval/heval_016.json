 "bilingual": true,
 "segments": [
  {
   "segment_id": "s01",
   "text": "محضر اجتماع الجمعية العمومية العادية"
  },
  {
   "segment_id": "s02",
   "text": "لشركة الشمالي للتجارة العامة ذ.م.م"
  },
  {
   "segment_id": "s03",
   "text": "Company: Al Shamali General Trading L.L.C."
  },
  {
   "segment_id": "s04",
   "text": "عقد الاجتماع في الشارقة بتاريخ 14/04/2026 برئاسة السيد عبد الله مساعد صالح الدوسري."
  },
  {
   "segment_id": "s05",
   "text": "Chairman: Abdallah Musaid Saleh Al Dawsari"
  },
  {
   "segment_id": "s06",
   "text": "Passport name: ABDALLAH MUSAID SALEH AL DOSERI"
  },
  {
   "segment_id": "s07",
   "text": "وحضر الاجتماع كل من:"
  },
  {
   "segment_id": "s08",
   "text": "1. السيدة فاطمة بنت عبده بن عبد العزيز الكويتي"
  },
  {
   "segment_id": "s09",
   "text": "Attendee 1: F. A. Al Kuwaiti"
  },
  {
   "segment_id": "s10",
   "text": "2. الشيخ عبد الله بن محمد بن شاهين الخاجة"
  },
  {
   "segment_id": "s11",
   "text": "Attendee 2: Abdalla bin Mohammed bin Shahin Al Khaja"
  },
  {
   "segment_id": "s12",
   "text": "Surname: AL KHAJAH / Given names: ABDALLA MOHAMMED SHAHIN"
  },
  {
   "segment_id": "s13",
   "text": "3. السيد محمد درويش راشد الكمالي"
  },
  {
   "segment_id": "s14",
   "text": "Attendee 3: Muhammed Darwish Rashid Al Kamali"
  },
  {
   "segment_id": "s15",
   "text": "4. السيد محمد بن يوسف المولد"
  },
  {
   "segment_id": "s16",
   "text": "Attendee 4: Mohamed bin Yousef Al Muwallad"
  },
  {
   "segment_id": "s17",
   "text": "وتولى أمانة السر المهندسة جميلة ربيع لاحج الدوسري."
  },
  {
   "segment_id": "s18",
   "text": "Secretary: Jameela Al Dosari"
  },
  {
   "segment_id": "s19",
   "text": "وبعد التداول قرر المجتمعون بالإجماع ما يلي:"
  },
  {
   "segment_id": "s20",
   "text": "أولًا: الموافقة على تعيين السيد محمد المولد مديرًا للشركة لمدة ثلاث سنوات."
  },
  {
   "segment_id": "s21",
   "text": "ثانيًا: توزيع الأرباح بشكل عادل بين الشركاء حسب حصصهم."
  },
  {
   "segment_id": "s22",
   "text": "ثالثًا: المركز المالي للشركة سليم ولا توجد عليها التزامات متأخرة."
  },
  {
   "segment_id": "s23",
   "text": "رابعًا: تفويض السيد عبد الله الخاجة بالتوقيع على محضر الاجتماع وتقديمه للجهات المختصة."
  },
  {
   "segment_id": "s24",
   "text": "رئيس الاجتماع: عبد الله الدوسري"
  },
  {
   "segment_id": "s25",
   "text": "أمين السر: جميلة الدوسري"
  }
 ],
