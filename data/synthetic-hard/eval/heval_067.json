 "segments": [
  {
   "segment_id": "s01",
   "text": "مستخرج من السجل التجاري"
  },
  {
   "segment_id": "s02",
   "text": "الاسم التجاري: الأميري للتجارة العامة ذ.م.م"
  },
  {
   "segment_id": "s03",
   "text": "Trade name: Al Amiri General Trading L.L.C."
  },
  {
   "segment_id": "s04",
   "text": "البريد الإلكتروني: info@alamiri-group.example.com"
  },
  {
   "segment_id": "s05",
   "text": "رقم الرخصة: 322782، جهة الإصدار: دائرة التنمية الاقتصادية، الإمارة: أبوظبي"
  },
  {
   "segment_id": "s06",
   "text": "الشكل القانوني: شركة ذات مسؤولية محدودة"
  },
  {
   "segment_id": "s07",
   "text": "الشركاء:"
  },
  {
   "segment_id": "s08",
   "text": "1. الشيخة زينب سيد مبروك العميري، إماراتية الجنسية، الحصة 14٪"
  },
  {
   "segment_id": "s09",
   "text": "Partner 1: Zainab Sayed Mabrouk Al Ameeri"
  },
  {
   "segment_id": "s10",
   "text": "2. المهندسة لؤلؤة بنت مشاري اليامي، بحرينية الجنسية، الحصة 7٪"
  },
  {
   "segment_id": "s11",
   "text": "3. السيدة عائشة بنت سلطان بن صالح العثيمين، إماراتية الجنسية، الحصة 19٪"
  },
  {
   "segment_id": "s12",
   "text": "Partner 3: Aisha Al Uthaymeen"
  },
  {
   "segment_id": "s13",
   "text": "4. السيد سعود بن عبد الرحمن العلي، عماني الجنسية، الحصة 22٪"
  },
  {
   "segment_id": "s14",
   "text": "Partner 4: Saud bin Abdulrahman Al Ali"
  },
  {
   "segment_id": "s15",
   "text": "5. السيدة سارة حميد الأميري، قطرية الجنسية، الحصة 21٪"
  },
  {
   "segment_id": "s16",
   "text": "6. المهندس محمد بن حمد بن أحمد الحارثي، عماني الجنسية، الحصة 5٪"
  },
  {
   "segment_id": "s17",
   "text": "Partner 6: Mohamed bin Hamad bin Ahmed Al Harthi"
  },
  {
   "segment_id": "s18",
   "text": "7. المهندس سعود بن علي السلطان، سعودي الجنسية، الحصة 13٪"
  },
  {
   "segment_id": "s19",
   "text": "P<SAUAL<SULTAN<<SAOUD<ALI<<<<<<<<<<<<<<<<<<<"
  },
  {
   "segment_id": "s20",
   "text": "8. الدكتور محمد بن عادل بن عبد العزيز المنوري، عماني الجنسية، الحصة 24٪"
  },
  {
   "segment_id": "s21",
   "text": "P<OMNAL<MANWARI<<MUHAMMAD<ADEL<ABDULAZIZ<<<<"
  },
  {
   "segment_id": "s22",
   "text": "المدير: الشريك رقم 8، السيد محمد المنوري"
  },
  {
   "segment_id": "s23",
   "text": "المفوض بالتوقيع: الشريك رقم 4، السيد سعود العلي"
  },
  {
   "segment_id": "s24",
   "text": "تاريخ الإصدار: 27/08/2026"
  },
  {
   "segment_id": "s25",
   "text": "التوقيعات:"
  },
  {
