 "bilingual": true,
 "segments": [
  {
   "segment_id": "s01",
   "text": "محضر اجتماع الجمعية العمومية العادية"
  },
  {
   "segment_id": "s02",
   "text": "لشركة العمري للتجارة العامة ذ.م.م"
  },
  {
   "segment_id": "s03",
   "text": "Company: Al Amri General Trading L.L.C."
  },
  {
   "segment_id": "s04",
   "text": "عقد الاجتماع في الشارقة بتاريخ 22/12/2026 برئاسة الشيخة نصرة عبدالعزيز عباس العلي."
  },
  {
   "segment_id": "s05",
   "text": "Chairman: Nasra Al Ali"
  },
  {
   "segment_id": "s06",
   "text": "وحضر الاجتماع كل من:"
  },
  {
   "segment_id": "s07",
   "text": "1. المهندس عادل بن يزن بن إبراهيم القاسمي"
  },
  {
   "segment_id": "s08",
   "text": "Attendee 1: A. Y. Al Qasimi"
  },
  {
   "segment_id": "s09",
   "text": "2. المهندس سليم صقر العوفي"
  },
  {
   "segment_id": "s10",
   "text": "3. السيد صقر بن بندر بن عزيز العوفي"
  },
  {
   "segment_id": "s11",
   "text": "Attendee 3: Saqr bin Bandar bin Aziz El-Aoufi"
  },
  {
   "segment_id": "s12",
   "text": "Surname: AL AOUFI / Given names: SAQR BANDAR AZIZ"
  },
  {
   "segment_id": "s13",
   "text": "4. الشيخ عبد الله بن أمين النعيمي"
  },
  {
   "segment_id": "s14",
   "text": "5. السيدة الجوهرة نواف عبد الرحيم العمري"
  },
  {
   "segment_id": "s15",
   "text": "6. السيد حمد بن فيصل بن هادي العمري"
  },
  {
   "segment_id": "s16",
   "text": "وتولى أمانة السر المهندس أمين محمد النعيمي."
  },
  {
   "segment_id": "s17",
   "text": "Secretary: Ameen Mohamed El Nuaimi"
  },
  {
   "segment_id": "s18",
   "text": "Passport name: AL NUAIMI, Ameen Mohamed"
  },
  {
   "segment_id": "s19",
   "text": "وبعد التداول قرر المجتمعون بالإجماع ما يلي:"
  },
  {
   "segment_id": "s20",
   "text": "أولًا: الموافقة على تعيين السيد صقر العوفي مديرًا للشركة لمدة ثلاث سنوات."
  },
  {
   "segment_id": "s21",
   "text": "ثانيًا: توزيع الأرباح بشكل عادل بين الشركاء حسب حصصهم."
  },
  {
   "segment_id": "s22",
   "text": "ثالثًا: المركز المالي للشركة سليم ولا توجد عليها التزامات متأخرة."
  },
  {
   "segment_id": "s23",
   "text": "رابعًا: تفويض السيدة الجوهرة العمري بالتوقيع على محضر الاجتماع وتقديمه للجهات المختصة."
  },
  {
   "segment_id": "s24",
   "text": "رئيس الاجتماع: الشيخة نصرة"
  },
  {
   "segment_id": "s25",
   "text": "أمين السر: أمين النعيمي"
  }
 ],
