 "segments": [
  {
   "segment_id": "s01",
   "text": "Al Shehri General Trading L.L.C."
  },
  {
   "segment_id": "s02",
   "text": "إفادة لمن يهمه الأمر"
  },
  {
   "segment_id": "s03",
   "text": "تشهد شركة الشهري للتجارة العامة ذ.م.م، المرخصة من دائرة التنمية الاقتصادية برقم 268214، وعنوانها أبوظبي، الإمارات العربية المتحدة،"
  },
  {
   "segment_id": "s04",
   "text": "بأن السيد محمد بن أنس الجمعان، بحريني الجنسية، ويحمل جواز سفر رقم G2400008، يعمل لديها بوظيفة محاسب منذ 22/09/2026."
  },
  {
   "segment_id": "s05",
   "text": "Employee: Mohammed bin Anas Al Jamaan, Passport No. G2400008"
  },
  {
   "segment_id": "s06",
   "text": "Surname: AL JAMAAN / Given names: MOHAMMAD ANAS"
  },
  {
   "segment_id": "s07",
   "text": "ونشهد بأنه حسن السيرة والسلوك طوال مدة عمله لدينا."
  },
  {
   "segment_id": "s08",
   "text": "وقد أعطيت هذه الإفادة بناءً على طلبه دون أدنى مسؤولية على الشركة."
  },
  {
   "segment_id": "s09",
   "text": "المدير العام: السيد أنس بن محمد بن سلطان الجمعان"
  },
  {
   "segment_id": "s10",
   "text": "General Manager: Anas bin Mohammed bin Sultan Al Jamaan"
  },
  {
   "segment_id": "s11",
   "text": "للاستفسار يرجى التواصل مع إدارة الموارد البشرية على البريد الإلكتروني أدناه."
  },
  {
   "segment_id": "s12",
   "text": "Email: hr@alshehri.example.com"
  },
  {
   "segment_id": "s13",
   "text": "التاريخ: 19/01/2026"
  }
