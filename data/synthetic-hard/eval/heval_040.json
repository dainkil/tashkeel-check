 "bilingual": true,
 "segments": [
  {
   "segment_id": "s01",
   "text": "محضر اجتماع الجمعية العمومية العادية"
  },
  {
   "segment_id": "s02",
   "text": "لشركة الفرحان للتجارة العامة ذ.م.م"
  },
  {
   "segment_id": "s03",
   "text": "Company: Al Farhan General Trading L.L.C."
  },
  {
   "segment_id": "s04",
   "text": "عقد الاجتماع في دبي بتاريخ 21/06/2026 برئاسة السيد فيصل بن سلمان بن سلطان الفرحان."
  },
  {
   "segment_id": "s05",
   "text": "Chairman: Faisal bin Salman bin Sultan Al Farhan"
  },
  {
   "segment_id": "s06",
   "text": "وحضر الاجتماع كل من:"
  },
  {
   "segment_id": "s07",
   "text": "1. السيد نواف بن فيصل الفرحان"
  },
  {
   "segment_id": "s08",
   "text": "2. السيد عبد الرحمن حسن العتيبي"
  },
  {
   "segment_id": "s09",
   "text": "Attendee 2: Abdulrahman Al Otaybi"
  },
  {
   "segment_id": "s10",
   "text": "3. السيد فاضل بن سعد العمران"
  },
  {
   "segment_id": "s11",
   "text": "4. السيد سعد بن خالد بن محمد العمران"
  },
  {
   "segment_id": "s12",
   "text": "Attendee 4: Sa'd bin Khalid bin Mohammed Al Omran"
  },
  {
   "segment_id": "s13",
   "text": "وتولى أمانة السر الشيخ بخيت قاسم الصبياني."
  },
  {
   "segment_id": "s14",
   "text": "وبعد التداول قرر المجتمعون بالإجماع ما يلي:"
  },
  {
   "segment_id": "s15",
   "text": "أولًا: الموافقة على تعيين السيد نواف الفرحان مديرًا للشركة لمدة ثلاث سنوات."
  },
  {
   "segment_id": "s16",
   "text": "ثانيًا: توزيع الأرباح على الشركاء حسب حصصهم."
  },
  {
   "segment_id": "s17",
   "text": "ثالثًا: اعتماد الميزانية العمومية للسنة المالية المنتهية."
  },
  {
   "segment_id": "s18",
   "text": "رابعًا: تفويض السيد فاضل العمران بالتوقيع على محضر الاجتماع وتقديمه للجهات المختصة."
  },
  {
   "segment_id": "s19",
   "text": "رئيس الاجتماع: فيصل الفرحان"
  },
  {
   "segment_id": "s20",
   "text": "أمين السر: بخيت الصبياني"
  },
  {
   "segment_id": "s21",
   "text": "التوقيعات:"
  },
  {
   "segment_id": "s22",
   "text": "BAKHEET QASSIM AL SIBYANI"
  }
 ],
