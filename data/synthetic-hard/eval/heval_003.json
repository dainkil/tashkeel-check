 "segments": [
  {
   "segment_id": "s01",
   "text": "مستخرج من السجل التجاري"
  },
  {
   "segment_id": "s02",
   "text": "الاسم التجاري: العيسى للتجارة العامة ذ.م.م"
  },
  {
   "segment_id": "s03",
   "text": "Trade name: Al Esa General Trading L.L.C."
  },
  {
   "segment_id": "s04",
   "text": "رقم الرخصة: 803291، جهة الإصدار: دائرة التنمية الاقتصادية، الإمارة: دبي"
  },
  {
   "segment_id": "s05",
   "text": "الشكل القانوني: شركة ذات مسؤولية محدودة"
  },
  {
   "segment_id": "s06",
   "text": "الشركاء:"
  },
  {
   "segment_id": "s07",
   "text": "1. المهندس أحمد محمد العييري، سعودي الجنسية، الحصة 19٪"
  },
  {
   "segment_id": "s08",
   "text": "Partner 1: AHMED MOHAMED AL AYERI"
  },
  {
   "segment_id": "s09",
   "text": "Surname: AL AYERI / Given names: AHMED MOHAMED"
  },
  {
   "segment_id": "s10",
   "text": "P<SAUAL<AYERI<<AHMED<MOHAMED<<<<<<<<<<<<<<<<"
  },
  {
   "segment_id": "s11",
   "text": "Passport name: AHMAD MOHAMED AL AYERI"
  },
  {
   "segment_id": "s12",
   "text": "2. السيد حسان يونس عبد الكريم الشمري، كويتي الجنسية، الحصة 27٪"
  },
  {
   "segment_id": "s13",
   "text": "3. المهندسة رانيا عبد الله فواز الطلياني، إماراتية الجنسية، الحصة 30٪"
  },
  {
   "segment_id": "s14",
   "text": "4. الدكتور جواد عيسى عبد الرحمن عمرو المحمد، كويتي الجنسية، الحصة 29٪"
  },
  {
   "segment_id": "s15",
   "text": "Partner 4: JAWAD ESSA ABDULRAHMAN AMR AL MOHAMED"
  },
  {
   "segment_id": "s16",
   "text": "Surname: AL MOHAMED / Given names: JAWAD ESSA ABDULRAHMAN AMR"
  },
  {
   "segment_id": "s17",
   "text": "P<KWTAL<MOHAMED<<JAWAD<ESSA<ABDULRAHMAN<AMR<"
  },
  {
   "segment_id": "s18",
   "text": "Surname: AL MUHAMMAD / Given names: JAWAD ESSA ABDULRAHMAN AMR"
  },
  {
   "segment_id": "s19",
   "text": "5. الشيخ خالد بن فهد بن عبد العزيز الدوغان، سعودي الجنسية، الحصة 13٪"
  },
  {
   "segment_id": "s20",
   "text": "Partner 5: Khalid Al Dogan"
  },
  {
   "segment_id": "s21",
   "text": "6. الدكتور عبدالعزيز عماد ربيع العسيري، كويتي الجنسية، الحصة 27٪"
  },
  {
   "segment_id": "s22",
   "text": "7. السيد عواد بن خليفة بن حسين العجمي، بحريني الجنسية، الحصة 39٪"
  },
  {
   "segment_id": "s23",
   "text": "8. الشيخ غسان جاسم آل نهيان، سعودي الجنسية، الحصة 35٪"
  },
  {
   "segment_id": "s24",
   "text": "Partner 8: Ghassan Jassim Al Nahyan"
  },
  {
   "segment_id": "s25",
   "text": "المدير: الشريك رقم 8، السيد غسان آل نهيان"
  },
  {
   "segment_id": "s26",
   "text": "المفوض بالتوقيع: الشريك رقم 6، السيد عبدالعزيز العسيري"
  },
  {
   "segment_id": "s27",
   "text": "تاريخ الإصدار: 23/12/2026"
  },
  {
   "segment_id": "s28",
   "text": "التوقيعات:"
  },
  {
