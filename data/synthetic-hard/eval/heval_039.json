 "segments": [
  {
   "segment_id": "s01",
   "text": "مستخرج من السجل التجاري"
  },
  {
   "segment_id": "s02",
   "text": "الاسم التجاري: المطيري للتجارة العامة ذ.م.م"
  },
  {
   "segment_id": "s03",
   "text": "Trade name: Al Mutairi General Trading L.L.C."
  },
  {
   "segment_id": "s04",
   "text": "البريد الإلكتروني: info@almutairi-group.example.net"
  },
  {
   "segment_id": "s05",
   "text": "رقم الرخصة: 935479، جهة الإصدار: دائرة التنمية الاقتصادية، الإمارة: أبوظبي"
  },
  {
   "segment_id": "s06",
   "text": "الشكل القانوني: شركة ذات مسؤولية محدودة"
  },
  {
   "segment_id": "s07",
   "text": "الشركاء:"
  },
  {
   "segment_id": "s08",
   "text": "1. الدكتور إياد بن محمد بن علاء العلي، سعودي الجنسية، الحصة 36٪"
  },
  {
   "segment_id": "s09",
   "text": "Partner 1: Iyad Al Ali"
  },
  {
   "segment_id": "s10",
   "text": "2. الشيخ أحمد يونس السعدي، بحريني الجنسية، الحصة 12٪"
  },
  {
   "segment_id": "s11",
   "text": "P<BHRAL<SAADI<<AHMED<YOUNES<<<<<<<<<<<<<<<<<"
  },
  {
   "segment_id": "s12",
   "text": "3. السيد إبراهيم بن علي المطيري، إماراتي الجنسية، الحصة 29٪"
  },
  {
   "segment_id": "s13",
   "text": "4. الشيخ أسعد معتز البريكي، كويتي الجنسية، الحصة 36٪"
  },
  {
   "segment_id": "s14",
   "text": "P<KWTAL<BURAIKI<<ASAAD<MOATAZ<<<<<<<<<<<<<<<"
  },
  {
   "segment_id": "s15",
   "text": "5. الشيخ أسد بن عبد المحسن القبيسي، إماراتي الجنسية، الحصة 7٪"
  },
  {
   "segment_id": "s16",
   "text": "6. السيد حسن بن أحمد السعدي، بحريني الجنسية، الحصة 36٪"
  },
  {
   "segment_id": "s17",
   "text": "7. الدكتور علي بن وليد بن جاسم المطيري، إماراتي الجنسية، الحصة 5٪"
  },
  {
   "segment_id": "s18",
   "text": "Partner 7: Ali bin Waleed bin Jassem Al Mutairi"
  },
  {
   "segment_id": "s19",
   "text": "المدير: الشريك رقم 2، السيد أحمد السعدي"
  },
  {
   "segment_id": "s20",
   "text": "المفوض بالتوقيع: الشريك رقم 3، السيد إبراهيم المطيري"
  },
  {
   "segment_id": "s21",
   "text": "تاريخ الإصدار: 19/10/2026"
  }
