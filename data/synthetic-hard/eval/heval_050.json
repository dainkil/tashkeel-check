 "segments": [
  {
   "segment_id": "s01",
   "text": "Al Sibyani General Trading L.L.C."
  },
  {
   "segment_id": "s02",
   "text": "Tel: +971 4 2529160 | www.alsibyani-group.example.net"
  },
  {
   "segment_id": "s03",
   "text": "إفادة لمن يهمه الأمر"
  },
  {
   "segment_id": "s04",
   "text": "تشهد شركة الصبياني للتجارة العامة ذ.م.م، المرخصة من دائرة التنمية الاقتصادية برقم 629644، وعنوانها الشارقة، الإمارات العربية المتحدة،"
  },
  {
   "segment_id": "s05",
   "text": "بأن السيد محمد شاهر عبد الله الخيبري، بحريني الجنسية، ويحمل جواز سفر رقم R2886393، يعمل لديها بوظيفة مندوب مبيعات منذ 14/03/2026."
  },
  {
   "segment_id": "s06",
   "text": "Employee: Muhammed Shaher Abdullah Al Khaibari, Passport No. R2886393"
  },
  {
   "segment_id": "s07",
   "text": "ونشهد بأنه حسن السيرة والسلوك طوال مدة عمله لدينا."
  },
  {
   "segment_id": "s08",
   "text": "وقد أعطيت هذه الإفادة بناءً على طلبه دون أدنى مسؤولية على الشركة."
  },
  {
   "segment_id": "s09",
   "text": "المدير العام: السيد محمد بن فيصل بن نواف الصباح"
  },
  {
   "segment_id": "s10",
   "text": "General Manager: Mohammed bin Faisal bin Nawaf Al Sabah"
  },
  {
   "segment_id": "s11",
   "text": "للاستفسار يرجى التواصل مع إدارة الموارد البشرية على البريد الإلكتروني أدناه."
  },
  {
   "segment_id": "s12",
   "text": "Email: hr@alsibyani.example.com"
  },
  {
   "segment_id": "s13",
   "text": "التاريخ: 21/10/2026"
  }
