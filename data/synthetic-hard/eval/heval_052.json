 "bilingual": true,
 "segments": [
  {
   "segment_id": "s01",
   "text": "محضر اجتماع الجمعية العمومية العادية"
  },
  {
   "segment_id": "s02",
   "text": "لشركة المري للتجارة العامة ذ.م.م"
  },
  {
   "segment_id": "s03",
   "text": "Company: Al Marri General Trading L.L.C."
  },
  {
   "segment_id": "s04",
   "text": "عقد الاجتماع في دبي بتاريخ 08/02/2026 برئاسة السيد محمد خلدون الدامر."
  },
  {
   "segment_id": "s05",
   "text": "Chairman: Mohammed Al Damir"
  },
  {
   "segment_id": "s06",
   "text": "وحضر الاجتماع كل من:"
  },
  {
   "segment_id": "s07",
   "text": "1. المهندس أحمد بن سياف الملا"
  },
  {
   "segment_id": "s08",
   "text": "Attendee 1: Ahmad bin Sayaf El Mulla"
  },
  {
   "segment_id": "s09",
   "text": "Passport name: AHMAD BIN SAYAF MULLA"
  },
  {
   "segment_id": "s10",
   "text": "2. السيد جاسم سعيد ثامر العباس"
  },
  {
   "segment_id": "s11",
   "text": "Attendee 2: Jassem Saeed Thamer Al Abbas"
  },
  {
   "segment_id": "s12",
   "text": "3. الدكتور سعيد مساعد المري"
  },
  {
   "segment_id": "s13",
   "text": "4. الشيخ سعود علي محمود الحسن"
  },
  {
   "segment_id": "s14",
   "text": "Attendee 4: Saud Ali Mahmood El Hassan"
  },
  {
   "segment_id": "s15",
   "text": "Passport name: AL HASAN, Saud Ali Mahmood"
  },
  {
   "segment_id": "s16",
   "text": "5. الشيخ أحمد بن عبد الله الخرافي"
  },
  {
   "segment_id": "s17",
   "text": "Attendee 5: Ahmed bin Abdullah Al Kharafi"
  },
  {
   "segment_id": "s18",
   "text": "وتولى أمانة السر المهندس جاسم حبيب العازمي."
  },
  {
   "segment_id": "s19",
   "text": "Secretary: Jassim Habib Al Aazmi"
  },
  {
   "segment_id": "s20",
   "text": "وبعد التداول قرر المجتمعون بالإجماع ما يلي:"
  },
  {
   "segment_id": "s21",
   "text": "أولًا: الموافقة على تعيين السيد أحمد الخرافي مديرًا للشركة لمدة ثلاث سنوات."
  },
  {
   "segment_id": "s22",
   "text": "ثانيًا: توزيع الأرباح على الشركاء حسب حصصهم."
  },
  {
   "segment_id": "s23",
   "text": "ثالثًا: المركز المالي للشركة سليم ولا توجد عليها التزامات متأخرة."
  },
  {
   "segment_id": "s24",
   "text": "رابعًا: تفويض السيد أحمد الملا بالتوقيع على محضر الاجتماع وتقديمه للجهات المختصة."
  },
  {
   "segment_id": "s25",
   "text": "رئيس الاجتماع: محمد الدامر"
  },
  {
   "segment_id": "s26",
   "text": "أمين السر: جاسم العازمي"
  }
 ],
