 "segments": [
  {
   "segment_id": "s01",
   "text": "وكالة خاصة"
  },
  {
   "segment_id": "s02",
   "text": "إنه في يوم 03/09/2026 حضر أمام الكاتب العدل الدكتور عبد الله بن علي الزعابي، بحريني الجنسية، ويحمل جواز سفر رقم R6357945."
  },
  {
   "segment_id": "s03",
   "text": "Principal: Abdullah bin Ali El Zaabi, Passport No. R6357945"
  },
  {
   "segment_id": "s04",
   "text": "وذلك بصفته مديرًا لشركة العمري للتجارة العامة ذ.م.م، المرخصة من دائرة التنمية الاقتصادية برقم 426229، وعنوانها الشارقة، الإمارات العربية المتحدة."
  },
  {
   "segment_id": "s05",
   "text": "Company: Al Amri General Trading L.L.C., Registration No. 426229"
  },
  {
   "segment_id": "s06",
   "text": "وقرر أنه وكّل السيدة ميان محمد جعفر العمري، إماراتية الجنسية، وتحمل بطاقة هوية رقم 41670180."
  },
  {
   "segment_id": "s07",
   "text": "للقيام نيابة عنه بمراجعة الجهات الحكومية والتوقيع على الطلبات والمستندات المتعلقة بالشركة واستلام الشهادات والتراخيص."
  },
  {
   "segment_id": "s08",
   "text": "وهذا التوكيل صالح لمدة سنة واحدة من تاريخه."
  },
  {
   "segment_id": "s09",
   "text": "والموكل كامل الأهلية المعتبرة قانونًا."
  },
  {
   "segment_id": "s10",
   "text": "الموكل: عبد الله الزعابي"
  },
  {
   "segment_id": "s11",
   "text": "الوكيلة: ميان العمري"
  },
  {
   "segment_id": "s12",
   "text": "التوقيع: ____________"
  }
 ],
