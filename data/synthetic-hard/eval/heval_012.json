 "bilingual": true,
 "segments": [
  {
   "segment_id": "s01",
   "text": "محضر اجتماع الجمعية العمومية العادية"
  },
  {
   "segment_id": "s02",
   "text": "لشركة الكويتي للتجارة العامة ذ.م.م"
  },
  {
   "segment_id": "s03",
   "text": "Company: Al Kuwaiti General Trading L.L.C."
  },
  {
   "segment_id": "s04",
   "text": "عقد الاجتماع في دبي بتاريخ 05/11/2026 برئاسة السيد عبد الكريم سراج المولد."
  },
  {
   "segment_id": "s05",
   "text": "Surname: AL MOWALAD / Given names: ABDELKARIM SERAJ"
  },
  {
   "segment_id": "s06",
   "text": "Passport name: AL MUWALLAD, Abdelkarim Seraj"
  },
  {
   "segment_id": "s07",
   "text": "وحضر الاجتماع كل من:"
  },
  {
   "segment_id": "s08",
   "text": "1. السيد مبارك منصور الكويتي"
  },
  {
   "segment_id": "s09",
   "text": "2. الشيخ عادل جمال قاسم اليامي"
  },
  {
   "segment_id": "s10",
   "text": "Attendee 2: Adel Al Yami"
  },
  {
   "segment_id": "s11",
   "text": "3. السيد عبيد بن سعود القاسمي"
  },
  {
   "segment_id": "s12",
   "text": "4. الشيخ عبد الكريم بن عبد الرحمن الصالح"
  },
  {
   "segment_id": "s13",
   "text": "Attendee 4: Abdulkareem bin Abdulrahman Al Saleh"
  },
  {
   "segment_id": "s14",
   "text": "5. السيد سعود بن سرور القاسمي"
  },
  {
   "segment_id": "s15",
   "text": "Surname: AL QASIMI / Given names: SAUD SUROOR"
  },
  {
   "segment_id": "s16",
   "text": "Passport name: SAOUD BIN SUROOR AL QASSIMI"
  },
  {
   "segment_id": "s17",
   "text": "وتولى أمانة السر الدكتور منصور بن نايف بن حمد الكويتي."
  },
  {
   "segment_id": "s18",
   "text": "Secretary: Mansour bin Nayef bin Hamad Al Kuwaiti"
  },
  {
   "segment_id": "s19",
   "text": "وبعد التداول قرر المجتمعون بالإجماع ما يلي:"
  },
  {
   "segment_id": "s20",
   "text": "أولًا: الموافقة على تعيين السيد سعود القاسمي مديرًا للشركة لمدة ثلاث سنوات."
  },
  {
   "segment_id": "s21",
   "text": "ثانيًا: توزيع الأرباح بشكل عادل بين الشركاء حسب حصصهم."
  },
  {
   "segment_id": "s22",
   "text": "ثالثًا: اعتماد الميزانية العمومية للسنة المالية المنتهية."
  },
  {
   "segment_id": "s23",
   "text": "رابعًا: تفويض السيد عبد الكريم الصالح بالتوقيع على محضر الاجتماع وتقديمه للجهات المختصة."
  },
  {
   "segment_id": "s24",
   "text": "رئيس الاجتماع: عبد الكريم المولد"
  },
  {
   "segment_id": "s25",
   "text": "أمين السر: منصور الكويتي"
  }
 ],
