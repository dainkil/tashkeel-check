 "segments": [
  {
   "segment_id": "s01",
   "text": "Al Mutairi General Trading L.L.C."
  },
  {
   "segment_id": "s02",
   "text": "Tel: +971 4 5481249 | www.almutairi-group.example.com"
  },
  {
   "segment_id": "s03",
   "text": "إفادة لمن يهمه الأمر"
  },
  {
   "segment_id": "s04",
   "text": "تشهد شركة المطيري للتجارة العامة ذ.م.م، المرخصة من دائرة التنمية الاقتصادية برقم 799054، وعنوانها أبوظبي، الإمارات العربية المتحدة،"
  },
  {
   "segment_id": "s05",
   "text": "بأن السيد حسن صالح الكويتي، كويتي الجنسية، ويحمل جواز سفر رقم V9862530، يعمل لديها بوظيفة مندوب مبيعات منذ 20/02/2026."
  },
  {
   "segment_id": "s06",
   "text": "Employee: H. S. Al Kuwaiti, Passport No. V9862530"
  },
  {
   "segment_id": "s07",
   "text": "ونشهد بأنه حسن السيرة والسلوك طوال مدة عمله لدينا."
  },
  {
   "segment_id": "s08",
   "text": "وقد أعطيت هذه الإفادة بناءً على طلبه دون أدنى مسؤولية على الشركة."
  },
  {
   "segment_id": "s09",
   "text": "المديرة العامة: السيدة تهاني بنت أيوب بن عبدالرحمن المطيري"
  },
  {
   "segment_id": "s10",
   "text": "للاستفسار يرجى التواصل مع إدارة الموارد البشرية على البريد الإلكتروني أدناه."
  },
  {
   "segment_id": "s11",
   "text": "Email: hr@almutairi.example.com"
  },
  {
   "segment_id": "s12",
   "text": "التاريخ: 11/07/2026"
  }
 ],
