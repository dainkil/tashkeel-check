 "segments": [
  {
   "segment_id": "s01",
   "text": "مستخرج من السجل التجاري"
  },
  {
   "segment_id": "s02",
   "text": "الاسم التجاري: الإدريسي للتجارة العامة ذ.م.م"
  },
  {
   "segment_id": "s03",
   "text": "Trade name: El Idrissi General Trading L.L.C."
  },
  {
   "segment_id": "s04",
   "text": "البريد الإلكتروني: info@elidrissi-group.example.net"
  },
  {
   "segment_id": "s05",
   "text": "رقم الرخصة: 741614، جهة الإصدار: دائرة التنمية الاقتصادية، الإمارة: الشارقة"
  },
  {
   "segment_id": "s06",
   "text": "الشكل القانوني: شركة ذات مسؤولية محدودة"
  },
  {
   "segment_id": "s07",
   "text": "الشركاء:"
  },
  {
   "segment_id": "s08",
   "text": "1. المهندس جعفر بدر الإدريسي، عماني الجنسية، الحصة 8٪"
  },
  {
   "segment_id": "s09",
   "text": "2. الشيخة حواء بنت محمد العييري، سعودية الجنسية، الحصة 20٪"
  },
  {
   "segment_id": "s10",
   "text": "Partner 2: Hawaa bint Mohamed El Ayeri"
  },
  {
   "segment_id": "s11",
   "text": "3. الشيخة موزة علي العسيري، بحرينية الجنسية، الحصة 37٪"
  },
  {
   "segment_id": "s12",
   "text": "4. السيد بدر بن عمر الإدريسي، عماني الجنسية، الحصة 17٪"
  },
  {
   "segment_id": "s13",
   "text": "Partner 4: Bader bin Omar El Idrissi"
  },
  {
   "segment_id": "s14",
   "text": "5. الدكتور أحمد ياسين الريامي، بحريني الجنسية، الحصة 15٪"
  },
  {
   "segment_id": "s15",
   "text": "6. السيد ياسين شهاب الريامي، بحريني الجنسية، الحصة 10٪"
  },
  {
   "segment_id": "s16",
   "text": "Partner 6: Yaseen Shehab Al Reyami"
  },
  {
   "segment_id": "s17",
   "text": "7. الشيخة مريم خميس إدريس الزواوي، بحرينية الجنسية، الحصة 22٪"
  },
  {
   "segment_id": "s18",
   "text": "Partner 7: Maryam Al Zawawi"
  },
  {
   "segment_id": "s19",
   "text": "المدير: الشريك رقم 5، السيد أحمد الريامي"
  },
  {
   "segment_id": "s20",
   "text": "المفوضة بالتوقيع: الشريكة رقم 7، السيدة مريم الزواوي"
  },
  {
