 "notice": "SYNTHETIC: 합성 데이터. 실존 인물·회사·서류가 아니다. 이름은 Wikidata 이름 단위를 무작위로 조합했다.",
 "doc_type": "minutes",
 "bilingual": true,
 "segments": [
  {
   "segment_id": "s01",
   "text": "محضر اجتماع الجمعية العمومية العادية"
  },
  {
   "segment_id": "s02",
   "text": "لشركة القارئ للتجارة العامة ذ.م.م"
  },
  {
   "segment_id": "s03",
   "text": "Company: Al Qari General Trading L.L.C."
  },
  {
   "segment_id": "s04",
   "text": "عقد الاجتماع في دبي بتاريخ 22/03/2026 برئاسة السيد عبد الله بن خلفان بن سالم القارئ."
  },
  {
   "segment_id": "s05",
   "text": "Chairman: Abdullah bin Khalfan bin Salim El Qari"
  },
  {
   "segment_id": "s06",
   "text": "وحضر الاجتماع كل من:"
  },
  {
   "segment_id": "s07",
   "text": "1. السيد يوسف عبد الله القارئ"
  },
  {
   "segment_id": "s08",
   "text": "2. السيد حمد عمر النخلي"
  },
  {
   "segment_id": "s09",
   "text": "3. الشيخة منيرة أمين المولد"
  },
  {
   "segment_id": "s10",
   "text": "Attendee 3: Munirah Al Muwallad"
  },
  {
   "segment_id": "s11",
   "text": "4. الدكتور عمر أنور النخلي"
  },
  {
   "segment_id": "s12",
   "text": "Attendee 4: Omar Anwar El Nakhli"
  },
  {
   "segment_id": "s13",
   "text": "وتولى أمانة السر السيد محمد ياسر الغافري."
  },
  {
   "segment_id": "s14",
   "text": "وبعد التداول قرر المجتمعون بالإجماع ما يلي:"
  },
  {
   "segment_id": "s15",
   "text": "أولًا: الموافقة على تعيين السيد يوسف القارئ مديرًا للشركة لمدة ثلاث سنوات."
  },
  {
   "segment_id": "s16",
   "text": "ثانيًا: توزيع الأرباح بشكل عادل بين الشركاء حسب حصصهم."
  },
  {
   "segment_id": "s17",
   "text": "ثالثًا: المركز المالي للشركة سليم ولا توجد عليها التزامات متأخرة."
  },
  {
   "segment_id": "s18",
   "text": "رابعًا: تفويض السيد عمر النخلي بالتوقيع على محضر الاجتماع وتقديمه للجهات المختصة."
  },
  {
   "segment_id": "s19",
   "text": "رئيس الاجتماع: عبد الله القارئ"
  },
  {
   "segment_id": "s20",
   "text": "أمين السر: محمد الغافري"
  },
  {
   "segment_id": "s21",
   "text": "التوقيعات:"
  },
  {
   "segment_id": "s22",
   "text": "MUHAMMAD YASSER AL GHAFRI"
  }
 ],
