   "text": "1. السيد مرزا مراد الأحمدي، قطري الجنسية، الحصة 18٪"
  },
  {
   "segment_id": "s09",
   "text": "2. السيد حسن بن يحيى بن عبد العزيز الفهد، قطري الجنسية، الحصة 39٪"
  },
  {
   "segment_id": "s10",
   "text": "Partner 2: Hasan bin Yahya bin Abdulaziz Al Fahad"
  },
  {
   "segment_id": "s11",
   "text": "3. الدكتور حسان علي محمود الرفاعي، قطري الجنسية، الحصة 5٪"
  },
  {
   "segment_id": "s12",
   "text": "4. السيدة غالية تركي حسين البحري، بحرينية الجنسية، الحصة 27٪"
  },
  {
   "segment_id": "s13",
   "text": "5. الدكتورة ماريا فيصل الفضلي، إماراتية الجنسية، الحصة 35٪"
  },
  {
   "segment_id": "s14",
   "text": "Partner 5: Maria Al Fadhli"
  },
  {
   "segment_id": "s15",
   "text": "6. الشيخة أسيل محمد طلال العميري، بحرينية الجنسية، الحصة 26٪"
