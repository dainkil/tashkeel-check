 "bilingual": true,
 "segments": [
  {
   "segment_id": "s01",
   "text": "محضر اجتماع الجمعية العمومية العادية"
  },
  {
   "segment_id": "s02",
   "text": "لشركة الشمراني للتجارة العامة ذ.م.م"
  },
  {
   "segment_id": "s03",
   "text": "Company: Al Shamrani General Trading L.L.C."
  },
  {
   "segment_id": "s04",
   "text": "عقد الاجتماع في أبوظبي بتاريخ 25/12/2026 برئاسة المهندسة لولوة حمد محمد العوضي."
  },
  {
   "segment_id": "s05",
   "text": "Chairman: Lulwa Al Awadi"
  },
  {
   "segment_id": "s06",
   "text": "وحضر الاجتماع كل من:"
  },
  {
   "segment_id": "s07",
   "text": "1. السيد عادل عبد العزيز محسن المشاري"
  },
  {
   "segment_id": "s08",
   "text": "Attendee 1: A. A. Al Mashari"
  },
  {
   "segment_id": "s09",
   "text": "2. السيد سليم بن مبارك بن أحمد العتيبي"
  },
  {
   "segment_id": "s10",
   "text": "Attendee 2: S. M. Al Otaibi"
  },
  {
   "segment_id": "s11",
   "text": "3. المهندس طحنون بن سعيد الشمراني"
  },
  {
   "segment_id": "s12",
   "text": "4. السيد سلطان بن أمين العلوي"
  },
  {
   "segment_id": "s13",
   "text": "5. السيد سعيد عيسى الشمراني"
  },
  {
   "segment_id": "s14",
   "text": "Attendee 5: Said Isa El-Shamrani"
  },
  {
   "segment_id": "s15",
   "text": "وتولى أمانة السر الشيخ أمين عبد الله العلوي."
  },
  {
   "segment_id": "s16",
   "text": "Secretary: Ameen Abdullah El-Alawi"
  },
  {
   "segment_id": "s17",
   "text": "وبعد التداول قرر المجتمعون بالإجماع ما يلي:"
  },
  {
   "segment_id": "s18",
   "text": "أولًا: الموافقة على تعيين السيد سعيد الشمراني مديرًا للشركة لمدة ثلاث سنوات."
  },
  {
   "segment_id": "s19",
   "text": "ثانيًا: توزيع الأرباح بشكل عادل بين الشركاء حسب حصصهم."
  },
  {
   "segment_id": "s20",
   "text": "ثالثًا: المركز المالي للشركة سليم ولا توجد عليها التزامات متأخرة."
  },
  {
   "segment_id": "s21",
   "text": "رابعًا: تفويض السيد سلطان العلوي بالتوقيع على محضر الاجتماع وتقديمه للجهات المختصة."
  },
  {
   "segment_id": "s22",
   "text": "رئيس الاجتماع: المهندسة لولوة"
  },
  {
   "segment_id": "s23",
   "text": "أمين السر: أمين العلوي"
  }
 ],
