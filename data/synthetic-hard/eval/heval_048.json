 "bilingual": true,
 "segments": [
  {
   "segment_id": "s01",
   "text": "محضر اجتماع الجمعية العمومية العادية"
  },
  {
   "segment_id": "s02",
   "text": "لشركة الأحمد للتجارة العامة ذ.م.م"
  },
  {
   "segment_id": "s03",
   "text": "Company: Al Ahmad General Trading L.L.C."
  },
  {
   "segment_id": "s04",
   "text": "عقد الاجتماع في دبي بتاريخ 13/04/2026 برئاسة الشيخ هاشم بن أمين الأحمد."
  },
  {
   "segment_id": "s05",
   "text": "وحضر الاجتماع كل من:"
  },
  {
   "segment_id": "s06",
   "text": "1. المهندس عادل بن عباس المحمد"
  },
  {
   "segment_id": "s07",
   "text": "Attendee 1: Adel bin Abbas Al Mohammed"
  },
  {
   "segment_id": "s08",
   "text": "Surname: AL MOHAMED / Given names: ADEL ABBAS"
  },
  {
   "segment_id": "s09",
   "text": "2. السيد سليم يوسف خالد السقاف"
  },
  {
   "segment_id": "s10",
   "text": "Attendee 2: S. Y. Al Saqqaf"
  },
  {
   "segment_id": "s11",
   "text": "3. السيد أمين بن عادل المحمد"
  },
  {
   "segment_id": "s12",
   "text": "4. السيد حامد بن حارب الشريف"
  },
  {
   "segment_id": "s13",
   "text": "Attendee 4: Hamed Al Sharif"
  },
  {
   "segment_id": "s14",
   "text": "5. السيد أحمد عبد الله العتيبي"
  },
  {
   "segment_id": "s15",
   "text": "وتولى أمانة السر السيد أمين بن راشد الأحمد."
  },
  {
   "segment_id": "s16",
   "text": "Secretary: Amin bin Rashid Al Ahmad"
  },
  {
   "segment_id": "s17",
   "text": "Passport name: AMIN BIN RASHID AL AHMED"
  },
  {
   "segment_id": "s18",
   "text": "وبعد التداول قرر المجتمعون بالإجماع ما يلي:"
  },
  {
   "segment_id": "s19",
   "text": "أولًا: الموافقة على تعيين السيد أحمد العتيبي مديرًا للشركة لمدة ثلاث سنوات."
  },
  {
   "segment_id": "s20",
   "text": "ثانيًا: توزيع الأرباح بشكل عادل بين الشركاء حسب حصصهم."
  },
  {
   "segment_id": "s21",
   "text": "ثالثًا: المركز المالي للشركة سليم ولا توجد عليها التزامات متأخرة."
  },
  {
   "segment_id": "s22",
   "text": "رابعًا: تفويض السيد حامد الشريف بالتوقيع على محضر الاجتماع وتقديمه للجهات المختصة."
  },
  {
   "segment_id": "s23",
   "text": "رئيس الاجتماع: هاشم الأحمد"
  },
  {
   "segment_id": "s24",
   "text": "أمين السر: أمين الأحمد"
  },
  {
   "segment_id": "s25",
   "text": "التوقيعات:"
  },
  {
   "segment_id": "s26",
   "text": "AHMED ABDULLA AL UTAYBI"
  }
 ],
