 "segments": [
  {
   "segment_id": "s01",
   "text": "Al Sabah General Trading L.L.C."
  },
  {
   "segment_id": "s02",
   "text": "Tel: +971 4 7994664 | www.alsabah-group.example.net"
  },
  {
   "segment_id": "s03",
   "text": "إفادة لمن يهمه الأمر"
  },
  {
   "segment_id": "s04",
   "text": "تشهد شركة الصباح للتجارة العامة ذ.م.م، المرخصة من دائرة التنمية الاقتصادية برقم 917421، وعنوانها الشارقة، الإمارات العربية المتحدة،"
  },
  {
   "segment_id": "s05",
   "text": "بأن السيد حسن بن حسين القطري، قطري الجنسية، ويحمل جواز سفر رقم B6561886، يعمل لديها بوظيفة محاسب منذ 24/12/2026."
  },
  {
   "segment_id": "s06",
   "text": "Employee: H. H. Al Qatari, Passport No. B6561886"
  },
  {
   "segment_id": "s07",
   "text": "ونشهد بأنه حسن السيرة والسلوك طوال مدة عمله لدينا."
  },
  {
   "segment_id": "s08",
   "text": "وقد أعطيت هذه الإفادة بناءً على طلبه دون أدنى مسؤولية على الشركة."
  },
  {
   "segment_id": "s09",
   "text": "المدير العام: السيد أحمد بن بابا الصباح"
  },
  {
   "segment_id": "s10",
   "text": "للاستفسار يرجى التواصل مع إدارة الموارد البشرية على البريد الإلكتروني أدناه."
  },
  {
   "segment_id": "s11",
   "text": "Email: hr@alsabah.example.com"
  },
  {
   "segment_id": "s12",
   "text": "التاريخ: 13/06/2026"
  }
