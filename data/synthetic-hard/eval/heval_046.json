   "segment_id": "s01",
   "text": "Al Adawi General Trading L.L.C."
  },
  {
   "segment_id": "s02",
   "text": "Tel: +971 4 4053012 | www.aladawi-group.example.com"
  },
  {
   "segment_id": "s03",
   "text": "إفادة لمن يهمه الأمر"
  },
  {
   "segment_id": "s04",
   "text": "تشهد شركة العدوي للتجارة العامة ذ.م.م، المرخصة من دائرة التنمية الاقتصادية برقم 438997، وعنوانها دبي، الإمارات العربية المتحدة،"
  },
  {
   "segment_id": "s05",
   "text": "بأن السيد مهند بن حسن العدوي، كويتي الجنسية، ويحمل جواز سفر رقم E6809483، يعمل لديها بوظيفة محاسب منذ 17/11/2026."
  },
  {
   "segment_id": "s06",
   "text": "ونشهد بأنه حسن السيرة والسلوك طوال مدة عمله لدينا."
  },
  {
   "segment_id": "s07",
   "text": "وقد أعطيت هذه الإفادة بناءً على طلبه دون أدنى مسؤولية على الشركة."
  },
  {
   "segment_id": "s08",
   "text": "المدير العام: السيد مهنا محمد الصفار"
  },
  {
   "segment_id": "s09",
   "text": "General Manager: Mohanna Mohammed Al Saffar"
  },
  {
   "segment_id": "s10",
   "text": "للاستفسار يرجى التواصل مع إدارة الموارد البشرية على البريد الإلكتروني أدناه."
  },
  {
   "segment_id": "s11",
   "text": "Email: hr@aladawi.example.com"
  },
  {
   "segment_id": "s12",
   "text": "التاريخ: 26/08/2026"
  }
 ],
