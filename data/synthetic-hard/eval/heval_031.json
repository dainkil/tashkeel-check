 "segments": [
  {
   "segment_id": "s01",
   "text": "مستخرج من السجل التجاري"
  },
  {
   "segment_id": "s02",
   "text": "الاسم التجاري: العبيد للتجارة العامة ذ.م.م"
  },
  {
   "segment_id": "s03",
   "text": "Trade name: Al Obaid General Trading L.L.C."
  },
  {
   "segment_id": "s04",
   "text": "البريد الإلكتروني: info@alobaid-group.example.net"
  },
  {
   "segment_id": "s05",
   "text": "رقم الرخصة: 455669، جهة الإصدار: دائرة التنمية الاقتصادية، الإمارة: أبوظبي"
  },
  {
   "segment_id": "s06",
   "text": "الشكل القانوني: شركة ذات مسؤولية محدودة"
  },
  {
   "segment_id": "s07",
   "text": "الشركاء:"
  },
  {
   "segment_id": "s08",
   "text": "1. المهندس فوزي ناصر آل مبارك، كويتي الجنسية، الحصة 20٪"
  },
  {
   "segment_id": "s09",
   "text": "P<KWTEL<MUBARAK<<FOUZI<NASSER<<<<<<<<<<<<<<<"
  },
  {
   "segment_id": "s10",
   "text": "2. الشيخ مرزا عتيق فيصل العبيد، سعودي الجنسية، الحصة 25٪"
  },
  {
   "segment_id": "s11",
   "text": "3. المهندس فوزي بن عبد الرحمن بن خالد العنزي، كويتي الجنسية، الحصة 38٪"
  },
  {
   "segment_id": "s12",
   "text": "P<KWTEL<ANEZI<<FAWZI<ABDULRAHMAN<KHALID<<<<<"
  },
  {
   "segment_id": "s13",
   "text": "4. الدكتور عادل بن حسن القاسمي، إماراتي الجنسية، الحصة 18٪"
  },
  {
   "segment_id": "s14",
   "text": "Partner 4: Adil bin Hassan Al Qasimi"
  },
  {
   "segment_id": "s15",
   "text": "5. الدكتور ميرزا علي محمد أمين الكويتي، كويتي الجنسية، الحصة 23٪"
  },
  {
   "segment_id": "s16",
   "text": "Partner 5: Merza Ali Mohammed Ameen Al Kuwaiti"
  },
  {
   "segment_id": "s17",
   "text": "6. الشيخ عادل عبدالله حمد العلياني، إماراتي الجنسية، الحصة 9٪"
  },
  {
   "segment_id": "s18",
   "text": "Partner 6: Adel Abdullah Hamad Al Olayani"
  },
  {
   "segment_id": "s19",
   "text": "7. السيدة منيرة عبد الكريم الحوسني، عمانية الجنسية، الحصة 37٪"
  },
  {
   "segment_id": "s20",
   "text": "Partner 7: Munira Al Hosani"
  },
  {
   "segment_id": "s21",
   "text": "المدير: الشريك رقم 4، السيد عادل القاسمي"
  },
  {
   "segment_id": "s22",
   "text": "المفوضة بالتوقيع: الشريكة رقم 7، السيدة منيرة الحوسني"
  },
  {
   "segment_id": "s23",
   "text": "تاريخ الإصدار: 20/11/2026"
  }
