 "segments": [
  {
   "segment_id": "s01",
   "text": "Al Munaif General Trading L.L.C."
  },
  {
   "segment_id": "s02",
   "text": "Tel: +971 4 6963100 | www.almunaif-group.example.net"
  },
  {
   "segment_id": "s03",
   "text": "إفادة لمن يهمه الأمر"
  },
  {
   "segment_id": "s04",
   "text": "تشهد شركة المنيف للتجارة العامة ذ.م.م، المرخصة من دائرة التنمية الاقتصادية برقم 507451، وعنوانها الشارقة، الإمارات العربية المتحدة،"
  },
  {
   "segment_id": "s05",
   "text": "بأن السيد مشعل سالم المنيف، إماراتي الجنسية، ويحمل جواز سفر رقم H9504559، يعمل لديها بوظيفة محاسب منذ 11/08/2026."
  },
  {
   "segment_id": "s06",
   "text": "ونشهد بأنه حسن السيرة والسلوك طوال مدة عمله لدينا."
  },
  {
   "segment_id": "s07",
   "text": "وقد أعطيت هذه الإفادة بناءً على طلبه دون أدنى مسؤولية على الشركة."
  },
  {
   "segment_id": "s08",
   "text": "المدير العام: السيد سالم راشد المنيف"
  },
  {
   "segment_id": "s09",
   "text": "General Manager: Salem Rashed Al Munaif"
  },
  {
   "segment_id": "s10",
   "text": "للاستفسار يرجى التواصل مع إدارة الموارد البشرية على البريد الإلكتروني أدناه."
  },
  {
   "segment_id": "s11",
   "text": "Email: hr@almunaif.example.com"
  },
  {
   "segment_id": "s12",
   "text": "التاريخ: 03/02/2026"
  }
