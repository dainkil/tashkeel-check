 "segments": [
  {
   "segment_id": "s01",
   "text": "إفادة لمن يهمه الأمر"
  },
  {
   "segment_id": "s02",
   "text": "تشهد شركة الكندري للتجارة العامة ذ.م.م، المرخصة من دائرة التنمية الاقتصادية برقم 902152، وعنوانها أبوظبي، الإمارات العربية المتحدة،"
  },
  {
   "segment_id": "s03",
   "text": "بأن السيد عبد العزيز بن يوسف بن سيد الإدريسي، سعودي الجنسية، ويحمل جواز سفر رقم S6874758، يعمل لديها بوظيفة مهندس منذ 25/10/2026."
  },
  {
   "segment_id": "s04",
   "text": "Surname: EL IDRISSI / Given names: ABDEL AZIZ YOUSEF SAYED"
  },
  {
   "segment_id": "s05",
   "text": "ونشهد بأنه حسن السيرة والسلوك طوال مدة عمله لدينا."
  },
  {
   "segment_id": "s06",
   "text": "وقد أعطيت هذه الإفادة بناءً على طلبه دون أدنى مسؤولية على الشركة."
  },
  {
   "segment_id": "s07",
   "text": "المدير العام: السيد عبد العزيز بن نواف السالم"
  },
  {
   "segment_id": "s08",
   "text": "General Manager: Abdulaziz bin Nawaf Al Salem"
  },
  {
   "segment_id": "s09",
   "text": "للاستفسار يرجى التواصل مع إدارة الموارد البشرية على البريد الإلكتروني أدناه."
  },
  {
   "segment_id": "s10",
   "text": "Email: hr@alkandari.example.com"
  },
  {
   "segment_id": "s11",
   "text": "التاريخ: 24/06/2026"
  }
 ],
