 "segments": [
  {
   "segment_id": "s01",
   "text": "مستخرج من السجل التجاري"
  },
  {
   "segment_id": "s02",
   "text": "الاسم التجاري: الهاشمي للتجارة العامة ذ.م.م"
  },
  {
   "segment_id": "s03",
   "text": "Trade name: Al Hashimi General Trading L.L.C."
  },
  {
   "segment_id": "s04",
   "text": "البريد الإلكتروني: info@alhashimi-group.example.net"
  },
  {
   "segment_id": "s05",
   "text": "رقم الرخصة: 919219، جهة الإصدار: دائرة التنمية الاقتصادية، الإمارة: الشارقة"
  },
  {
   "segment_id": "s06",
   "text": "الشكل القانوني: شركة ذات مسؤولية محدودة"
  },
  {
   "segment_id": "s07",
   "text": "الشركاء:"
  },
  {
   "segment_id": "s08",
   "text": "1. السيد زايد عبد الله عبد الرحمن الأحمد، كويتي الجنسية، الحصة 11٪"
  },
  {
   "segment_id": "s09",
   "text": "P<KWTEL<AHMAD<<ZAYED<ABDULLA<ABDULRAHMAN<<<<"
  },
  {
   "segment_id": "s10",
   "text": "Surname: AL AHMAD / Given names: ZAYED ABDULLA ABDULRAHMAN"
  },
  {
   "segment_id": "s11",
   "text": "2. الشيخة حمدة حسين يعقوب الكواري، سعودية الجنسية، الحصة 36٪"
  },
  {
   "segment_id": "s12",
   "text": "Partner 2: Hamda Al Kuwari"
  },
  {
   "segment_id": "s13",
   "text": "3. السيد زيد بن سعود الهاشمي، قطري الجنسية، الحصة 34٪"
  },
  {
   "segment_id": "s14",
   "text": "4. السيد علي بن ماجد الصباح، إماراتي الجنسية، الحصة 23٪"
  },
  {
   "segment_id": "s15",
   "text": "5. السيد خالد محمد المطيري، قطري الجنسية، الحصة 5٪"
  },
  {
   "segment_id": "s16",
   "text": "6. السيد محمد فرحان المطيري، قطري الجنسية، الحصة 5٪"
  },
  {
   "segment_id": "s17",
   "text": "P<QATEL<MUTAIRI<<MOHAMMAD<FARHAN<<<<<<<<<<<<"
  },
  {
   "segment_id": "s18",
   "text": "Surname: EL MUTAIRI / Given names: MUHAMMED FARHAN"
  },
  {
   "segment_id": "s19",
   "text": "7. الدكتور ماجد مشاري الصباح، إماراتي الجنسية، الحصة 6٪"
  },
  {
   "segment_id": "s20",
   "text": "Partner 7: Majid Mishari Al Sabah"
  },
  {
   "segment_id": "s21",
   "text": "المدير: الشريك رقم 3، السيد زيد الهاشمي"
  },
  {
   "segment_id": "s22",
   "text": "المفوض بالتوقيع: الشريك رقم 7، السيد ماجد الصباح"
  },
  {
   "segment_id": "s23",
   "text": "تاريخ الإصدار: 11/10/2026"
  }
