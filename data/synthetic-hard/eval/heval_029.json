 "segments": [
  {
   "segment_id": "s01",
   "text": "وكالة خاصة"
  },
  {
   "segment_id": "s02",
   "text": "إنه في يوم 21/09/2026 حضر أمام الكاتب العدل السيد كامل بن حسن بن عبد الرحمن البوسعيدية، قطري الجنسية، ويحمل جواز سفر رقم F6183587."
  },
  {
   "segment_id": "s03",
   "text": "وذلك بصفته مديرًا لشركة المخيني للتجارة العامة ذ.م.م، المرخصة من دائرة التنمية الاقتصادية برقم 672494، وعنوانها أبوظبي، الإمارات العربية المتحدة."
  },
  {
   "segment_id": "s04",
   "text": "Company: Al Mukhaini General Trading L.L.C., Registration No. 672494"
  },
  {
   "segment_id": "s05",
   "text": "وقرر أنه وكّل السيد عيسى بن محمد بن أنور الضويان، بحريني الجنسية، ويحمل بطاقة هوية رقم 89686845."
  },
  {
   "segment_id": "s06",
   "text": "Attorney: E. M. Al Dowayan, ID No. 89686845"
  },
  {
   "segment_id": "s07",
   "text": "للقيام نيابة عنه بمراجعة الجهات الحكومية والتوقيع على الطلبات والمستندات المتعلقة بالشركة واستلام الشهادات والتراخيص."
  },
  {
   "segment_id": "s08",
   "text": "وهذا التوكيل صالح لمدة سنة واحدة من تاريخه."
  },
  {
   "segment_id": "s09",
   "text": "والموكل كامل الأهلية المعتبرة قانونًا."
  },
  {
   "segment_id": "s10",
   "text": "الموكل: كامل البوسعيدية"
  },
  {
   "segment_id": "s11",
   "text": "الوكيل: عيسى الضويان"
  },
  {
   "segment_id": "s12",
   "text": "التوقيع: ____________"
  }
 ],
