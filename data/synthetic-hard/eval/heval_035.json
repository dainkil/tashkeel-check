 "segments": [
  {
   "segment_id": "s01",
   "text": "مستخرج من السجل التجاري"
  },
  {
   "segment_id": "s02",
   "text": "الاسم التجاري: الخليفة للتجارة العامة ذ.م.م"
  },
  {
   "segment_id": "s03",
   "text": "Trade name: Al Khalifa General Trading L.L.C."
  },
  {
   "segment_id": "s04",
   "text": "البريد الإلكتروني: info@alkhalifa-group.example.net"
  },
  {
   "segment_id": "s05",
   "text": "رقم الرخصة: 207293، جهة الإصدار: دائرة التنمية الاقتصادية، الإمارة: أبوظبي"
  },
  {
   "segment_id": "s06",
   "text": "الشكل القانوني: شركة ذات مسؤولية محدودة"
  },
  {
   "segment_id": "s07",
   "text": "الشركاء:"
  },
  {
   "segment_id": "s08",
   "text": "1. الدكتورة منال عبيد الفقيه، بحرينية الجنسية، الحصة 40٪"
  },
  {
   "segment_id": "s09",
   "text": "Partner 1: Manal Al Faqih"
  },
  {
   "segment_id": "s10",
   "text": "2. المهندسة هالة عبد العزيز خليل البنيان، عمانية الجنسية، الحصة 30٪"
  },
  {
   "segment_id": "s11",
   "text": "3. الدكتور فارس بن عيسى القاسمي، عماني الجنسية، الحصة 21٪"
  },
  {
   "segment_id": "s12",
   "text": "Partner 3: Fares bin Isa Al Qasimi"
  },
  {
   "segment_id": "s13",
   "text": "Surname: AL QASSIMI / Given names: FARES ISA"
  },
  {
   "segment_id": "s14",
   "text": "4. الدكتور عبد الله بن مصعب بن وليد الخليفة، كويتي الجنسية، الحصة 37٪"
  },
  {
   "segment_id": "s15",
   "text": "Partner 4: Abdullah bin Mos'aab bin Waleed Al Khalifa"
  },
  {
   "segment_id": "s16",
   "text": "Surname: AL KHALIFAH / Given names: ABDULLAH MOS'AAB WALEED"
  },
  {
   "segment_id": "s17",
   "text": "5. السيد أحمد بن عبد الله الخليفة، كويتي الجنسية، الحصة 32٪"
  },
  {
   "segment_id": "s18",
   "text": "6. الشيخ فارس غانم آل ثاني، سعودي الجنسية، الحصة 22٪"
  },
  {
   "segment_id": "s19",
   "text": "Partner 6: Faris Ghanim Al Thani"
  },
  {
   "segment_id": "s20",
   "text": "7. السيد ناصر عبد الرحمن النيادي، إماراتي الجنسية، الحصة 8٪"
  },
  {
   "segment_id": "s21",
   "text": "8. السيد عبد الرحمن محمد النيادي، إماراتي الجنسية، الحصة 5٪"
  },
  {
   "segment_id": "s22",
   "text": "Partner 8: Abdulrahman Mohammad Al Neyadi"
  },
  {
   "segment_id": "s23",
   "text": "المدير: الشريك رقم 7، السيد ناصر النيادي"
  },
  {
   "segment_id": "s24",
   "text": "المفوض بالتوقيع: الشريك رقم 4، السيد عبد الله الخليفة"
  },
  {
   "segment_id": "s25",
   "text": "تاريخ الإصدار: 21/05/2026"
  },
  {
   "segment_id": "s26",
   "text": "التوقيعات:"
  },
  {
   "segment_id": "s27",
   "text": "HALA ABDULAZIZ KHALIL AL BENYAN"
  }
 ],
