   "segment_id": "s01",
   "text": "Al Mohammad General Trading L.L.C."
  },
  {
   "segment_id": "s02",
   "text": "Tel: +971 4 8412455 | www.almohammad-group.example.com"
  },
  {
   "segment_id": "s03",
   "text": "إفادة لمن يهمه الأمر"
  },
  {
   "segment_id": "s04",
   "text": "تشهد شركة المحمد للتجارة العامة ذ.م.م، المرخصة من دائرة التنمية الاقتصادية برقم 586925، وعنوانها الشارقة، الإمارات العربية المتحدة،"
  },
  {
   "segment_id": "s05",
   "text": "بأن السيد شامي عبد الرحمن المحمد، بحريني الجنسية، ويحمل جواز سفر رقم S1935379، يعمل لديها بوظيفة محاسب منذ 13/04/2026."
  },
  {
   "segment_id": "s06",
   "text": "ونشهد بأنه حسن السيرة والسلوك طوال مدة عمله لدينا."
  },
  {
   "segment_id": "s07",
   "text": "وقد أعطيت هذه الإفادة بناءً على طلبه دون أدنى مسؤولية على الشركة."
  },
  {
   "segment_id": "s08",
   "text": "المدير العام: السيد سامي عبد العزيز العوضي"
  },
  {
   "segment_id": "s09",
   "text": "General Manager: Sami Abdulaziz Al Awadhi"
  },
  {
   "segment_id": "s10",
   "text": "للاستفسار يرجى التواصل مع إدارة الموارد البشرية على البريد الإلكتروني أدناه."
  },
  {
   "segment_id": "s11",
   "text": "Email: hr@almohammad.example.com"
  },
  {
   "segment_id": "s12",
   "text": "التاريخ: 07/01/2026"
  }
