 "doc_type": "minutes",
 "bilingual": true,
 "segments": [
  {
   "segment_id": "s01",
   "text": "محضر اجتماع الجمعية العمومية العادية"
  },
  {
   "segment_id": "s02",
   "text": "لشركة الصباح للتجارة العامة ذ.م.م"
  },
  {
   "segment_id": "s03",
   "text": "Company: Al Sabah General Trading L.L.C."
  },
  {
   "segment_id": "s04",
   "text": "عقد الاجتماع في دبي بتاريخ 22/11/2026 برئاسة السيدة العنود راشد عبد الرحمن الجهني."
  },
  {
   "segment_id": "s05",
   "text": "وحضر الاجتماع كل من:"
  },
  {
   "segment_id": "s06",
   "text": "1. السيد عادل أحمد حامد الخيبري"
  },
  {
   "segment_id": "s07",
   "text": "2. السيد سليم سعد عبد الهادي العبرى"
  },
  {
   "segment_id": "s08",
   "text": "3. السيد سيد حمد محمد الدوسري"
  },
  {
   "segment_id": "s09",
   "text": "Attendee 3: SAYED HAMAD MOHAMAD EL DOSSARY"
  },
  {
   "segment_id": "s10",
   "text": "4. السيد سعيد بن فهد بن محمود الموسى"
  },
  {
   "segment_id": "s11",
   "text": "وتولى أمانة السر الشيخ أمين بن نواف بن صالح الصباح."
  },
  {
   "segment_id": "s12",
   "text": "وبعد التداول قرر المجتمعون بالإجماع ما يلي:"
  },
  {
   "segment_id": "s13",
   "text": "أولًا: الموافقة على تعيين السيد عادل الخيبري مديرًا للشركة لمدة ثلاث سنوات."
  },
  {
   "segment_id": "s14",
   "text": "ثانيًا: توزيع الأرباح بشكل عادل بين الشركاء حسب حصصهم."
  },
  {
   "segment_id": "s15",
   "text": "ثالثًا: المركز المالي للشركة سليم ولا توجد عليها التزامات متأخرة."
  },
  {
   "segment_id": "s16",
   "text": "رابعًا: تفويض السيد سعيد الموسى بالتوقيع على محضر الاجتماع وتقديمه للجهات المختصة."
  },
  {
   "segment_id": "s17",
   "text": "رئيس الاجتماع: العنود الجهني"
  },
  {
   "segment_id": "s18",
   "text": "أمين السر: أمين الصباح"
  },
  {
   "segment_id": "s19",
   "text": "التوقيعات:"
  },
  {
   "segment_id": "s20",
   "text": "ALANOUD RASHID ABDULRAHMAN AL JOHANI"
  }
 ],
