 "bilingual": true,
 "segments": [
  {
   "segment_id": "s01",
   "text": "محضر اجتماع الجمعية العمومية العادية"
  },
  {
   "segment_id": "s02",
   "text": "لشركة الخاجة للتجارة العامة ذ.م.م"
  },
  {
   "segment_id": "s03",
   "text": "Company: Al Khaja General Trading L.L.C."
  },
  {
   "segment_id": "s04",
   "text": "عقد الاجتماع في دبي بتاريخ 26/11/2026 برئاسة الدكتورة أسرار بنت محمد الناصر."
  },
  {
   "segment_id": "s05",
   "text": "Chairman: Asrar Al Nasser"
  },
  {
   "segment_id": "s06",
   "text": "وحضر الاجتماع كل من:"
  },
  {
   "segment_id": "s07",
   "text": "1. الدكتور عادل بن عمار بن خليل الغامدي"
  },
  {
   "segment_id": "s08",
   "text": "Attendee 1: A. A. Al Ghamdi"
  },
  {
   "segment_id": "s09",
   "text": "2. السيد سليم علي حسن العجروش"
  },
  {
   "segment_id": "s10",
   "text": "Attendee 2: S. A. AlAjroush"
  },
  {
   "segment_id": "s11",
   "text": "3. السيد خالد جمال الخاجة"
  },
  {
   "segment_id": "s12",
   "text": "4. السيد جميل بن أمين النعيمي"
  },
  {
   "segment_id": "s13",
   "text": "5. السيد جمال بن شهاب بن يوسف الخاجة"
  },
  {
   "segment_id": "s14",
   "text": "Attendee 5: Jamal bin Shihab bin Youssef El Khaja"
  },
  {
   "segment_id": "s15",
   "text": "Passport name: AL KHAJAH, Jamal Shihab Youssef"
  },
  {
   "segment_id": "s16",
   "text": "وتولى أمانة السر السيد أمين بن سلطان بن أحمد النعيمي."
  },
  {
   "segment_id": "s17",
   "text": "Secretary: Ameen bin Sultan bin Ahmed El Nuaimi"
  },
  {
   "segment_id": "s18",
   "text": "Passport name: AL NUAIMI, Ameen Sultan Ahmed"
  },
  {
   "segment_id": "s19",
   "text": "وبعد التداول قرر المجتمعون بالإجماع ما يلي:"
  },
  {
   "segment_id": "s20",
   "text": "أولًا: الموافقة على تعيين السيد عادل الغامدي مديرًا للشركة لمدة ثلاث سنوات."
  },
  {
   "segment_id": "s21",
   "text": "ثانيًا: توزيع الأرباح بشكل عادل بين الشركاء حسب حصصهم."
  },
  {
   "segment_id": "s22",
   "text": "ثالثًا: المركز المالي للشركة سليم ولا توجد عليها التزامات متأخرة."
  },
  {
   "segment_id": "s23",
   "text": "رابعًا: تفويض السيد جمال الخاجة بالتوقيع على محضر الاجتماع وتقديمه للجهات المختصة."
  },
  {
   "segment_id": "s24",
   "text": "رئيس الاجتماع: أسرار الناصر"
  },
  {
   "segment_id": "s25",
   "text": "أمين السر: أمين النعيمي"
  }
 ],
