 "bilingual": true,
 "segments": [
  {
   "segment_id": "s01",
   "text": "محضر اجتماع الجمعية العمومية العادية"
  },
  {
   "segment_id": "s02",
   "text": "لشركة الفاسي للتجارة العامة ذ.م.م"
  },
  {
   "segment_id": "s03",
   "text": "عقد الاجتماع في دبي بتاريخ 08/05/2026 برئاسة السيد علي بن صقر بن راشد الجاسم."
  },
  {
   "segment_id": "s04",
   "text": "Surname: AL JASSEM / Given names: ALI SAQR RASHID"
  },
  {
   "segment_id": "s05",
   "text": "Passport name: AL JASSIM, Ali Saqr Rashid"
  },
  {
   "segment_id": "s06",
   "text": "وحضر الاجتماع كل من:"
  },
  {
   "segment_id": "s07",
   "text": "1. المهندس عادل بن حمدان الكويتي"
  },
  {
   "segment_id": "s08",
   "text": "2. السيد سليم بن علي الجاسم"
  },
  {
   "segment_id": "s09",
   "text": "3. الشيخ أيمن أحمد الخاجة"
  },
  {
   "segment_id": "s10",
   "text": "4. السيد حمدان بن يوسف الكويتي"
  },
  {
   "segment_id": "s11",
   "text": "Attendee 4: Hamdan bin Yousef Al Kuwaiti"
  },
  {
   "segment_id": "s12",
   "text": "وتولى أمانة السر السيد أمين عبد الله مساعد العنزي."
  },
  {
   "segment_id": "s13",
   "text": "Surname: AL ENEZI / Given names: AMEEN ABDULLAH MOSAAD"
  },
  {
   "segment_id": "s14",
   "text": "Passport name: AMEEN ABDULLAH MOSAAD AL ENAZI"
  },
  {
   "segment_id": "s15",
   "text": "وبعد التداول قرر المجتمعون بالإجماع ما يلي:"
  },
  {
   "segment_id": "s16",
   "text": "أولًا: الموافقة على تعيين السيد عادل الكويتي مديرًا للشركة لمدة ثلاث سنوات."
  },
  {
   "segment_id": "s17",
   "text": "ثانيًا: توزيع الأرباح بشكل عادل بين الشركاء حسب حصصهم."
  },
  {
   "segment_id": "s18",
   "text": "ثالثًا: المركز المالي للشركة سليم ولا توجد عليها التزامات متأخرة."
  },
  {
   "segment_id": "s19",
   "text": "رابعًا: تفويض السيد حمدان الكويتي بالتوقيع على محضر الاجتماع وتقديمه للجهات المختصة."
  },
  {
   "segment_id": "s20",
   "text": "رئيس الاجتماع: علي الجاسم"
  },
  {
   "segment_id": "s21",
   "text": "أمين السر: أمين العنزي"
  },
  {
   "segment_id": "s22",
   "text": "التوقيعات:"
  },
  {
   "segment_id": "s23",
   "text": "AYMAN AHMAD AL KHAJA"
  }
 ],
