 "segments": [
  {
   "segment_id": "s01",
   "text": "مستخرج من السجل التجاري"
  },
  {
   "segment_id": "s02",
   "text": "الاسم التجاري: الهاشمي للتجارة العامة ذ.م.م"
  },
  {
   "segment_id": "s03",
   "text": "رقم الرخصة: 585257، جهة الإصدار: دائرة التنمية الاقتصادية، الإمارة: دبي"
  },
  {
   "segment_id": "s04",
   "text": "الشكل القانوني: شركة ذات مسؤولية محدودة"
  },
  {
   "segment_id": "s05",
   "text": "الشركاء:"
  },
  {
   "segment_id": "s06",
   "text": "1. المهندس طارق بن عمر بن راشد السلوم، قطري الجنسية، الحصة 16٪"
  },
  {
   "segment_id": "s07",
   "text": "Partner 1: Tariq Al Salloum"
  },
  {
   "segment_id": "s08",
   "text": "2. الدكتور فهد سيف صالح القباني، عماني الجنسية، الحصة 38٪"
  },
  {
   "segment_id": "s09",
   "text": "3. السيدة كوثر بنت أحمد السلطان، إماراتية الجنسية، الحصة 12٪"
  },
  {
   "segment_id": "s10",
   "text": "Partner 3: K. A. Al Sultan"
  },
  {
   "segment_id": "s11",
   "text": "4. المهندس علي بن سلمان بن فواز الجدعاني، كويتي الجنسية، الحصة 10٪"
  },
  {
   "segment_id": "s12",
   "text": "Partner 4: A. S. Al Jadaani"
  },
  {
   "segment_id": "s13",
   "text": "5. المهندس مراد منذر العتيبي، بحريني الجنسية، الحصة 6٪"
  },
  {
   "segment_id": "s14",
   "text": "6. السيدة رزان محمد العمير، سعودية الجنسية، الحصة 14٪"
  },
  {
   "segment_id": "s15",
   "text": "Partner 6: Razan Al Omair"
  },
  {
   "segment_id": "s16",
   "text": "7. الشيخة فرح سعيد العيسى، كويتية الجنسية، الحصة 37٪"
  },
  {
   "segment_id": "s17",
   "text": "Partner 7: Farah Al Eissa"
  },
  {
   "segment_id": "s18",
   "text": "المدير: الشريك رقم 1، السيد طارق السلوم"
  },
  {
   "segment_id": "s19",
   "text": "المفوض بالتوقيع: الشريك رقم 5، السيد مراد العتيبي"
  },
  {
   "segment_id": "s20",
   "text": "تاريخ الإصدار: 11/06/2026"
  },
  {
   "segment_id": "s21",
   "text": "التوقيعات:"
  },
  {
   "segment_id": "s22",
   "text": "FAHAD SAIF SALEH AL GABBANI"
  },
  {
   "segment_id": "s23",
   "text": "MORAD MUNTHER AL OTAIBI"
  }
