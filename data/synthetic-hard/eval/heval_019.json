 "segments": [
  {
   "segment_id": "s01",
   "text": "مستخرج من السجل التجاري"
  },
  {
   "segment_id": "s02",
   "text": "الاسم التجاري: النوبي للتجارة العامة ذ.م.م"
  },
  {
   "segment_id": "s03",
   "text": "Trade name: Al Noubi General Trading L.L.C."
  },
  {
   "segment_id": "s04",
   "text": "رقم الرخصة: 769711، جهة الإصدار: دائرة التنمية الاقتصادية، الإمارة: أبوظبي"
  },
  {
   "segment_id": "s05",
   "text": "الشكل القانوني: شركة ذات مسؤولية محدودة"
  },
  {
   "segment_id": "s06",
   "text": "الشركاء:"
  },
  {
   "segment_id": "s07",
   "text": "1. الدكتور سامر بن فهد بن عبد الله العطية، عماني الجنسية، الحصة 27٪"
  },
  {
   "segment_id": "s08",
   "text": "2. الشيخ عامر فارس العبدالله، سعودي الجنسية، الحصة 30٪"
  },
  {
   "segment_id": "s09",
   "text": "Partner 2: Amer Fares Al Abdullah"
  },
  {
   "segment_id": "s10",
   "text": "3. السيدة منال بنت يونس بن نبيل البراق، عمانية الجنسية، الحصة 26٪"
  },
  {
   "segment_id": "s11",
   "text": "4. السيدة ديمة بنت حسين بن عمرو القحطاني، قطرية الجنسية، الحصة 31٪"
  },
  {
   "segment_id": "s12",
   "text": "5. المهندس حمد خليل البراك، سعودي الجنسية، الحصة 40٪"
  },
  {
   "segment_id": "s13",
   "text": "Partner 5: HAMAD KHALIL AL BARRAK"
  },
  {
   "segment_id": "s14",
   "text": "P<SAUAL<BARRAK<<HAMAD<KHALIL<<<<<<<<<<<<<<<<"
  },
  {
   "segment_id": "s15",
   "text": "Passport name: AL BARRAK, Hamed Khalil"
  },
  {
   "segment_id": "s16",
   "text": "6. الشيخ خميس بن سلطان بن هشام الدامر، بحريني الجنسية، الحصة 16٪"
  },
  {
   "segment_id": "s17",
   "text": "Partner 6: KHAMEES BIN SULTAN BIN HISHAM AL DAMIR"
  },
  {
   "segment_id": "s18",
   "text": "P<BHRAL<DAMIR<<KHAMEES<SULTAN<HISHAM<<<<<<<<"
  },
  {
   "segment_id": "s19",
   "text": "Passport name: AL DAMIR, Khames Sultan Hisham"
  },
  {
   "segment_id": "s20",
   "text": "7. السيدة سمر محمد العامر، إماراتية الجنسية، الحصة 20٪"
  },
  {
   "segment_id": "s21",
   "text": "المدير: الشريك رقم 1، السيد سامر العطية"
  },
  {
   "segment_id": "s22",
   "text": "المفوضة بالتوقيع: الشريكة رقم 7، السيدة سمر العامر"
  },
  {
   "segment_id": "s23",
   "text": "تاريخ الإصدار: 10/02/2026"
  },
  {
   "segment_id": "s24",
   "text": "التوقيعات:"
  },
  {
   "segment_id": "s25",
   "text": "DEEMAH BINT HUSSAIN BIN AMR AL QAHTANI"
  }
