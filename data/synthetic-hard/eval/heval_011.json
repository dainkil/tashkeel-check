 "segments": [
  {
   "segment_id": "s01",
   "text": "مستخرج من السجل التجاري"
  },
  {
   "segment_id": "s02",
   "text": "الاسم التجاري: العساكر للتجارة العامة ذ.م.م"
  },
  {
   "segment_id": "s03",
   "text": "رقم الرخصة: 675260، جهة الإصدار: دائرة التنمية الاقتصادية، الإمارة: دبي"
  },
  {
   "segment_id": "s04",
   "text": "الشكل القانوني: شركة ذات مسؤولية محدودة"
  },
  {
   "segment_id": "s05",
   "text": "الشركاء:"
  },
  {
   "segment_id": "s06",
   "text": "1. السيد نايف بن منصور الراشد، بحريني الجنسية، الحصة 8٪"
  },
  {
   "segment_id": "s07",
   "text": "Partner 1: Nayef bin Mansour Al Rashid"
  },
  {
   "segment_id": "s08",
   "text": "2. المهندس شاهر بن خميس بن كاظم المعلا، عماني الجنسية، الحصة 11٪"
  },
  {
   "segment_id": "s09",
   "text": "3. الشيخ نايف محمود الحارثي، بحريني الجنسية، الحصة 27٪"
  },
  {
   "segment_id": "s10",
   "text": "Partner 3: NAIF MAHMUD AL HARTHI"
  },
  {
   "segment_id": "s11",
   "text": "Partner 3: AL HARTHI, Naif Mahmud"
  },
  {
   "segment_id": "s12",
   "text": "Passport name: AL HARTHY, Naif Mahmud"
  },
  {
   "segment_id": "s13",
   "text": "4. السيدة روان بنت مجدي بن فهد الحربي، قطرية الجنسية، الحصة 36٪"
  },
  {
   "segment_id": "s14",
   "text": "5. السيد ساهر بن علوي الجودر، بحريني الجنسية، الحصة 39٪"
  },
  {
   "segment_id": "s15",
   "text": "Partner 5: Saher bin Alawi Al Jowder"
  },
  {
   "segment_id": "s16",
   "text": "6. السيد خالد بن أحمد بن حمزة المبارك، إماراتي الجنسية، الحصة 10٪"
  },
  {
   "segment_id": "s17",
   "text": "Partner 6: Khaled bin Ahmed bin Hamzah Al Mubarak"
  },
  {
   "segment_id": "s18",
   "text": "7. المهندس خالد بن علي بن حسن الخليفة، قطري الجنسية، الحصة 34٪"
  },
  {
   "segment_id": "s19",
   "text": "Partner 7: KHALID BIN ALI BIN HASSAN AL KHALIFAH"
  },
  {
   "segment_id": "s20",
   "text": "Partner 7: AL KHALIFAH, Khalid Ali Hassan"
  },
  {
   "segment_id": "s21",
   "text": "Surname: AL KHALIFA / Given names: KHALID ALI HASSAN"
  },
  {
   "segment_id": "s22",
   "text": "المدير: الشريك رقم 5، السيد ساهر الجودر"
  },
  {
   "segment_id": "s23",
   "text": "المفوضة بالتوقيع: الشريكة رقم 4، السيدة روان الحربي"
  },
  {
   "segment_id": "s24",
   "text": "تاريخ الإصدار: 07/05/2026"
