 "segments": [
  {
   "segment_id": "s01",
   "text": "وكالة خاصة"
  },
  {
   "segment_id": "s02",
   "text": "إنه في يوم 15/11/2026 حضر أمام الكاتب العدل السيدة سارة محمد علي الحماد، عمانية الجنسية، وتحمل جواز سفر رقم C1083760."
  },
  {
   "segment_id": "s03",
   "text": "Principal: Sara Mohammed Ali Al Hammad, Passport No. C1083760"
  },
  {
   "segment_id": "s04",
   "text": "وذلك بصفتها مديرة لشركة الحمد للتجارة العامة ذ.م.م، المرخصة من دائرة التنمية الاقتصادية برقم 775919، وعنوانها الشارقة، الإمارات العربية المتحدة."
  },
  {
   "segment_id": "s05",
   "text": "Company: Al Hamad General Trading L.L.C., Registration No. 775919"
  },
  {
   "segment_id": "s06",
   "text": "وقررت أنها وكّلت السيدة هند عطية سالم الحمد، كويتية الجنسية، وتحمل بطاقة هوية رقم 53992573."
  },
  {
   "segment_id": "s07",
   "text": "للقيام نيابة عنها بمراجعة الجهات الحكومية والتوقيع على الطلبات والمستندات المتعلقة بالشركة واستلام الشهادات والتراخيص."
  },
  {
   "segment_id": "s08",
   "text": "وهذا التوكيل صالح لمدة سنة واحدة من تاريخه."
  },
  {
   "segment_id": "s09",
   "text": "الموكلة: سارة الحماد"
  },
  {
   "segment_id": "s10",
   "text": "الوكيلة: هند الحمد"
  },
  {
   "segment_id": "s11",
   "text": "التوقيع: ____________"
  }
 ],
