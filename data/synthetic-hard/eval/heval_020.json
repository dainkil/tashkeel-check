 "bilingual": true,
 "segments": [
  {
   "segment_id": "s01",
   "text": "محضر اجتماع الجمعية العمومية العادية"
  },
  {
   "segment_id": "s02",
   "text": "لشركة الملا للتجارة العامة ذ.م.م"
  },
  {
   "segment_id": "s03",
   "text": "Company: Mulla General Trading L.L.C."
  },
  {
   "segment_id": "s04",
   "text": "عقد الاجتماع في أبوظبي بتاريخ 28/11/2026 برئاسة المهندس زايد بن خلفان الكويتي."
  },
  {
   "segment_id": "s05",
   "text": "Chairman: AL KUWAITI, Zaid Khalfan"
  },
  {
   "segment_id": "s06",
   "text": "وحضر الاجتماع كل من:"
  },
  {
   "segment_id": "s07",
   "text": "1. الدكتور عادل عيسى محمد ناصر الجراح"
  },
  {
   "segment_id": "s08",
   "text": "Attendee 1: Adil Eisa Mohammed Nasser Al Jarrah"
  },
  {
   "segment_id": "s09",
   "text": "2. السيد زايد بن وليد بن عبد العزيز الحجيلي"
  },
  {
   "segment_id": "s10",
   "text": "Attendee 2: Zayed bin Waleed bin Abdulaziz Al Hujaili"
  },
  {
   "segment_id": "s11",
   "text": "3. السيد إبراهيم بن صالح بن علي الملا"
  },
  {
   "segment_id": "s12",
   "text": "Attendee 3: Ibrahim bin Saleh bin Ali Al Mulla"
  },
  {
   "segment_id": "s13",
   "text": "4. الشيخ أحمد بن فيصل الحمادي"
  },
  {
   "segment_id": "s14",
   "text": "Attendee 4: Ahmed bin Faisal Al Hammadi"
  },
  {
   "segment_id": "s15",
   "text": "5. الشيخة مي زيد عبد الله موسى الفضلي"
  },
  {
   "segment_id": "s16",
   "text": "Attendee 5: AL FADHLI, Mai Zaid Abdullah Moosa"
  },
  {
   "segment_id": "s17",
   "text": "6. الدكتور حسين أحمد الحمادي"
  },
  {
   "segment_id": "s18",
   "text": "وتولى أمانة السر السيد أمين إبراهيم الملا."
  },
  {
   "segment_id": "s19",
   "text": "وبعد التداول قرر المجتمعون بالإجماع ما يلي:"
  },
  {
   "segment_id": "s20",
   "text": "أولًا: الموافقة على تعيين السيد حسين الحمادي مديرًا للشركة لمدة ثلاث سنوات."
  },
  {
   "segment_id": "s21",
   "text": "ثانيًا: توزيع الأرباح بشكل عادل بين الشركاء حسب حصصهم."
  },
  {
   "segment_id": "s22",
   "text": "ثالثًا: اعتماد الميزانية العمومية للسنة المالية المنتهية."
  },
  {
   "segment_id": "s23",
   "text": "رابعًا: تفويض السيد إبراهيم الملا بالتوقيع على محضر الاجتماع وتقديمه للجهات المختصة."
  },
  {
   "segment_id": "s24",
   "text": "رئيس الاجتماع: زايد الكويتي"
  },
  {
   "segment_id": "s25",
   "text": "أمين السر: أمين الملا"
  }
 ],
