   "segment_id": "s01",
   "text": "Al Mansoori General Trading L.L.C."
  },
  {
   "segment_id": "s02",
   "text": "Tel: +971 4 4294000 | www.almansoori-group.example.com"
  },
  {
   "segment_id": "s03",
   "text": "إفادة لمن يهمه الأمر"
  },
  {
   "segment_id": "s04",
   "text": "تشهد شركة المنصوري للتجارة العامة ذ.م.م، المرخصة من دائرة التنمية الاقتصادية برقم 201905، وعنوانها دبي، الإمارات العربية المتحدة،"
  },
  {
   "segment_id": "s05",
   "text": "بأن السيد مازن أحمد المنصوري، قطري الجنسية، ويحمل جواز سفر رقم Y5332350، يعمل لديها بوظيفة محاسب منذ 04/04/2026."
  },
  {
   "segment_id": "s06",
   "text": "ونشهد بأنه حسن السيرة والسلوك طوال مدة عمله لدينا."
  },
  {
   "segment_id": "s07",
   "text": "وقد أعطيت هذه الإفادة بناءً على طلبه دون أدنى مسؤولية على الشركة."
  },
  {
   "segment_id": "s08",
   "text": "المدير العام: السيد أحمد إبراهيم المنصوري"
  },
  {
   "segment_id": "s09",
   "text": "General Manager: Ahmed Ibrahim Al Mansoori"
  },
  {
   "segment_id": "s10",
   "text": "للاستفسار يرجى التواصل مع إدارة الموارد البشرية على البريد الإلكتروني أدناه."
  },
  {
   "segment_id": "s11",
   "text": "Email: hr@almansoori.example.com"
  },
  {
   "segment_id": "s12",
   "text": "التاريخ: 17/01/2026"
  }
