 "segments": [
  {
   "segment_id": "s01",
   "text": "وكالة خاصة"
  },
  {
   "segment_id": "s02",
   "text": "إنه في يوم 26/10/2026 حضر أمام الكاتب العدل السيد كامل عبد الله حامد الخياط، عماني الجنسية، ويحمل جواز سفر رقم U9318576."
  },
  {
   "segment_id": "s03",
   "text": "Principal: Kamil Abdullah Hamed Al Khayyat, Passport No. U9318576"
  },
  {
   "segment_id": "s04",
   "text": "Passport name: KAMIL ABDULLAH HAMED KHAYYAT"
  },
  {
   "segment_id": "s05",
   "text": "وذلك بصفته مديرًا لشركة الخياط للتجارة العامة ذ.م.م، المرخصة من دائرة التنمية الاقتصادية برقم 776973، وعنوانها الشارقة، الإمارات العربية المتحدة."
  },
  {
   "segment_id": "s06",
   "text": "Company: Al Khayyat General Trading L.L.C., Registration No. 776973"
  },
  {
   "segment_id": "s07",
   "text": "وقرر أنه وكّل السيد طلال بن كامل الخياط، عماني الجنسية، ويحمل بطاقة هوية رقم 39654574."
  },
  {
   "segment_id": "s08",
   "text": "للقيام نيابة عنه بمراجعة الجهات الحكومية والتوقيع على الطلبات والمستندات المتعلقة بالشركة واستلام الشهادات والتراخيص."
  },
  {
   "segment_id": "s09",
   "text": "وهذا التوكيل صالح لمدة سنة واحدة من تاريخه."
  },
  {
   "segment_id": "s10",
   "text": "والموكل كامل الأهلية المعتبرة قانونًا."
  },
  {
   "segment_id": "s11",
   "text": "الموكل: كامل الخياط"
  },
  {
   "segment_id": "s12",
   "text": "الوكيل: طلال الخياط"
  },
  {
   "segment_id": "s13",
   "text": "التوقيع: ____________"
  }
 ],
