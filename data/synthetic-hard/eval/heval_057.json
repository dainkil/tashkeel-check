 "segments": [
  {
   "segment_id": "s01",
   "text": "وكالة خاصة"
  },
  {
   "segment_id": "s02",
   "text": "إنه في يوم 12/10/2026 حضر أمام الكاتب العدل السيدة نورة سعيد عبد العزيز الأحمدي، بحرينية الجنسية، وتحمل جواز سفر رقم H2720009."
  },
  {
   "segment_id": "s03",
   "text": "Principal: Nourah Al Ahmadi, Passport No. H2720009"
  },
  {
   "segment_id": "s04",
   "text": "وذلك بصفتها مديرة لشركة الفوزان للتجارة العامة ذ.م.م، المرخصة من دائرة التنمية الاقتصادية برقم 365219، وعنوانها دبي، الإمارات العربية المتحدة."
  },
  {
   "segment_id": "s05",
   "text": "Company: Al Fawzan General Trading L.L.C., Registration No. 365219"
  },
  {
   "segment_id": "s06",
   "text": "وقررت أنها وكّلت السيدة بهية بنت تريم بن حسن الفوزان، قطرية الجنسية، وتحمل بطاقة هوية رقم 11416894."
  },
  {
   "segment_id": "s07",
   "text": "للقيام نيابة عنها بمراجعة الجهات الحكومية والتوقيع على الطلبات والمستندات المتعلقة بالشركة واستلام الشهادات والتراخيص."
  },
  {
   "segment_id": "s08",
   "text": "وهذا التوكيل صالح لمدة سنة واحدة من تاريخه."
  },
  {
   "segment_id": "s09",
   "text": "الموكلة: نورة الأحمدي"
  },
  {
   "segment_id": "s10",
   "text": "الوكيلة: بهية الفوزان"
  },
  {
   "segment_id": "s11",
   "text": "التوقيع: ____________"
  }
 ],
