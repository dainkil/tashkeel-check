 "segments": [
  {
   "segment_id": "s01",
   "text": "Al Shuraim General Trading L.L.C."
  },
  {
   "segment_id": "s02",
   "text": "Tel: +971 4 9581253 | www.alshuraim-group.example.net"
  },
  {
   "segment_id": "s03",
   "text": "إفادة لمن يهمه الأمر"
  },
  {
   "segment_id": "s04",
   "text": "تشهد شركة الشريم للتجارة العامة ذ.م.م، المرخصة من دائرة التنمية الاقتصادية برقم 519808، وعنوانها دبي، الإمارات العربية المتحدة،"
  },
  {
   "segment_id": "s05",
   "text": "بأن المهندس عبد الله بن فيصل بن مهدي البلوي، بحريني الجنسية، ويحمل جواز سفر رقم D6344599، يعمل لديها بوظيفة مهندس منذ 18/12/2026."
  },
  {
   "segment_id": "s06",
   "text": "ونشهد بأنه حسن السيرة والسلوك طوال مدة عمله لدينا."
  },
  {
   "segment_id": "s07",
   "text": "وقد أعطيت هذه الإفادة بناءً على طلبه دون أدنى مسؤولية على الشركة."
  },
  {
   "segment_id": "s08",
   "text": "المدير العام: السيد سعد موسى الشريم"
  },
  {
   "segment_id": "s09",
   "text": "للاستفسار يرجى التواصل مع إدارة الموارد البشرية على البريد الإلكتروني أدناه."
  },
  {
   "segment_id": "s10",
   "text": "Email: hr@alshuraim.example.com"
  },
  {
   "segment_id": "s11",
   "text": "التاريخ: 16/01/2026"
  }
 ],
