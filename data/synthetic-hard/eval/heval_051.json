 "segments": [
  {
   "segment_id": "s01",
   "text": "مستخرج من السجل التجاري"
  },
  {
   "segment_id": "s02",
   "text": "الاسم التجاري: الشيباني للتجارة العامة ذ.م.م"
  },
  {
   "segment_id": "s03",
   "text": "Trade name: Al Shaibani General Trading L.L.C."
  },
  {
   "segment_id": "s04",
   "text": "البريد الإلكتروني: info@alshaibani-group.example.net"
  },
  {
   "segment_id": "s05",
   "text": "رقم الرخصة: 170548، جهة الإصدار: دائرة التنمية الاقتصادية، الإمارة: أبوظبي"
  },
  {
   "segment_id": "s06",
   "text": "الشكل القانوني: شركة ذات مسؤولية محدودة"
  },
  {
   "segment_id": "s07",
   "text": "الشركاء:"
  },
  {
   "segment_id": "s08",
   "text": "1. الشيخة بسمة عبد العزيز عاصم الحربي، قطرية الجنسية، الحصة 20٪"
  },
  {
   "segment_id": "s09",
   "text": "Partner 1: Basma Al Harbi"
  },
  {
   "segment_id": "s10",
   "text": "2. الدكتور سامي حميد نور الحمر، قطري الجنسية، الحصة 40٪"
  },
  {
   "segment_id": "s11",
   "text": "Partner 2: Sami Humaid Noor Al Hamar"
  },
  {
   "segment_id": "s12",
   "text": "3. السيد محمد راشد الشيباني، سعودي الجنسية، الحصة 12٪"
  },
  {
   "segment_id": "s13",
   "text": "4. السيد مطر بن سعود البلوشي، إماراتي الجنسية، الحصة 29٪"
  },
  {
   "segment_id": "s14",
   "text": "Partner 4: Matar bin Saoud Al Balushi"
  },
  {
   "segment_id": "s15",
   "text": "5. المهندسة فاطمة خليفة علوي الشمراني، إماراتية الجنسية، الحصة 16٪"
  },
  {
   "segment_id": "s16",
   "text": "Partner 5: F. K. Al Shamrani"
  },
  {
   "segment_id": "s17",
   "text": "6. الشيخ عيسى بن سامي الحمر، قطري الجنسية، الحصة 35٪"
  },
  {
   "segment_id": "s18",
   "text": "7. الدكتور راشد مروان مهند الشيباني، سعودي الجنسية، الحصة 17٪"
  },
  {
   "segment_id": "s19",
   "text": "Partner 7: Rashid Marwan Muhannad Al Shaibani"
  },
  {
   "segment_id": "s20",
   "text": "8. السيد مطر بن خالد بن عبد الله المهيري، عماني الجنسية، الحصة 40٪"
  },
  {
   "segment_id": "s21",
   "text": "Partner 8: Mattar bin Khaled bin Abdullah Al Muhairi"
  },
  {
   "segment_id": "s22",
   "text": "المدير: الشريك رقم 8، السيد مطر المهيري"
  },
  {
   "segment_id": "s23",
   "text": "المفوض بالتوقيع: الشريك رقم 6، السيد عيسى الحمر"
  },
