 "segments": [
  {
   "segment_id": "s01",
   "text": "وكالة خاصة"
  },
  {
   "segment_id": "s02",
   "text": "إنه في يوم 11/02/2026 حضر أمام الكاتب العدل السيد خليل بن خالد الشعلان، بحريني الجنسية، ويحمل جواز سفر رقم C6321825."
  },
  {
   "segment_id": "s03",
   "text": "Principal: Khalil bin Khalid Al Shaalan, Passport No. C6321825"
  },
  {
   "segment_id": "s04",
   "text": "Surname: AL SHAALAN / Given names: KHALEEL KHALID"
  },
  {
   "segment_id": "s05",
   "text": "وذلك بصفته مديرًا لشركة الشملان للتجارة العامة ذ.م.م، المرخصة من دائرة التنمية الاقتصادية برقم 235462، وعنوانها دبي، الإمارات العربية المتحدة."
  },
  {
   "segment_id": "s06",
   "text": "Company: Al Shamlan General Trading L.L.C., Registration No. 235462"
  },
  {
   "segment_id": "s07",
   "text": "وقرر أنه وكّل السيد سهيل بن خليفة بن منصور الشملان، إماراتي الجنسية، ويحمل بطاقة هوية رقم 68372207."
  },
  {
   "segment_id": "s08",
   "text": "للقيام نيابة عنه بمراجعة الجهات الحكومية والتوقيع على الطلبات والمستندات المتعلقة بالشركة واستلام الشهادات والتراخيص."
  },
  {
   "segment_id": "s09",
   "text": "وهذا التوكيل صالح لمدة سنة واحدة من تاريخه."
  },
  {
   "segment_id": "s10",
   "text": "والموكل كامل الأهلية المعتبرة قانونًا."
  },
  {
   "segment_id": "s11",
   "text": "الموكل: خليل الشعلان"
  },
  {
   "segment_id": "s12",
   "text": "الوكيل: سهيل الشملان"
  },
  {
   "segment_id": "s13",
   "text": "التوقيع: ____________"
  }
 ],
