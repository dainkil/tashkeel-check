 "segments": [
  {
   "segment_id": "s01",
   "text": "وكالة خاصة"
  },
  {
   "segment_id": "s02",
   "text": "إنه في يوم 02/05/2026 حضر أمام الكاتب العدل السيدة بسمة بنت جمعان الكويتي، كويتية الجنسية، وتحمل جواز سفر رقم S2215250."
  },
  {
   "segment_id": "s03",
   "text": "Principal: Basma Al Kuwaiti, Passport No. S2215250"
  },
  {
   "segment_id": "s04",
   "text": "وذلك بصفتها مديرة لشركة الهاشمي للتجارة العامة ذ.م.م، المرخصة من دائرة التنمية الاقتصادية برقم 837284، وعنوانها دبي، الإمارات العربية المتحدة."
  },
  {
   "segment_id": "s05",
   "text": "Company: Al Hashimi General Trading L.L.C., Registration No. 837284"
  },
  {
   "segment_id": "s06",
   "text": "وقررت أنها وكّلت السيدة منيرة بنت عبد العظيم بن منصور الهاشمي، قطرية الجنسية، وتحمل بطاقة هوية رقم 67845833."
  },
  {
   "segment_id": "s07",
   "text": "للقيام نيابة عنها بمراجعة الجهات الحكومية والتوقيع على الطلبات والمستندات المتعلقة بالشركة واستلام الشهادات والتراخيص."
  },
  {
   "segment_id": "s08",
   "text": "وهذا التوكيل صالح لمدة سنة واحدة من تاريخه."
  },
  {
   "segment_id": "s09",
   "text": "الموكلة: بسمة الكويتي"
  },
  {
   "segment_id": "s10",
   "text": "الوكيلة: منيرة الهاشمي"
  },
  {
   "segment_id": "s11",
   "text": "التوقيع: ____________"
  }
 ],
