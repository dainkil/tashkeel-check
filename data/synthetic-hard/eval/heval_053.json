 "segments": [
  {
   "segment_id": "s01",
   "text": "وكالة خاصة"
  },
  {
   "segment_id": "s02",
   "text": "إنه في يوم 01/01/2026 حضر أمام الكاتب العدل السيدة ريم سالم السديري، بحرينية الجنسية، وتحمل جواز سفر رقم W9673670."
  },
  {
   "segment_id": "s03",
   "text": "Principal: Reem Al Sudairy, Passport No. W9673670"
  },
  {
   "segment_id": "s04",
   "text": "وذلك بصفتها مديرة لشركة العزيزي للتجارة العامة ذ.م.م، المرخصة من دائرة التنمية الاقتصادية برقم 281702، وعنوانها الشارقة، الإمارات العربية المتحدة."
  },
  {
   "segment_id": "s05",
   "text": "Company: Al Azizi General Trading L.L.C., Registration No. 281702"
  },
  {
   "segment_id": "s06",
   "text": "وقررت أنها وكّلت السيدة نورا بنت زياد العزيزي، سعودية الجنسية، وتحمل بطاقة هوية رقم 30202201."
  },
  {
   "segment_id": "s07",
   "text": "للقيام نيابة عنها بمراجعة الجهات الحكومية والتوقيع على الطلبات والمستندات المتعلقة بالشركة واستلام الشهادات والتراخيص."
  },
  {
   "segment_id": "s08",
   "text": "وهذا التوكيل صالح لمدة سنة واحدة من تاريخه."
  },
  {
   "segment_id": "s09",
   "text": "الموكلة: ريم السديري"
  },
  {
   "segment_id": "s10",
   "text": "الوكيلة: نورا العزيزي"
  },
  {
   "segment_id": "s11",
   "text": "التوقيع: ____________"
  }
 ],
