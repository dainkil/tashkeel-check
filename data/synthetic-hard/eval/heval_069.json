 "segments": [
  {
   "segment_id": "s01",
   "text": "وكالة خاصة"
  },
  {
   "segment_id": "s02",
   "text": "إنه في يوم 23/08/2026 حضر أمام الكاتب العدل السيد سعيد بن أحمد بن وليد النجار، سعودي الجنسية، ويحمل جواز سفر رقم C8719498."
  },
  {
   "segment_id": "s03",
   "text": "Principal: Saed bin Ahmed bin Waleed Al Najar, Passport No. C8719498"
  },
  {
   "segment_id": "s04",
   "text": "Passport name: AL NAJJAR, Saed Ahmed Waleed"
  },
  {
   "segment_id": "s05",
   "text": "وذلك بصفته مديرًا لشركة الدوسري للتجارة العامة ذ.م.م، المرخصة من دائرة التنمية الاقتصادية برقم 617151، وعنوانها أبوظبي، الإمارات العربية المتحدة."
  },
  {
   "segment_id": "s06",
   "text": "Company: Al Dosari General Trading L.L.C., Registration No. 617151"
  },
  {
   "segment_id": "s07",
   "text": "وقرر أنه وكّل السيد سعود بن جاسم بن علي الدوسري، كويتي الجنسية، ويحمل بطاقة هوية رقم 92304231."
  },
  {
   "segment_id": "s08",
   "text": "للقيام نيابة عنه بمراجعة الجهات الحكومية والتوقيع على الطلبات والمستندات المتعلقة بالشركة واستلام الشهادات والتراخيص."
  },
  {
   "segment_id": "s09",
   "text": "وهذا التوكيل صالح لمدة سنة واحدة من تاريخه."
  },
  {
   "segment_id": "s10",
   "text": "والموكل كامل الأهلية المعتبرة قانونًا."
  },
  {
   "segment_id": "s11",
   "text": "الموكل: سعيد النجار"
  },
  {
   "segment_id": "s12",
   "text": "الوكيل: سعود الدوسري"
  },
  {
   "segment_id": "s13",
   "text": "التوقيع: ____________"
  }
 ],
