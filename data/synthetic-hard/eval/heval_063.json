 "segments": [
  {
   "segment_id": "s01",
   "text": "مستخرج من السجل التجاري"
  },
  {
   "segment_id": "s02",
   "text": "الاسم التجاري: اليوسف للتجارة العامة ذ.م.م"
  },
  {
   "segment_id": "s03",
   "text": "Trade name: Al Yousef General Trading L.L.C."
  },
  {
   "segment_id": "s04",
   "text": "البريد الإلكتروني: info@alyousef-group.example.com"
  },
  {
   "segment_id": "s05",
   "text": "رقم الرخصة: 673586، جهة الإصدار: دائرة التنمية الاقتصادية، الإمارة: دبي"
  },
  {
   "segment_id": "s06",
   "text": "الشكل القانوني: شركة ذات مسؤولية محدودة"
  },
  {
   "segment_id": "s07",
   "text": "الشركاء:"
  },
  {
   "segment_id": "s08",
   "text": "1. السيد عبد الله بن قيس المصري، عماني الجنسية، الحصة 8٪"
  },
  {
   "segment_id": "s09",
   "text": "Partner 1: Abdulla bin Qais El Masri"
  },
  {
   "segment_id": "s10",
   "text": "2. السيد راشد بن حسين الراجح، بحريني الجنسية، الحصة 19٪"
  },
  {
   "segment_id": "s11",
   "text": "Partner 2: Rashed bin Hussain Al Rajih"
  },
  {
   "segment_id": "s12",
   "text": "3. الشيخ حسن بن جاسم القحطاني، قطري الجنسية، الحصة 7٪"
  },
  {
   "segment_id": "s13",
   "text": "Partner 3: Hassan Al Qahtani"
  },
  {
   "segment_id": "s14",
   "text": "4. الدكتور عبيد عامر الناصر، إماراتي الجنسية، الحصة 29٪"
  },
  {
   "segment_id": "s15",
   "text": "Partner 4: Obaid Amer Al Nasser"
  },
  {
   "segment_id": "s16",
   "text": "5. السيد أسامة بن محمد اليوسف، قطري الجنسية، الحصة 21٪"
  },
  {
   "segment_id": "s17",
   "text": "Partner 5: Osama bin Mohammed Al Yousef"
  },
  {
   "segment_id": "s18",
   "text": "6. الدكتور راشد تركي البلوشي، سعودي الجنسية، الحصة 7٪"
  },
  {
   "segment_id": "s19",
   "text": "Partner 6: Rashid Turki Al Balushi"
  },
  {
   "segment_id": "s20",
   "text": "7. الشيخ عبد الله بن طه الجنبي، عماني الجنسية، الحصة 24٪"
  },
  {
   "segment_id": "s21",
   "text": "Partner 7: Abdullah bin Taha El-Janabi"
  },
  {
   "segment_id": "s22",
   "text": "8. الدكتور عبد الله أسامة اليوسف، قطري الجنسية، الحصة 26٪"
  },
  {
   "segment_id": "s23",
   "text": "9. السيد فهد بن عبيد الناصر، إماراتي الجنسية، الحصة 17٪"
  },
  {
   "segment_id": "s24",
   "text": "المدير: الشريك رقم 1، السيد عبد الله المصري"
  },
  {
   "segment_id": "s25",
   "text": "المفوض بالتوقيع: الشريك رقم 5، السيد أسامة اليوسف"
  },
  {
   "segment_id": "s26",
   "text": "تاريخ الإصدار: 15/11/2026"
  }
 ],
