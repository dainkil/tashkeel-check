  },
  {
   "segment_id": "s02",
   "text": "Tel: +971 4 8037041 | www.alamiri-group.example.com"
  },
  {
   "segment_id": "s03",
   "text": "إفادة لمن يهمه الأمر"
  },
  {
   "segment_id": "s04",
   "text": "تشهد شركة الأميري للتجارة العامة ذ.م.م، المرخصة من دائرة التنمية الاقتصادية برقم 593347، وعنوانها الشارقة، الإمارات العربية المتحدة،"
  },
  {
   "segment_id": "s05",
   "text": "بأن السيدة منى موسى الأميري، قطرية الجنسية، وتحمل جواز سفر رقم B3062651، تعمل لديها بوظيفة مندوبة مبيعات منذ 04/08/2026."
  },
  {
   "segment_id": "s06",
   "text": "وقد أعطيت هذه الإفادة بناءً على طلبها دون أدنى مسؤولية على الشركة."
  },
  {
   "segment_id": "s07",
   "text": "المدير العام: السيد محمد بن فيصل السميري"
  },
  {
   "segment_id": "s08",
   "text": "General Manager: Mohamed bin Faisal Al Samiri"
  },
  {
   "segment_id": "s09",
   "text": "للاستفسار يرجى التواصل مع إدارة الموارد البشرية على البريد الإلكتروني أدناه."
  },
  {
   "segment_id": "s10",
   "text": "Email: hr@alamiri.example.com"
  },
  {
   "segment_id": "s11",
   "text": "التاريخ: 04/01/2026"
  }
