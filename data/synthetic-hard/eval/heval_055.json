 "segments": [
  {
   "segment_id": "s01",
   "text": "مستخرج من السجل التجاري"
  },
  {
   "segment_id": "s02",
   "text": "الاسم التجاري: الحازمي للتجارة العامة ذ.م.م"
  },
  {
   "segment_id": "s03",
   "text": "Trade name: Al Hazmi General Trading L.L.C."
  },
  {
   "segment_id": "s04",
   "text": "البريد الإلكتروني: info@alhazmi-group.example.net"
  },
  {
   "segment_id": "s05",
   "text": "رقم الرخصة: 940990، جهة الإصدار: دائرة التنمية الاقتصادية، الإمارة: أبوظبي"
  },
  {
   "segment_id": "s06",
   "text": "الشكل القانوني: شركة ذات مسؤولية محدودة"
  },
  {
   "segment_id": "s07",
   "text": "الشركاء:"
  },
  {
   "segment_id": "s08",
   "text": "1. الشيخ خليفة حاتم المنصوري، بحريني الجنسية، الحصة 23٪"
  },
  {
   "segment_id": "s09",
   "text": "P<BHREL<MANSOURI<<KHALIFA<HATEM<<<<<<<<<<<<<"
  },
  {
   "segment_id": "s10",
   "text": "Passport name: AL MANSOURI, Khalifa Hatem"
  },
  {
   "segment_id": "s11",
   "text": "2. الدكتور هلال بن عزيز المجحد، عماني الجنسية، الحصة 30٪"
  },
  {
   "segment_id": "s12",
   "text": "P<OMNEL<MAJHAD<<HELAL<AZIZ<<<<<<<<<<<<<<<<<<"
  },
  {
   "segment_id": "s13",
   "text": "Surname: EL MAJHAD / Given names: HILAL AZIZ"
  },
  {
   "segment_id": "s14",
   "text": "3. السيد بخيت بن يعقوب الحازمي، سعودي الجنسية، الحصة 13٪"
  },
  {
   "segment_id": "s15",
   "text": "4. الدكتور حسين بن فاضل بن أحمد العازمي، إماراتي الجنسية، الحصة 35٪"
  },
  {
   "segment_id": "s16",
   "text": "Partner 4: Hussain bin Fadel bin Ahmad Al Aazmi"
  },
  {
   "segment_id": "s17",
   "text": "5. السيدة رقية بنت محمد بن سامي العبيدي، قطرية الجنسية، الحصة 21٪"
  },
  {
   "segment_id": "s18",
   "text": "Partner 5: Ruqaya bint Mohammed bin Sami Al Obaidi"
  },
  {
   "segment_id": "s19",
   "text": "6. السيدة هبة بنت سلمان بن حمد الزبيدي، كويتية الجنسية، الحصة 30٪"
  },
  {
   "segment_id": "s20",
   "text": "7. الشيخ عادل بن هلال المجحد، عماني الجنسية، الحصة 36٪"
  },
  {
   "segment_id": "s21",
   "text": "8. السيد سلطان خليفة المنصوري، بحريني الجنسية، الحصة 19٪"
  },
  {
   "segment_id": "s22",
   "text": "9. المهندس عبد الله سالم الدوسري، قطري الجنسية، الحصة 22٪"
  },
  {
   "segment_id": "s23",
   "text": "Partner 9: Abdullah Al Dossari"
  },
  {
   "segment_id": "s24",
   "text": "المدير: الشريك رقم 7، السيد عادل المجحد"
  },
  {
   "segment_id": "s25",
   "text": "المفوض بالتوقيع: الشريك رقم 8، السيد سلطان المنصوري"
  },
  {
   "segment_id": "s26",
   "text": "تاريخ الإصدار: 04/08/2026"
  }
