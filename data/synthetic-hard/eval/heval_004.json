 "bilingual": true,
 "segments": [
  {
   "segment_id": "s01",
   "text": "محضر اجتماع الجمعية العمومية العادية"
  },
  {
   "segment_id": "s02",
   "text": "لشركة الزهراني للتجارة العامة ذ.م.م"
  },
  {
   "segment_id": "s03",
   "text": "عقد الاجتماع في أبوظبي بتاريخ 13/03/2026 برئاسة الشيخ عبد الرحمن ماجد حمد البراء."
  },
  {
   "segment_id": "s04",
   "text": "Chairman: Abdurahman Majid Hamad Al Bara'a"
  },
  {
   "segment_id": "s05",
   "text": "وحضر الاجتماع كل من:"
  },
  {
   "segment_id": "s06",
   "text": "1. المهندس عادل بن سالم بن سلطان المري"
  },
  {
   "segment_id": "s07",
   "text": "Attendee 1: Adel bin Salem bin Sultan Al Marri"
  },
  {
   "segment_id": "s08",
   "text": "2. الشيخ سليم فهد آل سعود"
  },
  {
   "segment_id": "s09",
   "text": "Attendee 2: SULAYEM FAHAD EL SAUD"
  },
  {
   "segment_id": "s10",
   "text": "Attendee 2: EL SAUD, Sulayem Fahad"
  },
  {
   "segment_id": "s11",
   "text": "3. الشيخ عبد الله بن حسن الغانم"
  },
  {
   "segment_id": "s12",
   "text": "Attendee 3: ABDULLA BIN HASSAN EL GHANEM"
  },
  {
   "segment_id": "s13",
   "text": "Attendee 3: EL GHANEM, Abdulla Hassan"
  },
  {
   "segment_id": "s14",
   "text": "4. الدكتور يوسف بن سعيد بن خالد البراق"
  },
  {
   "segment_id": "s15",
   "text": "5. المهندس سلمان بن عادل المري"
  },
  {
   "segment_id": "s16",
   "text": "6. الدكتور محمد بن عبد الله الغانم"
  },
  {
   "segment_id": "s17",
   "text": "وتولى أمانة السر السيد أمين عبد العزيز شهاب الكويتي."
  },
  {
   "segment_id": "s18",
   "text": "وبعد التداول قرر المجتمعون بالإجماع ما يلي:"
  },
  {
   "segment_id": "s19",
   "text": "أولًا: الموافقة على تعيين السيد عبد الله الغانم مديرًا للشركة لمدة ثلاث سنوات."
  },
  {
   "segment_id": "s20",
   "text": "ثانيًا: توزيع الأرباح بشكل عادل بين الشركاء حسب حصصهم."
  },
  {
   "segment_id": "s21",
   "text": "ثالثًا: المركز المالي للشركة سليم ولا توجد عليها التزامات متأخرة."
  },
  {
   "segment_id": "s22",
   "text": "رابعًا: تفويض السيد عادل المري بالتوقيع على محضر الاجتماع وتقديمه للجهات المختصة."
  },
  {
   "segment_id": "s23",
   "text": "رئيس الاجتماع: عبد الرحمن البراء"
  },
  {
   "segment_id": "s24",
   "text": "أمين السر: أمين الكويتي"
  }
 ],
