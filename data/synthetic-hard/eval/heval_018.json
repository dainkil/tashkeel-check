 "segments": [
  {
   "segment_id": "s01",
   "text": "Al Rashidi General Trading L.L.C."
  },
  {
   "segment_id": "s02",
   "text": "إفادة لمن يهمه الأمر"
  },
  {
   "segment_id": "s03",
   "text": "تشهد شركة الرشيدي للتجارة العامة ذ.م.م، المرخصة من دائرة التنمية الاقتصادية برقم 373123، وعنوانها الشارقة، الإمارات العربية المتحدة،"
  },
  {
   "segment_id": "s04",
   "text": "بأن السيد عبد الحميد خليفة المحمد، إماراتي الجنسية، ويحمل جواز سفر رقم D1011584، يعمل لديها بوظيفة مهندس منذ 08/07/2026."
  },
  {
   "segment_id": "s05",
   "text": "ونشهد بأنه حسن السيرة والسلوك طوال مدة عمله لدينا."
  },
  {
   "segment_id": "s06",
   "text": "وقد أعطيت هذه الإفادة بناءً على طلبه دون أدنى مسؤولية على الشركة."
  },
  {
   "segment_id": "s07",
   "text": "المدير العام: السيد خليفة بن يوسف بن عبد الحكيم المحمد"
  },
  {
   "segment_id": "s08",
   "text": "General Manager: Khalifa bin Yousif bin Abdul Hakim Al Mohammed"
  },
  {
   "segment_id": "s09",
   "text": "للاستفسار يرجى التواصل مع إدارة الموارد البشرية على البريد الإلكتروني أدناه."
  },
  {
   "segment_id": "s10",
   "text": "Email: hr@alrashidi.example.com"
  },
  {
   "segment_id": "s11",
   "text": "التاريخ: 19/01/2026"
  }
 ],
