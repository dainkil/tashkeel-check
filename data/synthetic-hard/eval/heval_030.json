 "segments": [
  {
   "segment_id": "s01",
   "text": "إفادة لمن يهمه الأمر"
  },
  {
   "segment_id": "s02",
   "text": "تشهد شركة الشنار للتجارة العامة ذ.م.م، المرخصة من دائرة التنمية الاقتصادية برقم 653612، وعنوانها الشارقة، الإمارات العربية المتحدة،"
  },
  {
   "segment_id": "s03",
   "text": "بأن السيد شهاب بن نظمي بن سعود العمري، كويتي الجنسية، ويحمل جواز سفر رقم T1607985، يعمل لديها بوظيفة مندوب مبيعات منذ 10/12/2026."
  },
  {
   "segment_id": "s04",
   "text": "Employee: Shehab bin Nadhmi bin Saud El Amri, Passport No. T1607985"
  },
  {
   "segment_id": "s05",
   "text": "Passport name: SHIHAB BIN NADHMI BIN SAUD EL AMRI"
  },
  {
   "segment_id": "s06",
   "text": "ونشهد بأنه حسن السيرة والسلوك طوال مدة عمله لدينا."
  },
  {
   "segment_id": "s07",
   "text": "وقد أعطيت هذه الإفادة بناءً على طلبه دون أدنى مسؤولية على الشركة."
  },
  {
   "segment_id": "s08",
   "text": "المدير العام: السيد محمد بن بلال بن رشيد الجمري"
  },
  {
   "segment_id": "s09",
   "text": "General Manager: Mohammed bin Bilal bin Rashid Al Jamri"
  },
  {
   "segment_id": "s10",
   "text": "للاستفسار يرجى التواصل مع إدارة الموارد البشرية على البريد الإلكتروني أدناه."
  },
  {
   "segment_id": "s11",
   "text": "Email: hr@alshanar.example.com"
  },
  {
   "segment_id": "s12",
   "text": "التاريخ: 13/04/2026"
  }
 ],
