 "segments": [
  {
   "segment_id": "s01",
   "text": "مستخرج من السجل التجاري"
  },
  {
   "segment_id": "s02",
   "text": "الاسم التجاري: العذل للتجارة العامة ذ.م.م"
  },
  {
   "segment_id": "s03",
   "text": "Trade name: Al Athel General Trading L.L.C."
  },
  {
   "segment_id": "s04",
   "text": "رقم الرخصة: 849631، جهة الإصدار: دائرة التنمية الاقتصادية، الإمارة: دبي"
  },
  {
   "segment_id": "s05",
   "text": "الشكل القانوني: شركة ذات مسؤولية محدودة"
  },
  {
   "segment_id": "s06",
   "text": "الشركاء:"
  },
  {
   "segment_id": "s07",
   "text": "1. الشيخ أسد بن سالم بن عبده الظنحاني، عماني الجنسية، الحصة 14٪"
  },
  {
   "segment_id": "s08",
   "text": "2. الدكتور زياد خليفة حسين محمد البسام، قطري الجنسية، الحصة 28٪"
  },
  {
   "segment_id": "s09",
   "text": "Partner 2: EL-BASSAM, Ziyad Khalifa Hussain Muhammad"
  },
  {
   "segment_id": "s10",
   "text": "P<QATEL<BASSAM<<ZIYAD<KHALIFA<<<<<<<<<<<<<<<"
  },
  {
   "segment_id": "s11",
   "text": "3. السيد رامز بن مساعد الفيصل، إماراتي الجنسية، الحصة 5٪"
  },
  {
   "segment_id": "s12",
   "text": "4. السيد إياد بن يزيد بن ناصر الحوطي، كويتي الجنسية، الحصة 13٪"
  },
  {
   "segment_id": "s13",
   "text": "5. الدكتورة مهرة بنت حمد بن عبد الرحيم الشهري، عمانية الجنسية، الحصة 9٪"
  },
  {
   "segment_id": "s14",
   "text": "6. الدكتور رامي أحمد سعود الناصر، عماني الجنسية، الحصة 22٪"
  },
  {
   "segment_id": "s15",
   "text": "Partner 6: Rami Ahmed Saoud Al Nasser"
  },
  {
   "segment_id": "s16",
   "text": "7. المهندس أسعد بن سعد الكويتي، كويتي الجنسية، الحصة 27٪"
  },
  {
   "segment_id": "s17",
   "text": "Surname: EL KUWAITI / Given names: ASA'AD SAAD"
  },
  {
   "segment_id": "s18",
   "text": "P<KWTEL<KUWAITI<<ASAAD<SAAD<<<<<<<<<<<<<<<<<"
  },
  {
   "segment_id": "s19",
   "text": "المدير: الشريك رقم 2، السيد زياد البسام"
  },
  {
   "segment_id": "s20",
   "text": "المفوض بالتوقيع: الشريك رقم 6، السيد رامي الناصر"
  },
  {
   "segment_id": "s21",
   "text": "تاريخ الإصدار: 08/06/2026"
  },
  {
   "segment_id": "s22",
   "text": "التوقيعات:"
  },
  {
   "segment_id": "s23",
   "text": "Mahra bint Hamad bin Abduraheem Al Shehri"
  }
