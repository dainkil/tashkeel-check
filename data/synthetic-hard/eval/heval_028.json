 "bilingual": true,
 "segments": [
  {
   "segment_id": "s01",
   "text": "محضر اجتماع الجمعية العمومية العادية"
  },
  {
   "segment_id": "s02",
   "text": "لشركة المطيري للتجارة العامة ذ.م.م"
  },
  {
   "segment_id": "s03",
   "text": "Company: Al Mutairi General Trading L.L.C."
  },
  {
   "segment_id": "s04",
   "text": "عقد الاجتماع في دبي بتاريخ 13/06/2026 برئاسة السيدة سمر مساعد المطيري."
  },
  {
   "segment_id": "s05",
   "text": "وحضر الاجتماع كل من:"
  },
  {
   "segment_id": "s06",
   "text": "1. السيد عادل بن هادي الحربي"
  },
  {
   "segment_id": "s07",
   "text": "Attendee 1: A. H. Al Harbi"
  },
  {
   "segment_id": "s08",
   "text": "2. الدكتورة ياسمين بنت عبد الفتاح المطيري"
  },
  {
   "segment_id": "s09",
   "text": "3. السيد سالم بن شهاب الحبيب"
  },
  {
   "segment_id": "s10",
   "text": "Attendee 3: Salim bin Shihab Al Habib"
  },
  {
   "segment_id": "s11",
   "text": "4. الشيخ عبد الله النواف سيد الحارثي"
  },
  {
   "segment_id": "s12",
   "text": "Surname: AL HARTHI / Given names: ABDULLAH NAWAF SAYED"
  },
  {
   "segment_id": "s13",
   "text": "Passport name: ABDULLAH NAWAF SAYED AL HARTHY"
  },
  {
   "segment_id": "s14",
   "text": "5. الشيخ سالم بن عبد الرحمن بن وسام القاسمي"
  },
  {
   "segment_id": "s15",
   "text": "Surname: AL QASIMI / Given names: SALEM ABDULRAHMAN WESAM"
  },
  {
   "segment_id": "s16",
   "text": "Surname: AL QASSEMI / Given names: SALEM ABDULRAHMAN WESAM"
  },
  {
   "segment_id": "s17",
   "text": "6. السيد عبد الله ناصر السليم"
  },
  {
   "segment_id": "s18",
   "text": "Attendee 6: Abdulla Naser Al Salim"
  },
  {
   "segment_id": "s19",
   "text": "وتولى أمانة السر السيد أمين بن محمد بن تركي الطارش."
  },
  {
   "segment_id": "s20",
   "text": "Secretary: A. M. Tarish"
  },
  {
   "segment_id": "s21",
   "text": "وبعد التداول قرر المجتمعون بالإجماع ما يلي:"
  },
  {
   "segment_id": "s22",
   "text": "أولًا: الموافقة على تعيين السيد عبد الله الحارثي مديرًا للشركة لمدة ثلاث سنوات."
  },
  {
   "segment_id": "s23",
   "text": "ثانيًا: توزيع الأرباح بشكل عادل بين الشركاء حسب حصصهم."
  },
  {
   "segment_id": "s24",
   "text": "ثالثًا: اعتماد الميزانية العمومية للسنة المالية المنتهية."
  },
  {
   "segment_id": "s25",
   "text": "رابعًا: تفويض السيد عادل الحربي بالتوقيع على محضر الاجتماع وتقديمه للجهات المختصة."
  },
  {
   "segment_id": "s26",
   "text": "رئيس الاجتماع: سمر المطيري"
  },
  {
   "segment_id": "s27",
   "text": "أمين السر: أمين الطارش"
  }
 ],
