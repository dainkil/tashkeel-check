 "segments": [
  {
   "segment_id": "s01",
   "text": "Al Farsi General Trading L.L.C."
  },
  {
   "segment_id": "s02",
   "text": "Tel: +971 4 4785639 | www.alfarsi-group.example.net"
  },
  {
   "segment_id": "s03",
   "text": "إفادة لمن يهمه الأمر"
  },
  {
   "segment_id": "s04",
   "text": "تشهد شركة الفارسي للتجارة العامة ذ.م.م، المرخصة من دائرة التنمية الاقتصادية برقم 858024، وعنوانها دبي، الإمارات العربية المتحدة،"
  },
  {
   "segment_id": "s05",
   "text": "بأن السيد ممدوح حميد حسين الفارسي، بحريني الجنسية، ويحمل جواز سفر رقم J6191756، يعمل لديها بوظيفة محاسب منذ 28/09/2026."
  },
  {
   "segment_id": "s06",
   "text": "ونشهد بأنه حسن السيرة والسلوك طوال مدة عمله لدينا."
  },
  {
   "segment_id": "s07",
   "text": "وقد أعطيت هذه الإفادة بناءً على طلبه دون أدنى مسؤولية على الشركة."
  },
  {
   "segment_id": "s08",
   "text": "المديرة العامة: السيدة حنان بنت مبارك الفاسي"
  },
  {
   "segment_id": "s09",
   "text": "General Manager: Hanan bint Mubarak Al Fassi"
  },
  {
   "segment_id": "s10",
   "text": "للاستفسار يرجى التواصل مع إدارة الموارد البشرية على البريد الإلكتروني أدناه."
  },
  {
   "segment_id": "s11",
   "text": "Email: hr@alfarsi.example.com"
  },
  {
   "segment_id": "s12",
   "text": "التاريخ: 26/01/2026"
  }
 ],
