 "segments": [
  {
   "segment_id": "s01",
   "text": "وكالة خاصة"
  },
  {
   "segment_id": "s02",
   "text": "إنه في يوم 03/11/2026 حضر أمام الكاتب العدل الدكتور عبد الرحيم بن محمد الكويتي، كويتي الجنسية، ويحمل جواز سفر رقم A8245262."
  },
  {
   "segment_id": "s03",
   "text": "Principal: Abdul Rahim bin Muhammad Al Kuwaiti, Passport No. A8245262"
  },
  {
   "segment_id": "s04",
   "text": "وذلك بصفته مديرًا لشركة الهاشمي للتجارة العامة ذ.م.م، المرخصة من دائرة التنمية الاقتصادية برقم 256060، وعنوانها أبوظبي، الإمارات العربية المتحدة."
  },
  {
   "segment_id": "s05",
   "text": "Company: Al Hashimi General Trading L.L.C., Registration No. 256060"
  },
  {
   "segment_id": "s06",
   "text": "وقرر أنه وكّل السيد زايد عبد الرحيم الكويتي، كويتي الجنسية، ويحمل بطاقة هوية رقم 37637491."
  },
  {
   "segment_id": "s07",
   "text": "للقيام نيابة عنه بمراجعة الجهات الحكومية والتوقيع على الطلبات والمستندات المتعلقة بالشركة واستلام الشهادات والتراخيص."
  },
  {
   "segment_id": "s08",
   "text": "وهذا التوكيل صالح لمدة سنة واحدة من تاريخه."
  },
  {
   "segment_id": "s09",
   "text": "والموكل كامل الأهلية المعتبرة قانونًا."
  },
  {
   "segment_id": "s10",
   "text": "الموكل: عبد الرحيم الكويتي"
  },
  {
   "segment_id": "s11",
   "text": "الوكيل: زايد الكويتي"
  },
  {
   "segment_id": "s12",
   "text": "التوقيع: ____________"
  }
 ],
