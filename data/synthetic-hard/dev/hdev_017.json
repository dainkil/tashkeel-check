 "segments": [
  {
   "segment_id": "s01",
   "text": "وكالة خاصة"
  },
  {
   "segment_id": "s02",
   "text": "إنه في يوم 14/10/2026 حضر أمام الكاتب العدل السيد صالح ربيع أيوب الجاسر، سعودي الجنسية، ويحمل جواز سفر رقم X8473628."
  },
  {
   "segment_id": "s03",
   "text": "Principal: Saleh Al Jassir, Passport No. X8473628"
  },
  {
   "segment_id": "s04",
   "text": "وذلك بصفته مديرًا لشركة المطيري للتجارة العامة ذ.م.م، المرخصة من دائرة التنمية الاقتصادية برقم 955911، وعنوانها الشارقة، الإمارات العربية المتحدة."
  },
  {
   "segment_id": "s05",
   "text": "Company: Al Mutairi General Trading L.L.C., Registration No. 955911"
  },
  {
   "segment_id": "s06",
   "text": "وقرر أنه وكّل السيدة مها حسن المطيري، عمانية الجنسية، وتحمل بطاقة هوية رقم 29737679."
  },
  {
   "segment_id": "s07",
   "text": "للقيام نيابة عنه بمراجعة الجهات الحكومية والتوقيع على الطلبات والمستندات المتعلقة بالشركة واستلام الشهادات والتراخيص."
  },
  {
   "segment_id": "s08",
   "text": "وهذا التوكيل صالح لمدة سنة واحدة من تاريخه."
  },
  {
   "segment_id": "s09",
   "text": "والموكل كامل الأهلية المعتبرة قانونًا."
  },
  {
   "segment_id": "s10",
   "text": "الموكل: صالح الجاسر"
  },
  {
   "segment_id": "s11",
   "text": "الوكيلة: مها المطيري"
  },
  {
   "segment_id": "s12",
   "text": "التوقيع: ____________"
  }
 ],
