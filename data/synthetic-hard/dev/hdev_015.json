 "segments": [
  {
   "segment_id": "s01",
   "text": "مستخرج من السجل التجاري"
  },
  {
   "segment_id": "s02",
   "text": "الاسم التجاري: الشمري للتجارة العامة ذ.م.م"
  },
  {
   "segment_id": "s03",
   "text": "Trade name: Al Shammari General Trading L.L.C."
  },
  {
   "segment_id": "s04",
   "text": "البريد الإلكتروني: info@alshammari-group.example.net"
  },
  {
   "segment_id": "s05",
   "text": "رقم الرخصة: 447289، جهة الإصدار: دائرة التنمية الاقتصادية، الإمارة: الشارقة"
  },
  {
   "segment_id": "s06",
   "text": "الشكل القانوني: شركة ذات مسؤولية محدودة"
  },
  {
   "segment_id": "s07",
   "text": "الشركاء:"
  },
  {
   "segment_id": "s08",
   "text": "1. المهندس سعيد إبراهيم جمعة الحبسي، قطري الجنسية، الحصة 29٪"
  },
  {
   "segment_id": "s09",
   "text": "Partner 1: Saeed Ibrahim Jumaa Al Habsi"
  },
  {
   "segment_id": "s10",
   "text": "2. الشيخ متعب بن محمد الشمري، قطري الجنسية، الحصة 12٪"
  },
  {
   "segment_id": "s11",
   "text": "3. الشيخ عبد الرحمن عيد الربيعة، إماراتي الجنسية، الحصة 23٪"
  },
  {
   "segment_id": "s12",
   "text": "4. الشيخ سعيد خليفة فايز المخيني، إماراتي الجنسية، الحصة 5٪"
  },
  {
   "segment_id": "s13",
   "text": "Partner 4: Saed Khalifa Fayez Al Mukhaini"
  },
  {
   "segment_id": "s14",
   "text": "5. الشيخ محمد بن عبد اللطيف الشمري، قطري الجنسية، الحصة 8٪"
  },
  {
   "segment_id": "s15",
   "text": "P<QATAL<SHAMMARI<<MOHAMMED<ABDULLATIF<<<<<<<"
  },
  {
   "segment_id": "s16",
   "text": "Passport name: MOHAMED BIN ABDULLATIF AL SHAMERI"
  },
  {
   "segment_id": "s17",
   "text": "6. السيد عبد العزيز بن ماهر بن هاشم العتيبي، عماني الجنسية، الحصة 13٪"
  },
  {
   "segment_id": "s18",
   "text": "P<OMNAL<UTAYBI<<ABDULAZIZ<MAHER<HASHEM<<<<<<"
  },
  {
   "segment_id": "s19",
   "text": "Passport name: AL OTAYBI, Abdulaziz Maher Hashem"
  },
  {
   "segment_id": "s20",
   "text": "7. الشيخ عبد العزيز راشد السبيع، عماني الجنسية، الحصة 7٪"
  },
  {
   "segment_id": "s21",
   "text": "Partner 7: Abdel Aziz Rashid Al Subaie"
  },
  {
   "segment_id": "s22",
   "text": "8. السيدة منال أحمد الغامدي، عمانية الجنسية، الحصة 28٪"
  },
  {
   "segment_id": "s23",
   "text": "9. المهندس عيد بن عبد الله الربيعة، إماراتي الجنسية، الحصة 15٪"
  },
  {
   "segment_id": "s24",
   "text": "Partner 9: Eid bin Abdulla Al Rabiah"
  },
  {
   "segment_id": "s25",
   "text": "المدير: السيد عبد العزيز العتيبي"
  },
  {
   "segment_id": "s26",
   "text": "المفوض بالتوقيع: السيد سعيد الحبسي"
  },
  {
   "segment_id": "s27",
   "text": "تاريخ الإصدار: 27/08/2026"
  },
  {
   "segment_id": "s28",
   "text": "التوقيعات:"
  },
  {
   "segment_id": "s29",
   "text": "MANAL AHMED AL GHAMDI"
  }
 ],
