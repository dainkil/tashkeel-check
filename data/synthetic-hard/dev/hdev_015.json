 "segments": [
  {
   "segment_id": "s01",
   "text": "مستخرج من السجل التجاري"
  },
  {
   "segment_id": "s02",
   "text": "الاسم التجاري: الدخيل للتجارة العامة ذ.م.م"
  },
  {
   "segment_id": "s03",
   "text": "Trade name: Al Dakheel General Trading L.L.C."
  },
  {
   "segment_id": "s04",
   "text": "البريد الإلكتروني: info@aldakheel-group.example.net"
  },
  {
   "segment_id": "s05",
   "text": "رقم الرخصة: 447289، جهة الإصدار: دائرة التنمية الاقتصادية، الإمارة: دبي"
  },
  {
   "segment_id": "s06",
   "text": "الشكل القانوني: شركة ذات مسؤولية محدودة"
  },
  {
   "segment_id": "s07",
   "text": "الشركاء:"
  },
  {
   "segment_id": "s08",
   "text": "1. السيد سالم فهمي الدخيل، سعودي الجنسية، الحصة 40٪"
  },
  {
   "segment_id": "s09",
   "text": "2. السيد محمود سعود حسن الكويتي، كويتي الجنسية، الحصة 34٪"
  },
  {
   "segment_id": "s10",
   "text": "Partner 2: Mahmoud Saud Hassan Al Kuwaiti"
  },
  {
   "segment_id": "s11",
   "text": "3. المهندس فهمي بشار عباس الدخيل، سعودي الجنسية، الحصة 29٪"
  },
  {
   "segment_id": "s12",
   "text": "P<SAUAL<DAKHIL<<FAHMI<BASHAR<ABBAS<<<<<<<<<<"
  },
  {
   "segment_id": "s13",
   "text": "4. المهندس سعيد يعقوب العتيبي، عماني الجنسية، الحصة 12٪"
  },
  {
   "segment_id": "s14",
   "text": "Partner 4: Saeed Yaqoub Al Utaybi"
  },
  {
   "segment_id": "s15",
   "text": "5. السيد محمد بن عبد العزيز بن فرج التميمي، كويتي الجنسية، الحصة 23٪"
  },
  {
   "segment_id": "s16",
   "text": "Partner 5: Mohamed Al Tamimi"
  },
  {
   "segment_id": "s17",
   "text": "6. السيد سعيد فيصل الشيباني، عماني الجنسية، الحصة 5٪"
  },
  {
   "segment_id": "s18",
   "text": "Partner 6: Saed Faisel Al Shaibani"
  },
  {
   "segment_id": "s19",
   "text": "7. المهندس عبد العزيز بن خالد الريامي، إماراتي الجنسية، الحصة 8٪"
  },
  {
   "segment_id": "s20",
   "text": "P<AREAL<RIYAMI<<ABDULAZIZ<KHALID<<<<<<<<<<<<"
  },
  {
   "segment_id": "s21",
   "text": "8. المهندس عبد العزيز طارق المعاضيد، قطري الجنسية، الحصة 13٪"
  },
  {
   "segment_id": "s22",
   "text": "Partner 8: Abdel Aziz Tariq Al Maadeed"
  },
  {
   "segment_id": "s23",
   "text": "9. المهندس إبراهيم بن محمود الكويتي، كويتي الجنسية، الحصة 7٪"
  },
  {
   "segment_id": "s24",
   "text": "المدير: الشريك رقم 6، السيد سعيد الشيباني"
  },
  {
   "segment_id": "s25",
   "text": "المفوض بالتوقيع: الشريك رقم 4، السيد سعيد العتيبي"
  },
  {
   "segment_id": "s26",
   "text": "تاريخ الإصدار: 27/08/2026"
  }
