 "segments": [
  {
   "segment_id": "s01",
   "text": "مستخرج من السجل التجاري"
  },
  {
   "segment_id": "s02",
   "text": "الاسم التجاري: الكتبي للتجارة العامة ذ.م.م"
  },
  {
   "segment_id": "s03",
   "text": "Trade name: Al Ketbi General Trading L.L.C."
  },
  {
   "segment_id": "s04",
   "text": "البريد الإلكتروني: info@alketbi-group.example.net"
  },
  {
   "segment_id": "s05",
   "text": "رقم الرخصة: 575040، جهة الإصدار: دائرة التنمية الاقتصادية، الإمارة: دبي"
  },
  {
   "segment_id": "s06",
   "text": "الشكل القانوني: شركة ذات مسؤولية محدودة"
  },
  {
   "segment_id": "s07",
   "text": "الشركاء:"
  },
  {
   "segment_id": "s08",
   "text": "1. السيد نواف بن حمد الكتبي، عماني الجنسية، الحصة 36٪"
  },
  {
   "segment_id": "s09",
   "text": "2. المهندس فهاد حسين الكويتي، كويتي الجنسية، الحصة 37٪"
  },
  {
   "segment_id": "s10",
   "text": "Partner 2: Fahhad Husain Al Kuwaiti"
  },
  {
   "segment_id": "s11",
   "text": "3. السيد فهيد بن عبد العزيز بن عادل الحرقان، كويتي الجنسية، الحصة 15٪"
  },
  {
   "segment_id": "s12",
   "text": "4. السيد عبده بن عبدالله القاسمي، بحريني الجنسية، الحصة 31٪"
  },
  {
   "segment_id": "s13",
   "text": "Partner 4: Abdo bin Abdullah Al Qasimi"
  },
  {
   "segment_id": "s14",
   "text": "Passport name: AL QASSIMI, Abdo Abdullah"
  },
  {
   "segment_id": "s15",
   "text": "5. الدكتور سعود بن علي الغساني، قطري الجنسية، الحصة 32٪"
  },
  {
   "segment_id": "s16",
   "text": "Partner 5: Saoud bin Ali Al Ghassani"
  },
  {
   "segment_id": "s17",
   "text": "6. السيد عبدو سعد أحمد الصباح، كويتي الجنسية، الحصة 32٪"
  },
  {
   "segment_id": "s18",
   "text": "7. السيد هلال سعود الغساني، قطري الجنسية، الحصة 18٪"
  },
  {
   "segment_id": "s19",
   "text": "8. الشيخ حمد بن عبد الله الكتبي، عماني الجنسية، الحصة 28٪"
  },
  {
   "segment_id": "s20",
   "text": "Partner 8: Hamed bin Abdulla Al Ketbi"
  },
  {
   "segment_id": "s21",
   "text": "Passport name: HAMAD BIN ABDULLA AL KETBI"
  },
  {
   "segment_id": "s22",
   "text": "المدير: السيد فهاد الكويتي"
  },
  {
   "segment_id": "s23",
   "text": "المفوض بالتوقيع: السيد عبده القاسمي"
  },
  {
