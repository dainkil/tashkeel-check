 "segments": [
  {
   "segment_id": "s01",
   "text": "Al Zahrani General Trading L.L.C."
  },
  {
   "segment_id": "s02",
   "text": "Tel: +971 4 4246775 | www.alzahrani-group.example.net"
  },
  {
   "segment_id": "s03",
   "text": "إفادة لمن يهمه الأمر"
  },
  {
   "segment_id": "s04",
   "text": "تشهد شركة الزهراني للتجارة العامة ذ.م.م، المرخصة من دائرة التنمية الاقتصادية برقم 535861، وعنوانها الشارقة، الإمارات العربية المتحدة،"
  },
  {
   "segment_id": "s05",
   "text": "بأن السيد طارق محمد الزهراني، سعودي الجنسية، ويحمل جواز سفر رقم V8078773، يعمل لديها بوظيفة مهندس منذ 19/09/2026."
  },
  {
   "segment_id": "s06",
   "text": "ونشهد بأنه حسن السيرة والسلوك طوال مدة عمله لدينا."
  },
  {
   "segment_id": "s07",
   "text": "وقد أعطيت هذه الإفادة بناءً على طلبه دون أدنى مسؤولية على الشركة."
  },
  {
   "segment_id": "s08",
   "text": "المدير العام: السيد محمد حمد مازن الزهراني"
  },
  {
   "segment_id": "s09",
   "text": "General Manager: Mohammed Hamad Mazen Al Zahrani"
  },
  {
   "segment_id": "s10",
   "text": "للاستفسار يرجى التواصل مع إدارة الموارد البشرية على البريد الإلكتروني أدناه."
  },
  {
   "segment_id": "s11",
   "text": "Email: hr@alzahrani.example.com"
  },
  {
   "segment_id": "s12",
   "text": "التاريخ: 12/05/2026"
  }
 ],
