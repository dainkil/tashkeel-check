 "bilingual": true,
 "segments": [
  {
   "segment_id": "s01",
   "text": "محضر اجتماع الجمعية العمومية العادية"
  },
  {
   "segment_id": "s02",
   "text": "لشركة الحمادي للتجارة العامة ذ.م.م"
  },
  {
   "segment_id": "s03",
   "text": "Company: Al Hammadi General Trading L.L.C."
  },
  {
   "segment_id": "s04",
   "text": "عقد الاجتماع في أبوظبي بتاريخ 14/06/2026 برئاسة السيد حسان بن إبراهيما الحمادي."
  },
  {
   "segment_id": "s05",
   "text": "وحضر الاجتماع كل من:"
  },
  {
   "segment_id": "s06",
   "text": "1. السيد حسن خالد الحارثي"
  },
  {
   "segment_id": "s07",
   "text": "Attendee 1: Hasan Khaled El-Harthi"
  },
  {
   "segment_id": "s08",
   "text": "2. الشيخة عهد بنت طارق الحبسي"
  },
  {
   "segment_id": "s09",
   "text": "3. السيدة مها محمد عادل الصباح"
  },
  {
   "segment_id": "s10",
   "text": "4. الشيخة منى بنت بخيت بن ناصر العبيدي"
  },
  {
   "segment_id": "s11",
   "text": "5. السيد جميل بن أحمد العساكر"
  },
  {
   "segment_id": "s12",
   "text": "Attendee 5: Jamil Al Asaker"
  },
  {
   "segment_id": "s13",
   "text": "6. الدكتور عيسى عبد الرحمن خلف العبسي"
  },
  {
   "segment_id": "s14",
   "text": "Attendee 6: Eisa Abdulrahman Khalaf Al Absi"
  },
  {
   "segment_id": "s15",
   "text": "وتولى أمانة السر الشيخة آمنة عبد الله الزبيدي."
  },
  {
   "segment_id": "s16",
   "text": "Secretary: Amna Abdullah El Zubaidi"
  },
  {
   "segment_id": "s17",
   "text": "وبعد التداول قرر المجتمعون بالإجماع ما يلي:"
  },
  {
   "segment_id": "s18",
   "text": "أولًا: الموافقة على تعيين السيد حسن الحارثي مديرًا للشركة لمدة ثلاث سنوات."
  },
  {
   "segment_id": "s19",
   "text": "ثانيًا: توزيع الأرباح بشكل عادل بين الشركاء حسب حصصهم."
  },
  {
   "segment_id": "s20",
   "text": "ثالثًا: المركز المالي للشركة سليم ولا توجد عليها التزامات متأخرة."
  },
  {
   "segment_id": "s21",
   "text": "رابعًا: تفويض السيدة منى العبيدي بالتوقيع على محضر الاجتماع وتقديمه للجهات المختصة."
  },
  {
   "segment_id": "s22",
   "text": "رئيس الاجتماع: حسان الحمادي"
  },
  {
   "segment_id": "s23",
   "text": "أمين السر: آمنة الزبيدي"
  },
  {
   "segment_id": "s24",
   "text": "التوقيعات:"
  },
  {
   "segment_id": "s25",
   "text": "Maha Mohammed Adel Al Sabah"
  }
 ],
