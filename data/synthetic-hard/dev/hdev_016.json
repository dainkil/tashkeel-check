 "bilingual": true,
 "segments": [
  {
   "segment_id": "s01",
   "text": "محضر اجتماع الجمعية العمومية العادية"
  },
  {
   "segment_id": "s02",
   "text": "لشركة الحمادي للتجارة العامة ذ.م.م"
  },
  {
   "segment_id": "s03",
   "text": "Company: Al Hammadi General Trading L.L.C."
  },
  {
   "segment_id": "s04",
   "text": "عقد الاجتماع في أبوظبي بتاريخ 14/06/2026 برئاسة المهندسة نورة حامد الحمادي."
  },
  {
   "segment_id": "s05",
   "text": "وحضر الاجتماع كل من:"
  },
  {
   "segment_id": "s06",
   "text": "1. الشيخ عادل بن طارق المطلق"
  },
  {
   "segment_id": "s07",
   "text": "Attendee 1: Adel bin Tarek El-Mutlaq"
  },
  {
   "segment_id": "s08",
   "text": "2. السيد سليم بن علي الراشد"
  },
  {
   "segment_id": "s09",
   "text": "Attendee 2: Sulayem Al Rashed"
  },
  {
   "segment_id": "s10",
   "text": "3. المهندس غانم بن عادل المطلق"
  },
  {
   "segment_id": "s11",
   "text": "4. السيد سعد أحمد خالد السبيع"
  },
  {
   "segment_id": "s12",
   "text": "Attendee 4: Saad Ahmad Khalid El-Subaie"
  },
  {
   "segment_id": "s13",
   "text": "5. الشيخ عبد الرحمن سعد السبيع"
  },
  {
   "segment_id": "s14",
   "text": "6. السيدة سمر بنت بدر بن عبده الحمادي"
  },
  {
   "segment_id": "s15",
   "text": "وتولى أمانة السر السيد أمين حسين محمد القحطاني."
  },
  {
   "segment_id": "s16",
   "text": "Secretary: Amin Al Qahtani"
  },
  {
   "segment_id": "s17",
   "text": "وبعد التداول قرر المجتمعون بالإجماع ما يلي:"
  },
  {
   "segment_id": "s18",
   "text": "أولًا: الموافقة على تعيين السيد عبد الرحمن السبيع مديرًا للشركة لمدة ثلاث سنوات."
  },
  {
   "segment_id": "s19",
   "text": "ثانيًا: توزيع الأرباح بشكل عادل بين الشركاء حسب حصصهم."
  },
  {
   "segment_id": "s20",
   "text": "ثالثًا: المركز المالي للشركة سليم ولا توجد عليها التزامات متأخرة."
  },
  {
   "segment_id": "s21",
   "text": "رابعًا: تفويض السيد سعد السبيع بالتوقيع على محضر الاجتماع وتقديمه للجهات المختصة."
  },
  {
   "segment_id": "s22",
   "text": "رئيس الاجتماع: المهندسة نورة"
  },
  {
   "segment_id": "s23",
   "text": "أمين السر: أمين القحطاني"
  }
 ],
