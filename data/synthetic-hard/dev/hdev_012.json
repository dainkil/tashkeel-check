 "notice": "SYNTHETIC: 합성 데이터. 실존 인물·회사·서류가 아니다. 이름은 Wikidata 이름 단위를 무작위로 조합했다.",
 "doc_type": "minutes",
 "bilingual": true,
 "segments": [
  {
   "segment_id": "s01",
   "text": "محضر اجتماع الجمعية العمومية العادية"
  },
  {
   "segment_id": "s02",
   "text": "لشركة الزيودي للتجارة العامة ذ.م.م"
  },
  {
   "segment_id": "s03",
   "text": "Company: Al Zeyoudi General Trading L.L.C."
  },
  {
   "segment_id": "s04",
   "text": "عقد الاجتماع في الشارقة بتاريخ 01/04/2026 برئاسة الدكتور سليمان بن هلال الزيودي."
  },
  {
   "segment_id": "s05",
   "text": "وحضر الاجتماع كل من:"
  },
  {
   "segment_id": "s06",
   "text": "1. المهندس عادل سليم المرشدي"
  },
  {
   "segment_id": "s07",
   "text": "2. السيد سليم سلطان حسين المرشدي"
  },
  {
   "segment_id": "s08",
   "text": "Attendee 2: Sulayem Sultan Husayn Al Marshedi"
  },
  {
   "segment_id": "s09",
   "text": "3. السيد جمعة ناصر محمود الشمراني"
  },
  {
   "segment_id": "s10",
   "text": "Attendee 3: Juma Al Shamrani"
  },
  {
   "segment_id": "s11",
   "text": "4. الشيخ عبده حمد الكعبي"
  },
  {
   "segment_id": "s12",
   "text": "Attendee 4: Abdo Hamad Al Kaabi"
  },
  {
   "segment_id": "s13",
   "text": "5. السيد عبدو عبد الرحمن أحمد الظفيري"
  },
  {
   "segment_id": "s14",
   "text": "6. السيد هلال عوض خالد الزيودي"
  },
  {
   "segment_id": "s15",
   "text": "Attendee 6: Helal Awadh Khaled Al Zeyoudi"
  },
  {
   "segment_id": "s16",
   "text": "وتولى أمانة السر الشيخ أمين بن أنس الموسوي."
  },
  {
   "segment_id": "s17",
   "text": "Secretary: A. A. Al Mosawi"
  },
  {
   "segment_id": "s18",
   "text": "وبعد التداول قرر المجتمعون بالإجماع ما يلي:"
  },
  {
   "segment_id": "s19",
   "text": "أولًا: الموافقة على تعيين السيد عبدو الظفيري مديرًا للشركة لمدة ثلاث سنوات."
  },
  {
   "segment_id": "s20",
   "text": "ثانيًا: توزيع الأرباح بشكل عادل بين الشركاء حسب حصصهم."
  },
  {
   "segment_id": "s21",
   "text": "ثالثًا: المركز المالي للشركة سليم ولا توجد عليها التزامات متأخرة."
  },
  {
   "segment_id": "s22",
   "text": "رابعًا: تفويض السيد جمعة الشمراني بالتوقيع على محضر الاجتماع وتقديمه للجهات المختصة."
  },
  {
   "segment_id": "s23",
   "text": "رئيس الاجتماع: الدكتور سليمان"
  },
  {
   "segment_id": "s24",
   "text": "أمين السر: أمين الموسوي"
  }
 ],
