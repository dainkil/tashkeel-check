 "bilingual": true,
 "segments": [
  {
   "segment_id": "s01",
   "text": "محضر اجتماع الجمعية العمومية العادية"
  },
  {
   "segment_id": "s02",
   "text": "لشركة البلوشي للتجارة العامة ذ.م.م"
  },
  {
   "segment_id": "s03",
   "text": "Company: Al Balushi General Trading L.L.C."
  },
  {
   "segment_id": "s04",
   "text": "عقد الاجتماع في الشارقة بتاريخ 01/04/2026 برئاسة المهندس سلطان بن وليد الكويتي."
  },
  {
   "segment_id": "s05",
   "text": "Chairman: Sultan bin Waleed Al Kuwaiti"
  },
  {
   "segment_id": "s06",
   "text": "وحضر الاجتماع كل من:"
  },
  {
   "segment_id": "s07",
   "text": "1. المهندس عادل سعيد خالد المرزوقي"
  },
  {
   "segment_id": "s08",
   "text": "Attendee 1: A. S. Al Marzouqi"
  },
  {
   "segment_id": "s09",
   "text": "2. الدكتور سليم سلطان الكويتي"
  },
  {
   "segment_id": "s10",
   "text": "3. السيد يوسف بن حمد بن أحمد البدواوي"
  },
  {
   "segment_id": "s11",
   "text": "Attendee 3: Yousef bin Hamed bin Ahmed Al Badwawi"
  },
  {
   "segment_id": "s12",
   "text": "4. الشيخ عبد الله منذر عبد الناصر البلوشي"
  },
  {
   "segment_id": "s13",
   "text": "5. السيدة العنود عبد العزيز البلوشي"
  },
  {
   "segment_id": "s14",
   "text": "6. السيد محمد يوسف البدواوي"
  },
  {
   "segment_id": "s15",
   "text": "وتولى أمانة السر السيد أمين إسماعيل أشرف الموسوي."
  },
  {
   "segment_id": "s16",
   "text": "Secretary: A. I. Al Musawi"
  },
  {
   "segment_id": "s17",
   "text": "وبعد التداول قرر المجتمعون بالإجماع ما يلي:"
  },
  {
   "segment_id": "s18",
   "text": "أولًا: الموافقة على تعيين السيد محمد البدواوي مديرًا للشركة لمدة ثلاث سنوات."
  },
  {
   "segment_id": "s19",
   "text": "ثانيًا: توزيع الأرباح بشكل عادل بين الشركاء حسب حصصهم."
  },
  {
   "segment_id": "s20",
   "text": "ثالثًا: المركز المالي للشركة سليم ولا توجد عليها التزامات متأخرة."
  },
  {
   "segment_id": "s21",
   "text": "رابعًا: تفويض السيد يوسف البدواوي بالتوقيع على محضر الاجتماع وتقديمه للجهات المختصة."
  },
  {
   "segment_id": "s22",
   "text": "رئيس الاجتماع: المهندس سلطان"
  },
  {
   "segment_id": "s23",
   "text": "أمين السر: أمين الموسوي"
  }
 ],
