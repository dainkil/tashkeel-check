 "synthetic": true,
 "notice": "SYNTHETIC: 합성 데이터. 실존 인물·회사·서류가 아니다. 이름은 Wikidata 이름 단위를 무작위로 조합했다.",
 "doc_type": "minutes",
 "bilingual": true,
 "segments": [
  {
   "segment_id": "s01",
   "text": "محضر اجتماع الجمعية العمومية العادية"
  },
  {
   "segment_id": "s02",
   "text": "لشركة البلوشي للتجارة العامة ذ.م.م"
  },
  {
   "segment_id": "s03",
   "text": "Company: Al Balushi General Trading L.L.C."
  },
  {
   "segment_id": "s04",
   "text": "عقد الاجتماع في دبي بتاريخ 11/01/2026 برئاسة السيد رشيد جراح عبد الرحمن الشمري."
  },
  {
   "segment_id": "s05",
   "text": "Chairman: Rashed Jarrah Abdulrahman Al Shammari"
  },
  {
   "segment_id": "s06",
   "text": "وحضر الاجتماع كل من:"
  },
  {
   "segment_id": "s07",
   "text": "1. الشيخ عادل بن عبد الكريم بن نبيل النعيمي"
  },
  {
   "segment_id": "s08",
   "text": "Attendee 1: A. A. Al Noaimi"
  },
  {
   "segment_id": "s09",
   "text": "2. المهندس سليم بن محمد المنصوري"
  },
  {
   "segment_id": "s10",
   "text": "Attendee 2: Sulayem bin Mohammed Al Mansoori"
  },
  {
   "segment_id": "s11",
   "text": "Surname: AL MANSOURI / Given names: SULAYEM MOHAMMED"
  },
  {
   "segment_id": "s12",
   "text": "3. المهندس درويش حمد عبد الله القطري"
  },
  {
   "segment_id": "s13",
   "text": "Attendee 3: D. H. Al Qatari"
  },
  {
   "segment_id": "s14",
   "text": "4. السيد محمود بن سليم المنصوري"
  },
  {
   "segment_id": "s15",
   "text": "5. المهندس رشاد رضا الخميس"
  },
  {
   "segment_id": "s16",
   "text": "6. الشيخ علي بن طارق بن عبد العزيز البلوشي"
  },
  {
   "segment_id": "s17",
   "text": "Attendee 6: Ali bin Tariq bin Abdulaziz Al Balushi"
  },
  {
   "segment_id": "s18",
   "text": "Passport name: ALI BIN TARIQ BIN ABDULAZIZ AL BALOOSHI"
  },
  {
   "segment_id": "s19",
   "text": "وتولى أمانة السر الشيخ أحمد بن علي البلوشي."
  },
  {
   "segment_id": "s20",
   "text": "وبعد التداول قرر المجتمعون بالإجماع ما يلي:"
  },
  {
   "segment_id": "s21",
   "text": "أولًا: الموافقة على تعيين السيد علي البلوشي مديرًا للشركة لمدة ثلاث سنوات."
  },
  {
   "segment_id": "s22",
   "text": "ثانيًا: توزيع الأرباح بشكل عادل بين الشركاء حسب حصصهم."
  },
  {
   "segment_id": "s23",
   "text": "ثالثًا: المركز المالي للشركة سليم ولا توجد عليها التزامات متأخرة."
  },
  {
   "segment_id": "s24",
   "text": "رابعًا: تفويض السيد درويش القطري بالتوقيع على محضر الاجتماع وتقديمه للجهات المختصة."
  },
  {
   "segment_id": "s25",
   "text": "رئيس الاجتماع: رشيد الشمري"
  },
  {
   "segment_id": "s26",
   "text": "أمين السر: أحمد البلوشي"
  }
 ],
