 "segments": [
  {
   "segment_id": "s01",
   "text": "مستخرج من السجل التجاري"
  },
  {
   "segment_id": "s02",
   "text": "الاسم التجاري: المنصوري للتجارة العامة ذ.م.م"
  },
  {
   "segment_id": "s03",
   "text": "Trade name: Al Mansoori General Trading L.L.C."
  },
  {
   "segment_id": "s04",
   "text": "البريد الإلكتروني: info@almansoori-group.example.net"
  },
  {
   "segment_id": "s05",
   "text": "رقم الرخصة: 115086، جهة الإصدار: دائرة التنمية الاقتصادية، الإمارة: الشارقة"
  },
  {
   "segment_id": "s06",
   "text": "الشكل القانوني: شركة ذات مسؤولية محدودة"
  },
  {
   "segment_id": "s07",
   "text": "الشركاء:"
  },
  {
   "segment_id": "s08",
   "text": "1. الدكتورة أسرار حامد علي المنصوري، بحرينية الجنسية، الحصة 31٪"
  },
  {
   "segment_id": "s09",
   "text": "2. السيد سالم بن مبارك بن ناجي المطروشي، كويتي الجنسية، الحصة 26٪"
  },
  {
   "segment_id": "s10",
   "text": "Partner 2: Salim bin Mobarak bin Naji Al Matrooshi"
  },
  {
   "segment_id": "s11",
   "text": "3. السيد فرج بن خالد الذوادي، إماراتي الجنسية، الحصة 26٪"
  },
  {
   "segment_id": "s12",
   "text": "Partner 3: Faraj Al Thawadi"
  },
  {
   "segment_id": "s13",
   "text": "4. السيد منذر سلطان سليمان القاسمي، عماني الجنسية، الحصة 16٪"
  },
  {
   "segment_id": "s14",
   "text": "5. السيد حسن يوسف أحمد الجهني، سعودي الجنسية، الحصة 33٪"
  },
  {
   "segment_id": "s15",
   "text": "Partner 5: Hassan Yousef Ahmed Al Johani"
  },
  {
   "segment_id": "s16",
   "text": "6. المهندس حسن بن عادل القطري، قطري الجنسية، الحصة 31٪"
  },
  {
   "segment_id": "s17",
   "text": "P<QATEL<QATARI<<HASAN<ADEL<<<<<<<<<<<<<<<<<<"
  },
  {
   "segment_id": "s18",
   "text": "7. السيد سالم سعود راشد السويدي، سعودي الجنسية، الحصة 10٪"
  },
  {
   "segment_id": "s19",
   "text": "Partner 7: Salem Saud Rashid Al Sowaidi"
  },
  {
   "segment_id": "s20",
   "text": "8. السيد زايد بن شهاب بن محمد المنصور، بحريني الجنسية، الحصة 11٪"
  },
  {
   "segment_id": "s21",
   "text": "Partner 8: Zayed bin Shihab bin Mohammed Al Mansour"
  },
  {
   "segment_id": "s22",
   "text": "9. السيد منير بن صالح بن عيسى النمر، سعودي الجنسية، الحصة 16٪"
  },
  {
   "segment_id": "s23",
   "text": "P<SAUEL<NEMER<<MUNEER<SALEH<ESSA<<<<<<<<<<<<"
  },
  {
   "segment_id": "s24",
   "text": "المدير: الشريك رقم 7، السيد سالم السويدي"
  },
  {
   "segment_id": "s25",
   "text": "المفوض بالتوقيع: الشريك رقم 5، السيد حسن الجهني"
  },
  {
   "segment_id": "s26",
   "text": "تاريخ الإصدار: 28/01/2026"
  }
