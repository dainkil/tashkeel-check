 "segments": [
  {
   "segment_id": "s01",
   "text": "مستخرج من السجل التجاري"
  },
  {
   "segment_id": "s02",
   "text": "الاسم التجاري: المنصوري للتجارة العامة ذ.م.م"
  },
  {
   "segment_id": "s03",
   "text": "Trade name: Al Mansoori General Trading L.L.C."
  },
  {
   "segment_id": "s04",
   "text": "البريد الإلكتروني: info@almansoori-group.example.com"
  },
  {
   "segment_id": "s05",
   "text": "رقم الرخصة: 115086، جهة الإصدار: دائرة التنمية الاقتصادية، الإمارة: دبي"
  },
  {
   "segment_id": "s06",
   "text": "الشكل القانوني: شركة ذات مسؤولية محدودة"
  },
  {
   "segment_id": "s07",
   "text": "الشركاء:"
  },
  {
   "segment_id": "s08",
   "text": "1. السيد منير بن خليفة العطاوي، سعودي الجنسية، الحصة 31٪"
  },
  {
   "segment_id": "s09",
   "text": "Partner 1: Muneer bin Khalifa Al Attawi"
  },
  {
   "segment_id": "s10",
   "text": "2. المهندس هادي ماهر ماجد المنصور، قطري الجنسية، الحصة 30٪"
  },
  {
   "segment_id": "s11",
   "text": "Partner 2: Hadi Mahir Majid Al Mansour"
  },
  {
   "segment_id": "s12",
   "text": "3. المهندس حسن بن مبارك بن عبد الله القرعاوي، قطري الجنسية، الحصة 31٪"
  },
  {
   "segment_id": "s13",
   "text": "Partner 3: Hassan bin Mubarak bin Abdullah Al Gar'awi"
  },
  {
   "segment_id": "s14",
   "text": "4. السيدة ريم بنت أحمد بن سعيد الموسى، سعودية الجنسية، الحصة 26٪"
  },
  {
   "segment_id": "s15",
   "text": "5. الشيخ حسن بن فريد اليافعي، بحريني الجنسية، الحصة 26٪"
  },
  {
   "segment_id": "s16",
   "text": "Partner 5: Hasan bin Farid El Yafi"
  },
  {
   "segment_id": "s17",
   "text": "6. الشيخ سالم قيس رياض الجاسم، عماني الجنسية، الحصة 16٪"
  },
  {
   "segment_id": "s18",
   "text": "P<OMNEL<JASSIM<<SALEM<QAIS<RIYADH<<<<<<<<<<<"
  },
  {
   "segment_id": "s19",
   "text": "7. المهندس سالم بن حارب العجمي، عماني الجنسية، الحصة 33٪"
  },
  {
   "segment_id": "s20",
   "text": "P<OMNEL<AJMI<<SALIM<HAREB<<<<<<<<<<<<<<<<<<<"
  },
  {
   "segment_id": "s21",
   "text": "8. الشيخة أروى حمزة المنصوري، سعودية الجنسية، الحصة 31٪"
  },
  {
   "segment_id": "s22",
   "text": "9. الدكتور منذر سامي عباس الكويتي، كويتي الجنسية، الحصة 10٪"
  },
  {
   "segment_id": "s23",
   "text": "المدير: السيد حسن اليافعي"
  },
  {
   "segment_id": "s24",
   "text": "المفوض بالتوقيع: السيد سالم العجمي"
  },
  {
   "segment_id": "s25",
   "text": "تاريخ الإصدار: 28/01/2026"
  },
  {
   "segment_id": "s26",
   "text": "التوقيعات:"
  },
  {
   "segment_id": "s27",
   "text": "REEM BINT AHMED BIN SAEED AL MOUSA"
  }
