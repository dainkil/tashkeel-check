 "segments": [
  {
   "segment_id": "s01",
   "text": "وكالة خاصة"
  },
  {
   "segment_id": "s02",
   "text": "إنه في يوم 22/12/2026 حضر أمام الكاتب العدل السيد خالد سلمان العجمي، سعودي الجنسية، ويحمل جواز سفر رقم F2311402."
  },
  {
   "segment_id": "s03",
   "text": "Principal: Khaled Salman Al Ajmi, Passport No. F2311402"
  },
  {
   "segment_id": "s04",
   "text": "وذلك بصفته مديرًا لشركة العجمي للتجارة العامة ذ.م.م، المرخصة من دائرة التنمية الاقتصادية برقم 875548، وعنوانها دبي، الإمارات العربية المتحدة."
  },
  {
   "segment_id": "s05",
   "text": "Company: Al Ajmi General Trading L.L.C., Registration No. 875548"
  },
  {
   "segment_id": "s06",
   "text": "وقرر أنه وكّل السيد محمد خالد العجمي، سعودي الجنسية، ويحمل بطاقة هوية رقم 88074105."
  },
  {
   "segment_id": "s07",
   "text": "للقيام نيابة عنه بمراجعة الجهات الحكومية والتوقيع على الطلبات والمستندات المتعلقة بالشركة واستلام الشهادات والتراخيص."
  },
  {
   "segment_id": "s08",
   "text": "وهذا التوكيل صالح لمدة سنة واحدة من تاريخه."
  },
  {
   "segment_id": "s09",
   "text": "والموكل كامل الأهلية المعتبرة قانونًا."
  },
  {
   "segment_id": "s10",
   "text": "الموكل: خالد العجمي"
  },
  {
   "segment_id": "s11",
   "text": "الوكيل: محمد العجمي"
  },
  {
   "segment_id": "s12",
   "text": "التوقيع: ____________"
  }
 ],
