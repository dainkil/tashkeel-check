{
 "doc_id": "hdev_004",
 "synthetic": true,
 "notice": "SYNTHETIC: 합성 데이터. 실존 인물·회사·서류가 아니다. 이름은 Wikidata 이름 단위를 무작위로 조합했다.",
 "doc_type": "minutes",
 "bilingual": true,
 "segments": [
  {
   "segment_id": "s01",
   "text": "محضر اجتماع الجمعية العمومية العادية"
  },
  {
   "segment_id": "s02",
   "text": "لشركة الشماسي للتجارة العامة ذ.م.م"
  },
  {
   "segment_id": "s03",
   "text": "Company: Al Shammasi General Trading L.L.C."
  },
  {
   "segment_id": "s04",
   "text": "عقد الاجتماع في دبي بتاريخ 23/04/2026 برئاسة الشيخ موسى بن عبد الرحمن المسقطي."
  },
  {
   "segment_id": "s05",
   "text": "Chairman: MOUSSA BIN ABDURAHMAN EL-MASKATI"
  },
  {
   "segment_id": "s06",
   "text": "Surname: EL-MASKATI / Given names: MOUSSA ABDURAHMAN"
  },
  {
   "segment_id": "s07",
   "text": "وحضر الاجتماع كل من:"
  },
  {
   "segment_id": "s08",
   "text": "1. الشيخ عادل منصور سعود الحبشي"
  },
  {
   "segment_id": "s09",
   "text": "2. المهندس سليم علي مساعد آل سعود"
  },
  {
   "segment_id": "s10",
   "text": "Attendee 2: Sulayem Ali Musaed Al Saud"
  },
  {
   "segment_id": "s11",
   "text": "3. السيدة دينا طارق الحبسي"
  },
  {
   "segment_id": "s12",
   "text": "4. المهندس موسى عزيز فهد آل نهيان"
  },
  {
   "segment_id": "s13",
   "text": "Attendee 4: MUSA AZIZ FAHAD EL-NAHYAN"
  },
  {
   "segment_id": "s14",
   "text": "Attendee 4: EL-NAHYAN, Musa Aziz Fahad"
  },
  {
   "segment_id": "s15",
   "text": "5. السيدة سعاد عبد الله محمد المسماري"
  },
  {
   "segment_id": "s16",
   "text": "وتولى أمانة السر السيد أمين مشاري ثامر الملا."
  },
  {
   "segment_id": "s17",
   "text": "وبعد التداول قرر المجتمعون بالإجماع ما يلي:"
  },
  {
   "segment_id": "s18",
   "text": "أولًا: الموافقة على تعيين السيد موسى آل نهيان مديرًا للشركة لمدة ثلاث سنوات."
  },
  {
   "segment_id": "s19",
   "text": "ثانيًا: توزيع الأرباح بشكل عادل بين الشركاء حسب حصصهم."
  },
  {
   "segment_id": "s20",
   "text": "ثالثًا: المركز المالي للشركة سليم ولا توجد عليها التزامات متأخرة."
  },
  {
   "segment_id": "s21",
   "text": "رابعًا: تفويض السيد عادل الحبشي بالتوقيع على محضر الاجتماع وتقديمه للجهات المختصة."
  },
  {
   "segment_id": "s22",
   "text": "رئيس الاجتماع: موسى المسقطي"
  },
  {
   "segment_id": "s23",
   "text": "أمين السر: أمين الملا"
  },
  {
   "segment_id": "s24",
   "text": "التوقيعات:"
  },
  {
   "segment_id": "s25",
   "text": "DINA TARIQ AL HABSI"
  },
  {
   "segment_id": "s26",
   "text": "SOAD ABDULLA MOHAMMED AL MESMARI"
  }
 ],
