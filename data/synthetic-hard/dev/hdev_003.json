 "segments": [
  {
   "segment_id": "s01",
   "text": "مستخرج من السجل التجاري"
  },
  {
   "segment_id": "s02",
   "text": "الاسم التجاري: النجعي للتجارة العامة ذ.م.م"
  },
  {
   "segment_id": "s03",
   "text": "رقم الرخصة: 287909، جهة الإصدار: دائرة التنمية الاقتصادية، الإمارة: الشارقة"
  },
  {
   "segment_id": "s04",
   "text": "الشكل القانوني: شركة ذات مسؤولية محدودة"
  },
  {
   "segment_id": "s05",
   "text": "الشركاء:"
  },
  {
   "segment_id": "s06",
   "text": "1. الشيخة أسيل عبد الله القطري، قطرية الجنسية، الحصة 37٪"
  },
  {
   "segment_id": "s07",
   "text": "2. السيد يوسف بن طاهر المهيري، كويتي الجنسية، الحصة 12٪"
  },
  {
   "segment_id": "s08",
   "text": "3. السيد غالب بن زايد بن فوزي العوضي، سعودي الجنسية، الحصة 34٪"
  },
  {
   "segment_id": "s09",
   "text": "Partner 3: GHALEB BIN ZAYED BIN FOUZI EL-AWADI"
  },
  {
   "segment_id": "s10",
   "text": "Passport name: GHALEB BIN ZAYED BIN FOUZI AL AWADI"
  },
  {
   "segment_id": "s11",
   "text": "4. المهندس أحمد ناصر عبد العزيز الكبيسي، إماراتي الجنسية، الحصة 40٪"
  },
  {
   "segment_id": "s12",
   "text": "Partner 4: Ahmed Nasser Abdel Aziz Al Kubaisi"
  },
  {
   "segment_id": "s13",
   "text": "5. السيد نواف بن حسن القبيسي، إماراتي الجنسية، الحصة 15٪"
  },
  {
   "segment_id": "s14",
   "text": "6. السيد سامي بن سعود القبيسي، سعودي الجنسية، الحصة 40٪"
  },
  {
   "segment_id": "s15",
   "text": "7. السيد إبراهيم بن غالب العوضي، سعودي الجنسية، الحصة 31٪"
  },
  {
   "segment_id": "s16",
   "text": "8. المهندس طاهر نبيل محمد المهيري، كويتي الجنسية، الحصة 36٪"
  },
  {
   "segment_id": "s17",
   "text": "Partner 8: TAHER NABIL MUHAMMAD EL-MEHAIRI"
  },
  {
   "segment_id": "s18",
   "text": "Surname: AL MUHAIRI / Given names: TAHIR NABIL MUHAMMAD"
  },
  {
   "segment_id": "s19",
   "text": "9. السيدة فرح وليد سلطان الكبيسي، سعودية الجنسية، الحصة 35٪"
  },
  {
   "segment_id": "s20",
   "text": "Partner 9: Farah Walid Sultan Al Kubaisi"
  },
  {
   "segment_id": "s21",
   "text": "المدير: الشريك رقم 6، السيد سامي القبيسي"
  },
  {
   "segment_id": "s22",
   "text": "المفوض بالتوقيع: الشريك رقم 7، السيد إبراهيم العوضي"
  },
  {
   "segment_id": "s23",
   "text": "تاريخ الإصدار: 07/12/2026"
  },
  {
   "segment_id": "s24",
   "text": "التوقيعات:"
