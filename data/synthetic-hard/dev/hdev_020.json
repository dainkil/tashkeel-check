 "bilingual": true,
 "segments": [
  {
   "segment_id": "s01",
   "text": "محضر اجتماع الجمعية العمومية العادية"
  },
  {
   "segment_id": "s02",
   "text": "لشركة الظفيري للتجارة العامة ذ.م.م"
  },
  {
   "segment_id": "s03",
   "text": "عقد الاجتماع في دبي بتاريخ 19/05/2026 برئاسة الشيخ فهد سعود العوضي."
  },
  {
   "segment_id": "s04",
   "text": "Surname: AL AWADHI / Given names: AL FAHAD SAUD"
  },
  {
   "segment_id": "s05",
   "text": "وحضر الاجتماع كل من:"
  },
  {
   "segment_id": "s06",
   "text": "1. الشيخ عادل أحمد المال"
  },
  {
   "segment_id": "s07",
   "text": "Attendee 1: Adel Al Mal"
  },
  {
   "segment_id": "s08",
   "text": "2. الدكتور سليم بن عبد الله بن عبدو الغانم"
  },
  {
   "segment_id": "s09",
   "text": "Attendee 2: S. A. Al Ghanim"
  },
  {
   "segment_id": "s10",
   "text": "3. الشيخة تهاني كمال الحمادي"
  },
  {
   "segment_id": "s11",
   "text": "4. الشيخ فهد محمد الأربش"
  },
  {
   "segment_id": "s12",
   "text": "Surname: AL ARBASH / Given names: FAHAD MOHAMED"
  },
  {
   "segment_id": "s13",
   "text": "وتولى أمانة السر السيد أمين علي العتيبي."
  },
  {
   "segment_id": "s14",
   "text": "Secretary: A. A. Al Otaybi"
  },
  {
   "segment_id": "s15",
   "text": "وبعد التداول قرر المجتمعون بالإجماع ما يلي:"
  },
  {
   "segment_id": "s16",
   "text": "أولًا: الموافقة على تعيين السيد عادل المال مديرًا للشركة لمدة ثلاث سنوات."
  },
  {
   "segment_id": "s17",
   "text": "ثانيًا: توزيع الأرباح بشكل عادل بين الشركاء حسب حصصهم."
  },
  {
   "segment_id": "s18",
   "text": "ثالثًا: المركز المالي للشركة سليم ولا توجد عليها التزامات متأخرة."
  },
  {
   "segment_id": "s19",
   "text": "رابعًا: تفويض السيدة تهاني الحمادي بالتوقيع على محضر الاجتماع وتقديمه للجهات المختصة."
  },
  {
   "segment_id": "s20",
   "text": "رئيس الاجتماع: فهد العوضي"
  },
  {
   "segment_id": "s21",
   "text": "أمين السر: أمين العتيبي"
  },
  {
   "segment_id": "s22",
   "text": "التوقيعات:"
  },
  {
   "segment_id": "s23",
   "text": "Tahani Kamal Al Hammadi"
  }
 ],
