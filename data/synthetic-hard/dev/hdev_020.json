 "notice": "SYNTHETIC: 합성 데이터. 실존 인물·회사·서류가 아니다. 이름은 Wikidata 이름 단위를 무작위로 조합했다.",
 "doc_type": "minutes",
 "bilingual": true,
 "segments": [
  {
   "segment_id": "s01",
   "text": "محضر اجتماع الجمعية العمومية العادية"
  },
  {
   "segment_id": "s02",
   "text": "لشركة الملا للتجارة العامة ذ.م.م"
  },
  {
   "segment_id": "s03",
   "text": "Company: Al Mulla General Trading L.L.C."
  },
  {
   "segment_id": "s04",
   "text": "عقد الاجتماع في دبي بتاريخ 19/05/2026 برئاسة السيد سعد خالد السعدي."
  },
  {
   "segment_id": "s05",
   "text": "وحضر الاجتماع كل من:"
  },
  {
   "segment_id": "s06",
   "text": "1. السيد عادل بن محمد بن حامد الراجح"
  },
  {
   "segment_id": "s07",
   "text": "Attendee 1: Adel bin Mohamed bin Hamid Al Rajeh"
  },
  {
   "segment_id": "s08",
   "text": "Passport name: ADEL BIN MOHAMED BIN HAMID AL RAJIH"
  },
  {
   "segment_id": "s09",
   "text": "2. الدكتور سليم بن أمين الملا"
  },
  {
   "segment_id": "s10",
   "text": "3. الدكتور علي غانم الكويتي"
  },
  {
   "segment_id": "s11",
   "text": "Attendee 3: Ali Al Kuwaiti"
  },
  {
   "segment_id": "s12",
   "text": "4. الدكتور علوي بن عادل الراجح"
  },
  {
   "segment_id": "s13",
   "text": "وتولى أمانة السر الشيخ أمين مراد جاسم الملا."
  },
  {
   "segment_id": "s14",
   "text": "Secretary: Ameen Morad Jasim Al Mulla"
  },
  {
   "segment_id": "s15",
   "text": "Surname: MULLA / Given names: AMEEN MORAD JASIM"
  },
  {
   "segment_id": "s16",
   "text": "وبعد التداول قرر المجتمعون بالإجماع ما يلي:"
  },
  {
   "segment_id": "s17",
   "text": "أولًا: الموافقة على تعيين السيد علي الكويتي مديرًا للشركة لمدة ثلاث سنوات."
  },
  {
   "segment_id": "s18",
   "text": "ثانيًا: توزيع الأرباح بشكل عادل بين الشركاء حسب حصصهم."
  },
  {
   "segment_id": "s19",
   "text": "ثالثًا: المركز المالي للشركة سليم ولا توجد عليها التزامات متأخرة."
  },
  {
   "segment_id": "s20",
   "text": "رابعًا: تفويض السيد علوي الراجح بالتوقيع على محضر الاجتماع وتقديمه للجهات المختصة."
  },
  {
   "segment_id": "s21",
   "text": "رئيس الاجتماع: سعد السعدي"
  },
  {
   "segment_id": "s22",
   "text": "أمين السر: أمين الملا"
  },
  {
   "segment_id": "s23",
   "text": "التوقيعات:"
  },
  {
   "segment_id": "s24",
   "text": "Saad Khaled Al Saadi"
  }
 ],
