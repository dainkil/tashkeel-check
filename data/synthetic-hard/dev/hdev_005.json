 "segments": [
  {
   "segment_id": "s01",
   "text": "وكالة خاصة"
  },
  {
   "segment_id": "s02",
   "text": "إنه في يوم 13/07/2026 حضر أمام الكاتب العدل السيد مشهور بن خالد بن سالم المحيسني، كويتي الجنسية، ويحمل جواز سفر رقم J7822147."
  },
  {
   "segment_id": "s03",
   "text": "Principal: Mashhur bin Khalid bin Salem Al Mohaisany, Passport No. J7822147"
  },
  {
   "segment_id": "s04",
   "text": "وذلك بصفته مديرًا لشركة الرستماني للتجارة العامة ذ.م.م، المرخصة من دائرة التنمية الاقتصادية برقم 350569، وعنوانها الشارقة، الإمارات العربية المتحدة."
  },
  {
   "segment_id": "s05",
   "text": "Company: Al Rustamani General Trading L.L.C., Registration No. 350569"
  },
  {
   "segment_id": "s06",
   "text": "وقرر أنه وكّل السيد مشهور بن علي بن شافي اليامي، سعودي الجنسية، ويحمل بطاقة هوية رقم 67430215."
  },
  {
   "segment_id": "s07",
   "text": "Attorney: Mashour bin Ali bin Shafi Al Yami, ID No. 67430215"
  },
  {
   "segment_id": "s08",
   "text": "للقيام نيابة عنه بمراجعة الجهات الحكومية والتوقيع على الطلبات والمستندات المتعلقة بالشركة واستلام الشهادات والتراخيص."
  },
  {
   "segment_id": "s09",
   "text": "وهذا التوكيل صالح لمدة سنة واحدة من تاريخه."
  },
  {
   "segment_id": "s10",
   "text": "والموكل كامل الأهلية المعتبرة قانونًا."
  },
  {
   "segment_id": "s11",
   "text": "الموكل: مشهور المحيسني"
  },
  {
   "segment_id": "s12",
   "text": "الوكيل: مشهور اليامي"
  },
  {
   "segment_id": "s13",
   "text": "التوقيع: ____________"
  }
 ],
