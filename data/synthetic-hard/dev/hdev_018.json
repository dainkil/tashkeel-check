 "segments": [
  {
   "segment_id": "s01",
   "text": "Al Marri General Trading L.L.C."
  },
  {
   "segment_id": "s02",
   "text": "Tel: +971 4 5393377 | www.almarri-group.example.net"
  },
  {
   "segment_id": "s03",
   "text": "إفادة لمن يهمه الأمر"
  },
  {
   "segment_id": "s04",
   "text": "تشهد شركة المري للتجارة العامة ذ.م.م، المرخصة من دائرة التنمية الاقتصادية برقم 369861، وعنوانها أبوظبي، الإمارات العربية المتحدة،"
  },
  {
   "segment_id": "s05",
   "text": "بأن السيدة نوف محمد حمدان المري، إماراتية الجنسية، وتحمل جواز سفر رقم E4644612، تعمل لديها بوظيفة مهندسة منذ 18/05/2026."
  },
  {
   "segment_id": "s06",
   "text": "وقد أعطيت هذه الإفادة بناءً على طلبها دون أدنى مسؤولية على الشركة."
  },
  {
   "segment_id": "s07",
   "text": "المديرة العامة: السيدة فرح علي أحمد المصري"
  },
  {
   "segment_id": "s08",
   "text": "General Manager: Farah Ali Ahmed Al Masri"
  },
  {
   "segment_id": "s09",
   "text": "للاستفسار يرجى التواصل مع السيدة فرح المصري على البريد الإلكتروني أدناه."
  },
  {
   "segment_id": "s10",
   "text": "Email: f.almasri@almarri.example.com"
  },
  {
   "segment_id": "s11",
   "text": "التاريخ: 08/09/2026"
  }
 ],
