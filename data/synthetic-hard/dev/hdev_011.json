 "segments": [
  {
   "segment_id": "s01",
   "text": "مستخرج من السجل التجاري"
  },
  {
   "segment_id": "s02",
   "text": "الاسم التجاري: الجاسم للتجارة العامة ذ.م.م"
  },
  {
   "segment_id": "s03",
   "text": "Trade name: Al Jasem General Trading L.L.C."
  },
  {
   "segment_id": "s04",
   "text": "البريد الإلكتروني: info@aljasem-group.example.com"
  },
  {
   "segment_id": "s05",
   "text": "رقم الرخصة: 387751، جهة الإصدار: دائرة التنمية الاقتصادية، الإمارة: الشارقة"
  },
  {
   "segment_id": "s06",
   "text": "الشكل القانوني: شركة ذات مسؤولية محدودة"
  },
  {
   "segment_id": "s07",
   "text": "الشركاء:"
  },
  {
   "segment_id": "s08",
   "text": "1. الشيخ حبيب بن سلمان بن خليل الجاسم، بحريني الجنسية، الحصة 6٪"
  },
  {
   "segment_id": "s09",
   "text": "P<BHRAL<JASSEM<<HABIB<SALMAN<KHALIL<<<<<<<<<"
  },
  {
   "segment_id": "s10",
   "text": "Passport name: HABIB BIN SALMAN BIN KHALIL AL JASIM"
  },
  {
   "segment_id": "s11",
   "text": "2. السيد مبارك حبيب الجاسم، بحريني الجنسية، الحصة 39٪"
  },
  {
   "segment_id": "s12",
   "text": "3. السيدة ليلى بنت خلفان الموسوي، عمانية الجنسية، الحصة 11٪"
  },
  {
   "segment_id": "s13",
   "text": "4. المهندس عبد الرحمن طاهر الدخيل، كويتي الجنسية، الحصة 14٪"
  },
  {
   "segment_id": "s14",
   "text": "5. الدكتور حسين خالد الصباح، بحريني الجنسية، الحصة 19٪"
  },
  {
   "segment_id": "s15",
   "text": "Partner 5: Hussein Khalid Al Sabah"
  },
  {
   "segment_id": "s16",
   "text": "6. الشيخ طاهر يوسف عبدي الدخيل، كويتي الجنسية، الحصة 5٪"
  },
  {
   "segment_id": "s17",
   "text": "Partner 6: Tahir Yousef Abdi Al Dakhil"
  },
  {
   "segment_id": "s18",
   "text": "7. الشيخ حسين بن فهد الكعبي، إماراتي الجنسية، الحصة 39٪"
  },
  {
   "segment_id": "s19",
   "text": "P<AREAL<KAEBI<<HUSAIN<FAHAD<<<<<<<<<<<<<<<<<"
  },
  {
   "segment_id": "s20",
   "text": "Passport name: AL KAABI, Husain Fahad"
  },
  {
   "segment_id": "s21",
   "text": "المدير: السيد عبد الرحمن الدخيل"
  },
  {
   "segment_id": "s22",
   "text": "المفوض بالتوقيع: السيد طاهر الدخيل"
  },
  {
