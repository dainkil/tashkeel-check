 "segments": [
  {
   "segment_id": "s01",
   "text": "مستخرج من السجل التجاري"
  },
  {
   "segment_id": "s02",
   "text": "الاسم التجاري: الكعبي للتجارة العامة ذ.م.م"
  },
  {
   "segment_id": "s03",
   "text": "Trade name: Al Kaabi General Trading L.L.C."
  },
  {
   "segment_id": "s04",
   "text": "البريد الإلكتروني: info@alkaabi-group.example.com"
  },
  {
   "segment_id": "s05",
   "text": "رقم الرخصة: 387751، جهة الإصدار: دائرة التنمية الاقتصادية، الإمارة: الشارقة"
  },
  {
   "segment_id": "s06",
   "text": "الشكل القانوني: شركة ذات مسؤولية محدودة"
  },
  {
   "segment_id": "s07",
   "text": "الشركاء:"
  },
  {
   "segment_id": "s08",
   "text": "1. السيد راشد عبد الرحمن الكعبي، سعودي الجنسية، الحصة 11٪"
  },
  {
   "segment_id": "s09",
   "text": "2. المهندس محمد خليفة القحطاني، كويتي الجنسية، الحصة 21٪"
  },
  {
   "segment_id": "s10",
   "text": "Partner 2: Mohammed Khalifa Al Qahtani"
  },
  {
   "segment_id": "s11",
   "text": "3. السيدة دانا بنت علي بن سعود الشعلان، إماراتية الجنسية، الحصة 29٪"
  },
  {
   "segment_id": "s12",
   "text": "4. الشيخ عبد الرحمن بن أحمد بن عبد الله الكعبي، سعودي الجنسية، الحصة 33٪"
  },
  {
   "segment_id": "s13",
   "text": "P<SAUEL<KAABI<<ABDULRAHMAN<AHMED<ABDULLAH<<<"
  },
  {
   "segment_id": "s14",
   "text": "Surname: AL KAABI / Given names: ABDALRAHMAN AHMED ABDULLAH"
  },
  {
   "segment_id": "s15",
   "text": "5. الشيخ ماجد سرور خالد الشملان، قطري الجنسية، الحصة 21٪"
  },
  {
   "segment_id": "s16",
   "text": "P<QATEL<SHAMLAN<<MAJED<SUROOR<KHALED<<<<<<<<"
  },
  {
   "segment_id": "s17",
   "text": "Passport name: MAJID SUROOR KHALED EL-SHAMLAN"
  },
  {
   "segment_id": "s18",
   "text": "6. السيد يوسف عبدو الدخيل، إماراتي الجنسية، الحصة 38٪"
  },
  {
   "segment_id": "s19",
   "text": "Partner 6: Youssef Al Dakheel"
  },
  {
   "segment_id": "s20",
   "text": "7. السيد ماجد بن محمد القحطاني، كويتي الجنسية، الحصة 27٪"
  },
  {
   "segment_id": "s21",
   "text": "المدير: الشريك رقم 5، السيد ماجد الشملان"
  },
  {
   "segment_id": "s22",
   "text": "المفوض بالتوقيع: الشريك رقم 6، السيد يوسف الدخيل"
  },
  {
   "segment_id": "s23",
