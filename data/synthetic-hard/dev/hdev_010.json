   "segment_id": "s01",
   "text": "Al Zaabi General Trading L.L.C."
  },
  {
   "segment_id": "s02",
   "text": "Tel: +971 4 5544565 | www.alzaabi-group.example.com"
  },
  {
   "segment_id": "s03",
   "text": "إفادة لمن يهمه الأمر"
  },
  {
   "segment_id": "s04",
   "text": "تشهد شركة الزعابي للتجارة العامة ذ.م.م، المرخصة من دائرة التنمية الاقتصادية برقم 581145، وعنوانها أبوظبي، الإمارات العربية المتحدة،"
  },
  {
   "segment_id": "s05",
   "text": "بأن السيد إسماعيل محمد العمري، بحريني الجنسية، ويحمل جواز سفر رقم L4876811، يعمل لديها بوظيفة مهندس منذ 06/04/2026."
  },
  {
   "segment_id": "s06",
   "text": "Employee: Ismail Muhammad Al Amri, Passport No. L4876811"
  },
  {
   "segment_id": "s07",
   "text": "ونشهد بأنه حسن السيرة والسلوك طوال مدة عمله لدينا."
  },
  {
   "segment_id": "s08",
   "text": "وقد أعطيت هذه الإفادة بناءً على طلبه دون أدنى مسؤولية على الشركة."
  },
  {
   "segment_id": "s09",
   "text": "المدير العام: السيد محمد سعود العمري"
  },
  {
   "segment_id": "s10",
   "text": "General Manager: Muhammad Saud Al Amri"
  },
  {
   "segment_id": "s11",
   "text": "للاستفسار يرجى التواصل مع السيد محمد العمري على البريد الإلكتروني أدناه."
  },
  {
   "segment_id": "s12",
   "text": "Email: m.alamri@alzaabi.example.com"
  },
  {
   "segment_id": "s13",
   "text": "التاريخ: 02/07/2026"
  }
