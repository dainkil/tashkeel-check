 "segments": [
  {
   "segment_id": "s01",
   "text": "وكالة خاصة"
  },
  {
   "segment_id": "s02",
   "text": "إنه في يوم 03/07/2026 حضر أمام الكاتب العدل السيد سمير بن سعد بن رجب العلي، بحريني الجنسية، ويحمل جواز سفر رقم M4387697."
  },
  {
   "segment_id": "s03",
   "text": "Principal: Samir bin Saad bin Rajab Al Ali, Passport No. M4387697"
  },
  {
   "segment_id": "s04",
   "text": "وذلك بصفته مديرًا لشركة العلي للتجارة العامة ذ.م.م، المرخصة من دائرة التنمية الاقتصادية برقم 411333، وعنوانها دبي، الإمارات العربية المتحدة."
  },
  {
   "segment_id": "s05",
   "text": "Company: Al Ali General Trading L.L.C., Registration No. 411333"
  },
  {
   "segment_id": "s06",
   "text": "وقرر أنه وكّل السيد معتز سمير العلي، بحريني الجنسية، ويحمل بطاقة هوية رقم 44277718."
  },
  {
   "segment_id": "s07",
   "text": "للقيام نيابة عنه بمراجعة الجهات الحكومية والتوقيع على الطلبات والمستندات المتعلقة بالشركة واستلام الشهادات والتراخيص."
  },
  {
   "segment_id": "s08",
   "text": "وهذا التوكيل صالح لمدة سنة واحدة من تاريخه."
  },
  {
   "segment_id": "s09",
   "text": "والموكل كامل الأهلية المعتبرة قانونًا."
  },
  {
   "segment_id": "s10",
   "text": "الموكل: سمير العلي"
  },
  {
   "segment_id": "s11",
   "text": "الوكيل: معتز العلي"
  },
  {
   "segment_id": "s12",
   "text": "التوقيع: ____________"
  }
 ],
